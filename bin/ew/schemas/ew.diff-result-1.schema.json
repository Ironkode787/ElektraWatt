{
  "$defs": {
    "DiffChange": {
      "additionalProperties": false,
      "description": "One record of [`DiffResult`].",
      "properties": {
        "change": {
          "description": "`added`, `removed` or `changed`.",
          "type": "string"
        },
        "fields": {
          "description": "The changed members of a changed record, in path order.",
          "items": {
            "$ref": "#/$defs/DiffField"
          },
          "type": "array"
        },
        "id": {
          "description": "The record's ID.",
          "type": "string"
        },
        "kind": {
          "description": "The record kind.",
          "type": "string"
        },
        "label": {
          "description": "The record's label on its own side (a device's tag, a page's folio); empty without one.",
          "type": "string"
        }
      },
      "required": [
        "change",
        "kind",
        "id",
        "label",
        "fields"
      ],
      "type": "object"
    },
    "DiffField": {
      "additionalProperties": false,
      "description": "One changed member of [`DiffChange`].",
      "properties": {
        "after": {
          "description": "Its value on the second side, likewise."
        },
        "before": {
          "description": "Its value on the first side, the IDs of named records as their labels; absent when the side lacks it."
        },
        "path": {
          "description": "The member's dotted path.",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`ew diff --json` ([`DIFF`]; WP-S1.17 D26): the records that differ between the two sides.",
  "properties": {
    "$schema": {
      "const": "ew.diff-result/1",
      "description": "The name of this schema."
    },
    "changes": {
      "description": "The records that differ, in kind and ID order.",
      "items": {
        "$ref": "#/$defs/DiffChange"
      },
      "type": "array"
    },
    "equal": {
      "description": "Whether the sides hold the same records.",
      "type": "boolean"
    }
  },
  "required": [
    "$schema",
    "equal",
    "changes"
  ],
  "title": "ew.diff-result/1",
  "type": "object"
}
