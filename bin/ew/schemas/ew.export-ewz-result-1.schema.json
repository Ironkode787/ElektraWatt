{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`ew export ewz --json` ([`EXPORT_EWZ`]; WP-S1.17 D8).",
  "properties": {
    "$schema": {
      "const": "ew.export-ewz-result/1",
      "description": "The name of this schema."
    },
    "bytes": {
      "description": "The size of the file in bytes.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "files": {
      "description": "The files packed: `manifest.json`, the files it lists and the git files present.",
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    },
    "generation": {
      "description": "The generation packed.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "out": {
      "description": "The `.ewz` file written.",
      "type": "string"
    }
  },
  "required": [
    "$schema",
    "out",
    "generation",
    "files",
    "bytes"
  ],
  "title": "ew.export-ewz-result/1",
  "type": "object"
}
