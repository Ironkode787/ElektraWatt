* text=auto eol=lf
*.png binary
# Real exporter corpora: kept byte for byte as their exporters wrote them (CRLF included; FT-418, FT-436).
crates/*/tests/fixtures/*-exporters/** -text

# Generated files: every output that a regeneration step (or the merge-point records step) of `cargo xtask settle`
# rewrites entirely from its sources
# (the step table in xtask/src/settle.rs; a test of xtask keeps this list equal to it, in its order). With the driver
# configured (`git config merge.regen.driver true`, which keeps one side) a merge or cherry-pick never stops on them,
# and `cargo xtask settle` then regenerates them. Without the driver git merges them as text.
crates/ew-commands/schemas/** merge=regen
bin/ew/schemas/** merge=regen
crates/ew-checks/catalogue/rules.json merge=regen
crates/ew-viewmodel/keymaps/ew.toml merge=regen
crates/ew-viewmodel/keymaps/kicad.toml merge=regen
crates/ew-viewmodel/keymaps/sheet.json merge=regen
tools/blind/reference/** merge=regen
bin/ew/api/cli.json merge=regen
crates/ew-sqlview/api/api_v1.json merge=regen
crates/ew-api/api/queries.json merge=regen
docs/book/src/reference/commands/** merge=regen
docs/book/src/reference/rules/** merge=regen
