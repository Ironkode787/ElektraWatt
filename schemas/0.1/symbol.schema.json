{
  "$defs": {
    "Align": {
      "description": "Text alignment at the anchor point: nine positions.",
      "oneOf": [
        {
          "const": "top_left",
          "description": "Top left.",
          "type": "string"
        },
        {
          "const": "top_centre",
          "description": "Top centre.",
          "type": "string"
        },
        {
          "const": "top_right",
          "description": "Top right.",
          "type": "string"
        },
        {
          "const": "middle_left",
          "description": "Middle left.",
          "type": "string"
        },
        {
          "const": "centre",
          "description": "Centre.",
          "type": "string"
        },
        {
          "const": "middle_right",
          "description": "Middle right.",
          "type": "string"
        },
        {
          "const": "bottom_left",
          "description": "Bottom left.",
          "type": "string"
        },
        {
          "const": "bottom_centre",
          "description": "Bottom centre.",
          "type": "string"
        },
        {
          "const": "bottom_right",
          "description": "Bottom right.",
          "type": "string"
        }
      ]
    },
    "AnchorPolicy": {
      "description": "Where a symbol's cross-reference anchor lies (FR-SYM-010).",
      "oneOf": [
        {
          "const": "origin",
          "description": "The symbol origin (the default).",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "The position of a text slot.",
          "properties": {
            "slot": {
              "$ref": "#/$defs/SlotKind"
            }
          },
          "required": [
            "slot"
          ],
          "type": "object"
        },
        {
          "const": "graphic_centre",
          "description": "The centre of the graphics.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "A named point.",
          "properties": {
            "named": {
              "$ref": "#/$defs/Pt2"
            }
          },
          "required": [
            "named"
          ],
          "type": "object"
        }
      ]
    },
    "Angle2": {
      "description": "An angle in 10^-3 degree, counter-clockwise on the sheet, within the i32 range (doc 05 §3.2).",
      "maximum": 2147483647,
      "minimum": -2147483648,
      "type": "integer"
    },
    "ArcPrim": {
      "additionalProperties": true,
      "description": "An elliptic arc (QET's arc: bounding rectangle, start angle and sweep, counter-clockwise).",
      "properties": {
        "rect": {
          "$ref": "#/$defs/Rect",
          "description": "The bounding rectangle of the full ellipse."
        },
        "start": {
          "$ref": "#/$defs/Angle2",
          "description": "Start angle."
        },
        "stroke": {
          "anyOf": [
            {
              "$ref": "#/$defs/Stroke"
            },
            {
              "type": "null"
            }
          ],
          "description": "Stroke."
        },
        "sweep": {
          "$ref": "#/$defs/Angle2",
          "description": "Sweep angle."
        }
      },
      "required": [
        "rect",
        "sweep"
      ],
      "type": "object"
    },
    "Arrangement": {
      "additionalProperties": true,
      "description": "A named set of visible text slots, by index into `text_slots` (\"full\", \"tag + rating\").",
      "properties": {
        "name": {
          "$ref": "#/$defs/Ident",
          "description": "The name."
        },
        "slots": {
          "description": "Indices of the visible slots.",
          "items": {
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "CirclePrim": {
      "additionalProperties": true,
      "description": "A circle.",
      "properties": {
        "centre": {
          "$ref": "#/$defs/Pt2",
          "description": "Centre."
        },
        "fill": {
          "anyOf": [
            {
              "$ref": "#/$defs/Colour"
            },
            {
              "type": "null"
            }
          ],
          "description": "Fill."
        },
        "r": {
          "$ref": "#/$defs/Nm",
          "description": "Radius."
        },
        "stroke": {
          "anyOf": [
            {
              "$ref": "#/$defs/Stroke"
            },
            {
              "type": "null"
            }
          ],
          "description": "Stroke."
        }
      },
      "required": [
        "centre",
        "r"
      ],
      "type": "object"
    },
    "Colour": {
      "description": "A drawing colour: the layer's colour (the default) or an explicit sRGB value.",
      "oneOf": [
        {
          "const": "by_layer",
          "description": "The layer's colour (the default).",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "An explicit colour.",
          "properties": {
            "rgb": {
              "$ref": "#/$defs/Rgb"
            }
          },
          "required": [
            "rgb"
          ],
          "type": "object"
        }
      ]
    },
    "Confidence": {
      "description": "Confidence of one section of library data.",
      "oneOf": [
        {
          "const": "verified",
          "description": "Checked against a source.",
          "type": "string"
        },
        {
          "const": "unverified",
          "description": "Not yet checked.",
          "type": "string"
        },
        {
          "const": "test",
          "description": "Test data.",
          "type": "string"
        }
      ]
    },
    "Dash": {
      "description": "A dash pattern scaled by the pen width (doc 07 §2.3).",
      "oneOf": [
        {
          "const": "solid",
          "description": "Solid (the default).",
          "type": "string"
        },
        {
          "const": "dash42",
          "description": "Dash 4, gap 2 (× pen width).",
          "type": "string"
        },
        {
          "const": "dot12",
          "description": "Dot 1, gap 2.",
          "type": "string"
        },
        {
          "const": "dash_dot",
          "description": "Dash-dot.",
          "type": "string"
        }
      ]
    },
    "Date": {
      "description": "An authored date YYYY-MM-DD (doc 05 §3.2).",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "type": "string"
    },
    "Deprecation": {
      "additionalProperties": true,
      "description": "The payload of [`ItemStatus::Deprecated`].",
      "properties": {
        "successor": {
          "anyOf": [
            {
              "$ref": "#/$defs/LibRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "The successor."
        }
      },
      "type": "object"
    },
    "Dir4": {
      "description": "One of four directions on the sheet.",
      "oneOf": [
        {
          "const": "up",
          "description": "Up (−y).",
          "type": "string"
        },
        {
          "const": "right",
          "description": "Right (+x).",
          "type": "string"
        },
        {
          "const": "down",
          "description": "Down (+y).",
          "type": "string"
        },
        {
          "const": "left",
          "description": "Left (−x).",
          "type": "string"
        }
      ]
    },
    "Discipline": {
      "description": "Discipline of a connection point.",
      "oneOf": [
        {
          "const": "electrical",
          "description": "Electrical (the default).",
          "type": "string"
        },
        {
          "const": "pneumatic",
          "description": "Pneumatic.",
          "type": "string"
        },
        {
          "const": "vacuum",
          "description": "Vacuum.",
          "type": "string"
        },
        {
          "const": "hydraulic",
          "description": "Hydraulic.",
          "type": "string"
        },
        {
          "const": "bus",
          "description": "Bus.",
          "type": "string"
        }
      ]
    },
    "EllipsePrim": {
      "additionalProperties": true,
      "description": "An ellipse.",
      "properties": {
        "fill": {
          "anyOf": [
            {
              "$ref": "#/$defs/Colour"
            },
            {
              "type": "null"
            }
          ],
          "description": "Fill."
        },
        "rect": {
          "$ref": "#/$defs/Rect",
          "description": "The bounding rectangle."
        },
        "stroke": {
          "anyOf": [
            {
              "$ref": "#/$defs/Stroke"
            },
            {
              "type": "null"
            }
          ],
          "description": "Stroke."
        }
      },
      "required": [
        "rect"
      ],
      "type": "object"
    },
    "ExtraVariant": {
      "additionalProperties": true,
      "description": "A stored symbol variant with its own graphics and CPs.",
      "properties": {
        "cps": {
          "description": "Its CPs.",
          "items": {
            "$ref": "#/$defs/SymbolCp"
          },
          "type": "array"
        },
        "graphics": {
          "description": "Its graphics.",
          "items": {
            "$ref": "#/$defs/Primitive"
          },
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/ExtraVariantKind",
          "description": "The variant kind."
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "ExtraVariantKind": {
      "description": "Kind of a stored symbol variant.",
      "oneOf": [
        {
          "const": "contact_image",
          "description": "Contact image.",
          "type": "string"
        },
        {
          "const": "cp_variant",
          "description": "CP variant.",
          "type": "string"
        }
      ]
    },
    "Grid": {
      "additionalProperties": false,
      "description": "A rational grid step num/den in nanometres (doc 05 §3.2). JSON Schema cannot express that num/den is reduced or at least 1 nm (num >= den): the reader rejects unreduced and sub-nanometre steps.",
      "properties": {
        "den": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        "num": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "num",
        "den"
      ],
      "type": "object"
    },
    "Ident": {
      "description": "An identifier: non-empty, one line (no control character U+0000 to U+001F or U+007F to U+009F), without leading or trailing white space (the Unicode White_Space set); interior spaces are allowed (doc 05 §3.2). JSON Schema cannot express Unicode Normalization Form C; the reader rejects non-NFC text.",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000](?:[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000])?$",
      "type": "string"
    },
    "ImagePrim": {
      "additionalProperties": true,
      "description": "An image asset placed in a rectangle.",
      "properties": {
        "asset": {
          "$ref": "#/$defs/Sha256",
          "description": "The asset `assets/<sha256>.<ext>`."
        },
        "rect": {
          "$ref": "#/$defs/Rect",
          "description": "The placement."
        }
      },
      "required": [
        "rect",
        "asset"
      ],
      "type": "object"
    },
    "ItemMeta": {
      "additionalProperties": true,
      "description": "Provenance of a library item (doc 07 §2.1, §2.5). The item's semantic version is the copy metadata\n`version` of the [`LibCopy`] and is stored once, there.",
      "properties": {
        "as_of": {
          "anyOf": [
            {
              "$ref": "#/$defs/Date"
            },
            {
              "type": "null"
            }
          ],
          "description": "Date of the data."
        },
        "confidence": {
          "additionalProperties": {
            "$ref": "#/$defs/Confidence"
          },
          "description": "Confidence per section, keyed by section name.",
          "type": "object"
        },
        "foreign_terms": {
          "description": "Imported content under foreign terms.",
          "type": "boolean"
        },
        "key": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ident"
            },
            {
              "type": "null"
            }
          ],
          "description": "Human key (`pxc.2904602`, `ew.iec.mcb-1pn`)."
        },
        "licence": {
          "description": "SPDX licence expression of the item.",
          "type": [
            "string",
            "null"
          ]
        },
        "sources": {
          "description": "Where the data came from: datasheet references, file hashes, manual entry.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/ItemStatus",
          "description": "Item status; default released."
        }
      },
      "type": "object"
    },
    "ItemStatus": {
      "description": "Status of a library item.",
      "oneOf": [
        {
          "const": "draft",
          "description": "Draft.",
          "type": "string"
        },
        {
          "const": "released",
          "description": "Released (the default).",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "Deprecated, with an optional successor: `{\"deprecated\": {\"successor\": …}}`.",
          "properties": {
            "deprecated": {
              "$ref": "#/$defs/Deprecation"
            }
          },
          "required": [
            "deprecated"
          ],
          "type": "object"
        },
        {
          "const": "withdrawn",
          "description": "Withdrawn.",
          "type": "string"
        }
      ]
    },
    "LibRef": {
      "additionalProperties": true,
      "description": "A reference between library items (doc 07 §2.1): library, item and a semantic-version requirement.",
      "properties": {
        "item": {
          "$ref": "#/$defs/Uuid",
          "description": "The item's UUID, stable across versions."
        },
        "library": {
          "$ref": "#/$defs/Uuid",
          "description": "The library's UUID."
        },
        "version_req": {
          "description": "A semantic-version requirement such as `\"^1\"`.",
          "type": "string"
        }
      },
      "required": [
        "library",
        "item",
        "version_req"
      ],
      "type": "object"
    },
    "LinePrim": {
      "additionalProperties": true,
      "description": "A straight line.",
      "properties": {
        "from": {
          "$ref": "#/$defs/Pt2",
          "description": "Start."
        },
        "stroke": {
          "anyOf": [
            {
              "$ref": "#/$defs/Stroke"
            },
            {
              "type": "null"
            }
          ],
          "description": "Stroke; absent means not stroked."
        },
        "to": {
          "$ref": "#/$defs/Pt2",
          "description": "End."
        }
      },
      "required": [
        "from",
        "to"
      ],
      "type": "object"
    },
    "MlText": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "additionalProperties": {
            "minLength": 1,
            "type": "string"
          },
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^(?:[a-z]{2,3}(?:-[a-z]{3}){0,3}|[a-z]{4,8})(?:-[A-Z][a-z]{3})?(?:-(?:[A-Z]{2}|[0-9]{3}))?(?:-(?:[a-z0-9]{5,8}|[0-9][a-z0-9]{3}))*(?:-[a-wy-z0-9](?:-[a-z0-9]{2,8})+)*(?:-x(?:-[a-z0-9]{1,8})+)?$",
            "type": "string"
          },
          "type": "object"
        }
      ],
      "description": "Multilingual text: a neutral string, or an object keyed by canonical BCP 47 tags with non-empty string values (doc 05 §3.2). JSON Schema cannot express that all text is NFC or that the keys are in ascending byte order; the reader rejects both."
    },
    "NamedPoint": {
      "additionalProperties": true,
      "description": "A named point of a symbol.",
      "properties": {
        "name": {
          "$ref": "#/$defs/Ident",
          "description": "The name."
        },
        "pos": {
          "$ref": "#/$defs/Pt2",
          "description": "The point."
        }
      },
      "required": [
        "name",
        "pos"
      ],
      "type": "object"
    },
    "Nm": {
      "description": "A length in nanometres (doc 05 §3.2). Written without fraction or exponent; JSON Schema cannot tell 5 from 5.0, the reader rejects the latter.",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
    },
    "Pen": {
      "description": "A house pen or an explicit width (doc 07 §2.3, FR-SYM-003): `\"p026\"` or `{\"width\": nm}`.",
      "oneOf": [
        {
          "const": "p013",
          "description": "0.13 mm.",
          "type": "string"
        },
        {
          "const": "p018",
          "description": "0.18 mm.",
          "type": "string"
        },
        {
          "const": "p026",
          "description": "0.26 mm.",
          "type": "string"
        },
        {
          "const": "p042",
          "description": "0.42 mm.",
          "type": "string"
        },
        {
          "const": "p052",
          "description": "0.52 mm.",
          "type": "string"
        },
        {
          "const": "p130",
          "description": "1.30 mm.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "An explicit width.",
          "properties": {
            "width": {
              "$ref": "#/$defs/Nm"
            }
          },
          "required": [
            "width"
          ],
          "type": "object"
        }
      ]
    },
    "PolygonPrim": {
      "additionalProperties": true,
      "description": "A polygon.",
      "properties": {
        "closed": {
          "description": "Whether the last point joins the first.",
          "type": "boolean"
        },
        "fill": {
          "anyOf": [
            {
              "$ref": "#/$defs/Colour"
            },
            {
              "type": "null"
            }
          ],
          "description": "Fill."
        },
        "points": {
          "description": "Points in order.",
          "items": {
            "$ref": "#/$defs/Pt2"
          },
          "type": "array"
        },
        "stroke": {
          "anyOf": [
            {
              "$ref": "#/$defs/Stroke"
            },
            {
              "type": "null"
            }
          ],
          "description": "Stroke."
        }
      },
      "required": [
        "points"
      ],
      "type": "object"
    },
    "PolylinePrim": {
      "additionalProperties": true,
      "description": "An open polyline.",
      "properties": {
        "points": {
          "description": "Points in order.",
          "items": {
            "$ref": "#/$defs/Pt2"
          },
          "type": "array"
        },
        "stroke": {
          "anyOf": [
            {
              "$ref": "#/$defs/Stroke"
            },
            {
              "type": "null"
            }
          ],
          "description": "Stroke."
        }
      },
      "required": [
        "points"
      ],
      "type": "object"
    },
    "Primitive": {
      "description": "A graphic primitive in nanometres, relative to its owner's origin (doc 07 §2.3).",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A straight line.",
          "properties": {
            "line": {
              "$ref": "#/$defs/LinePrim"
            }
          },
          "required": [
            "line"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "An open polyline.",
          "properties": {
            "polyline": {
              "$ref": "#/$defs/PolylinePrim"
            }
          },
          "required": [
            "polyline"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A rectangle with optional rounded corners and drop shadow.",
          "properties": {
            "rect": {
              "$ref": "#/$defs/RectPrim"
            }
          },
          "required": [
            "rect"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A circle.",
          "properties": {
            "circle": {
              "$ref": "#/$defs/CirclePrim"
            }
          },
          "required": [
            "circle"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "An ellipse in a bounding rectangle.",
          "properties": {
            "ellipse": {
              "$ref": "#/$defs/EllipsePrim"
            }
          },
          "required": [
            "ellipse"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "An elliptic arc in a bounding rectangle.",
          "properties": {
            "arc": {
              "$ref": "#/$defs/ArcPrim"
            }
          },
          "required": [
            "arc"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A polygon.",
          "properties": {
            "polygon": {
              "$ref": "#/$defs/PolygonPrim"
            }
          },
          "required": [
            "polygon"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A text.",
          "properties": {
            "text": {
              "$ref": "#/$defs/TextPrim"
            }
          },
          "required": [
            "text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "An image asset.",
          "properties": {
            "image": {
              "$ref": "#/$defs/ImagePrim"
            }
          },
          "required": [
            "image"
          ],
          "type": "object"
        }
      ]
    },
    "Pt2": {
      "description": "A point [x, y] in nanometres, y downwards (doc 05 §3.2).",
      "items": false,
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        }
      ],
      "type": "array"
    },
    "Rect": {
      "description": "A rectangle [[x0, y0], [x1, y1]] in nanometres, minimum corner first (doc 05 §3.2).",
      "items": false,
      "minItems": 2,
      "prefixItems": [
        {
          "$ref": "#/$defs/Pt2"
        },
        {
          "$ref": "#/$defs/Pt2"
        }
      ],
      "type": "array"
    },
    "RectPrim": {
      "additionalProperties": true,
      "description": "A rectangle.",
      "properties": {
        "fill": {
          "anyOf": [
            {
              "$ref": "#/$defs/Colour"
            },
            {
              "type": "null"
            }
          ],
          "description": "Fill; absent means not filled."
        },
        "rect": {
          "$ref": "#/$defs/Rect",
          "description": "The rectangle."
        },
        "rx": {
          "$ref": "#/$defs/Nm",
          "description": "Horizontal corner radius."
        },
        "ry": {
          "$ref": "#/$defs/Nm",
          "description": "Vertical corner radius."
        },
        "shadow": {
          "anyOf": [
            {
              "$ref": "#/$defs/Nm"
            },
            {
              "type": "null"
            }
          ],
