      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "An embedded library copy (doc 07 §2.1, doc 05 §13.2): `$k`, `id` (the copy ID\n`v5(NS_LIBCOPY, library ‖ item)`), `$v`, the copy metadata, then the item's own members.\n\n`sha256` is taken over the canonical compact JSON of the item's own members, without `id` and the copy\nmetadata, so the copy's hash equals the published item's (EW-CORE-014).\n\nDeserialisation reads the copy metadata itself and hands the remaining members to the item's own\ndeserialiser, so errors inside the item keep their paths (a flattened field would lose them).",
  "properties": {
    "$k": {
      "const": "symbol",
      "description": "The kind name; always the first member."
    },
    "$v": {
      "description": "Per-kind schema version `$v`, omitted when 1.",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "anchor": {
      "$ref": "#/$defs/AnchorPolicy",
      "description": "Anchor policy for cross-references (FR-SYM-010); default the origin."
    },
    "arrangements": {
      "description": "Named slot sets (FR-SYM-012).",
      "items": {
        "$ref": "#/$defs/Arrangement"
      },
      "type": "array"
    },
    "cps": {
      "description": "Connection points, keyed by `idx`.",
      "items": {
        "$ref": "#/$defs/SymbolCp"
      },
      "type": "array"
    },
    "extra_variants": {
      "description": "Stored contact-image and CP variants; orientation variants A–H are derived.",
      "items": {
        "$ref": "#/$defs/ExtraVariant"
      },
      "type": "array"
    },
    "fndef": {
      "$ref": "#/$defs/LibRef",
      "description": "Exactly one function definition (FR-SYM-005)."
    },
    "graphics": {
      "description": "Graphics relative to the origin.",
      "items": {
        "$ref": "#/$defs/Primitive"
      },
      "type": "array"
    },
    "grid": {
      "$ref": "#/$defs/Grid",
      "description": "Native connection grid."
    },
    "id": {
      "$ref": "#/$defs/Uuid",
      "description": "The copy ID."
    },
    "iec60617_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/Ident"
        },
        {
          "type": "null"
        }
      ],
      "description": "IEC 60617 identifier (\"S00nnn\"), metadata only."
    },
    "iso1219_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/Ident"
        },
        {
          "type": "null"
        }
      ],
      "description": "ISO 1219 identifier, metadata only."
    },
    "item_id": {
      "$ref": "#/$defs/Uuid",
      "description": "The item's UUID, stable across versions."
    },
    "keywords": {
      "description": "Search keywords (a set, sorted).",
      "items": {
        "$ref": "#/$defs/Ident"
      },
      "type": "array",
      "uniqueItems": true
    },
    "library_id": {
      "$ref": "#/$defs/Uuid",
      "description": "The library's UUID (the project ID for project-local items)."
    },
    "link_points": {
      "description": "Ends of derived mechanical linkages (FR-SYM-014).",
      "items": {
        "$ref": "#/$defs/NamedPoint"
      },
      "type": "array"
    },
    "meta": {
      "$ref": "#/$defs/ItemMeta",
      "description": "Provenance."
    },
    "name": {
      "$ref": "#/$defs/MlText",
      "description": "Name."
    },
    "rep_type": {
      "$ref": "#/$defs/RepType",
      "description": "Representation type; default multi-line."
    },
    "sha256": {
      "$ref": "#/$defs/Sha256",
      "description": "Hash of the item's own members."
    },
    "text_slots": {
      "description": "Typed text slots.",
      "items": {
        "$ref": "#/$defs/TextSlot"
      },
      "type": "array"
    },
    "version": {
      "description": "The item's semantic version (`MAJOR.MINOR.PATCH`).",
      "type": "string"
    }
  },
  "required": [
    "$k",
    "id",
    "library_id",
    "item_id",
    "version",
    "sha256",
    "fndef",
    "grid"
  ],
  "title": "symbol",
  "type": "object"
}
