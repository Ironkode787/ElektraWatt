  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "Everything with one tag; the single owner of parts (ADR-0006, doc 03 §7, rank 31). The printed tag is\nderived from `tag`, the numbering scheme and the main representation; it is stored nowhere.\n\nAspects follow the known members, flattened in the order of doc 05 §3.1: `strip`, `terminal`, `cable`,\n`assembly`, `plc_station`, `plc_module`, then `bus_node` and `valve_terminal`. Typed: `strip`, `terminal`,\n`cable`, `plc_station` and `plc_module`; `assembly` is held verbatim in its own slot so that it keeps its\nplace before `plc_station`; `bus_node` and `valve_terminal` arrive with their work packages and are kept\nin `extra` until then, which places them after the typed aspects.\n`user_props` has no field-level definition yet and is kept in `extra` too.\n\nDeserialisation takes the aspects out of the object first and reads each at its own path, because\nserde reads flattened fields from a buffer that loses the paths of errors inside them.",
  "properties": {
    "$k": {
      "const": "device",
      "description": "The kind name; always the first member."
    },
    "$v": {
      "description": "Per-kind schema version `$v`, omitted when 1.",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "assembly": {
      "description": "The assembly aspect (doc 03 §6, doc 11 §2.7), kept verbatim until it is typed; it is written in its\ndoc 05 §3.1 place, before `plc_station`."
    },
    "cable": {
      "anyOf": [
        {
          "$ref": "#/$defs/Cable"
        },
        {
          "type": "null"
        }
      ],
      "description": "Cable."
    },
    "function_text": {
      "$ref": "#/$defs/MlText",
      "description": "Manual function text (the automatic text falls back to the path function text, FR-DEV-011)."
    },
    "id": {
      "$ref": "#/$defs/Uuid",
      "description": "The record ID."
    },
    "kind": {
      "anyOf": [
        {
          "$ref": "#/$defs/DeviceKind"
        },
        {
          "type": "null"
        }
      ],
      "description": "UI and numbering hint."
    },
    "parent": {
      "anyOf": [
        {
          "$ref": "#/$defs/Uuid"
        },
        {
          "type": "null"
        }
      ],
      "description": "Parent device (assemblies, child tags)."
    },
    "parts": {
      "description": "Part uses; parts attach only to devices.",
      "items": {
        "$ref": "#/$defs/PartUse"
      },
      "type": "array"
    },
    "plc_module": {
      "anyOf": [
        {
          "$ref": "#/$defs/PlcModule"
        },
        {
          "type": "null"
        }
      ],
      "description": "PLC module (doc 10 §2.3)."
    },
    "plc_station": {
      "anyOf": [
        {
          "$ref": "#/$defs/PlcStation"
        },
        {
          "type": "null"
        }
      ],
      "description": "PLC station (doc 10 §2.3)."
    },
    "position": {
      "description": "Order inside the parent (manifold position).",
      "format": "uint32",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "process_tag": {
      "anyOf": [
        {
          "$ref": "#/$defs/Ident"
        },
        {
          "type": "null"
        }
      ],
      "description": "Process tag, never renumbered (FR-DEV-012)."
    },
    "source_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceRef"
        },
        {
          "type": "null"
        }
      ],
      "description": "Import provenance."
    },
    "state": {
      "$ref": "#/$defs/DeviceState",
      "description": "Lifecycle state; default used."
    },
    "strip": {
      "anyOf": [
        {
          "$ref": "#/$defs/Strip"
        },
        {
          "type": "null"
        }
      ],
      "description": "Terminal strip."
    },
    "structure": {
      "$ref": "#/$defs/StructureAssignment",
      "description": "Own structure assignment (FR-PRJ-019)."
    },
    "tag": {
      "$ref": "#/$defs/TagSpec",
      "description": "The only stored tag data (doc 03 §8.2)."
    },
    "tech_data": {
      "description": "Technical data, keyed by `key` (FR-DEV-009).",
      "items": {
        "$ref": "#/$defs/TechValue"
      },
      "type": "array"
    },
    "terminal": {
      "anyOf": [
        {
          "$ref": "#/$defs/Terminal"
        },
        {
          "type": "null"
        }
      ],
      "description": "Terminal."
    }
  },
  "required": [
    "$k",
    "id",
    "tag"
  ],
  "title": "device",
  "type": "object"
}
