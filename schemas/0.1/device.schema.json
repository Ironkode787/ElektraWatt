{
  "$defs": {
    "AccessoryKind": {
      "description": "Kind of a strip accessory.",
      "oneOf": [
        {
          "const": "end_plate",
          "description": "End plate.",
          "type": "string"
        },
        {
          "const": "end_clamp",
          "description": "End clamp (end bracket).",
          "type": "string"
        },
        {
          "const": "partition",
          "description": "Partition plate.",
          "type": "string"
        },
        {
          "const": "marker",
          "description": "Marker carrier.",
          "type": "string"
        },
        {
          "const": "cover",
          "description": "Cover.",
          "type": "string"
        }
      ]
    },
    "AddrSpec": {
      "description": "An address specification (doc 10 §2.5): derived, deliberate, excluded or open.",
      "oneOf": [
        {
          "const": "auto",
          "description": "Module start plus the address-map offset (the default).",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "A deliberate value; every deviation from the derived value is reported (EW-PLC-012).",
          "properties": {
            "manual": {
              "$ref": "#/$defs/PlcAddress"
            }
          },
          "required": [
            "manual"
          ],
          "type": "object"
        },
        {
          "const": "excluded",
          "description": "Not addressed (\"do not include in addressing\").",
          "type": "string"
        },
        {
          "const": "tbd",
          "description": "A typed open item; prints \"TBD\" and blocks release (EW-PLC-015).",
          "type": "string"
        }
      ]
    },
    "Cable": {
      "additionalProperties": true,
      "description": "The `Cable` aspect (doc 03 §12).",
      "properties": {
        "core_id_mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/CoreIdMode"
            },
            {
              "type": "null"
            }
          ],
          "description": "How cores are identified (FR-CBL-006)."
        },
        "length": {
          "$ref": "#/$defs/LengthSource",
          "description": "Where the length comes from; default missing (EW-CORE-033)."
        },
        "pre_assembled": {
          "description": "Pre-assembled cable (FR-CBL-013).",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "CoreIdMode": {
      "description": "How the cores of a cable are identified.",
      "oneOf": [
        {
          "const": "number",
          "description": "By number.",
          "type": "string"
        },
        {
          "const": "colour",
          "description": "By colour.",
          "type": "string"
        },
        {
          "const": "both",
          "description": "By number and colour.",
          "type": "string"
        }
      ]
    },
    "Dec3": {
      "description": "A canonical decimal string: at most three fraction digits, no trailing fraction zeros, no leading zeros, no plus sign, no \"-0\", no exponent, no white space, no unit (doc 05 §3.2). The pattern bounds the integer part to 16 digits; the exact i64 range of the thousandths (about 9.2 x 10^15) is checked by the reader.",
      "maxLength": 21,
      "pattern": "^(?:0|-?[1-9][0-9]{0,15}(?:\\.[0-9]{0,2}[1-9])?|-?0\\.[0-9]{0,2}[1-9])$",
      "type": "string"
    },
    "DeviceKind": {
      "description": "A device's UI and numbering hint. Doc 03 enumerates only these kinds so far; others are kept as\n[`DeviceKind::Unknown`] until the list is decided.",
      "oneOf": [
        {
          "const": "psu",
          "description": "Power supply.",
          "type": "string"
        },
        {
          "const": "terminal",
          "description": "Terminal.",
          "type": "string"
        },
        {
          "const": "blanking_plate",
          "description": "Blank manifold or valve-terminal position (doc 11 §2.7).",
          "type": "string"
        }
      ]
    },
    "DeviceState": {
      "description": "Device lifecycle state (FR-DEV-026).",
      "oneOf": [
        {
          "const": "used",
          "description": "In use (the default).",
          "type": "string"
        },
        {
          "const": "spare",
          "description": "Spare.",
          "type": "string"
        },
        {
          "const": "reserved",
          "description": "Reserved.",
          "type": "string"
        },
        {
          "const": "not_fitted",
          "description": "Not fitted.",
          "type": "string"
        }
      ]
    },
    "FrozenTag": {
      "additionalProperties": true,
      "description": "A frozen product designation (doc 03 §8.5): \"S51\" printed without the product sign.",
      "properties": {
        "sign": {
          "$ref": "#/$defs/TagSign",
          "description": "Whether pages print the \"-\" sign; full designations always carry it."
        },
        "text": {
          "$ref": "#/$defs/Ident",
          "description": "The product designation text."
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    },
    "Ident": {
      "description": "An identifier: non-empty, one line (no control character U+0000 to U+001F or U+007F to U+009F), without leading or trailing white space (the Unicode White_Space set); interior spaces are allowed (doc 05 §3.2). JSON Schema cannot express Unicode Normalization Form C; the reader rejects non-NFC text.",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000](?:[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000])?$",
      "type": "string"
    },
    "IoStarts": {
      "additionalProperties": true,
      "description": "One start per direction (doc 10 §2.3).",
      "properties": {
        "input": {
          "$ref": "#/$defs/AddrSpec",
          "description": "The input start."
        },
        "output": {
          "$ref": "#/$defs/AddrSpec",
          "description": "The output start."
        }
      },
      "type": "object"
    },
    "LabelMode": {
      "description": "What the terminals of a strip print.",
      "oneOf": [
        {
          "const": "designation",
          "description": "The terminal designation (the default).",
          "type": "string"
        },
        {
          "const": "function_text",
          "description": "The terminal's function text (\"1+\", FR-TRM-021).",
          "type": "string"
        }
      ]
    },
    "LengthSource": {
      "description": "The source of a cable length (FR-CBL-009). The committed sources `Estimated` and `Routed` (1.0) are\nadditive variants of a later format.",
      "oneOf": [
        {
          "const": "missing",
          "description": "No length yet (the default); blocks release.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "Entered by hand.",
          "properties": {
            "manual": {
              "$ref": "#/$defs/Nm"
            }
          },
          "required": [
            "manual"
          ],
          "type": "object"
        },
        {
          "const": "from_part",
          "description": "From the cable part (pre-assembled length).",
          "type": "string"
        }
      ]
    },
    "LevelRole": {
      "description": "The role of a terminal level.",
      "oneOf": [
        {
          "const": "main",
          "description": "Main level (the default).",
          "type": "string"
        },
        {
          "const": "aux",
          "description": "Auxiliary level.",
          "type": "string"
        }
      ]
    },
    "LevelSpec": {
      "additionalProperties": true,
      "description": "One level of a multi-level terminal.",
      "properties": {
        "level": {
          "description": "Level number.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "role": {
          "$ref": "#/$defs/LevelRole",
          "description": "Role; default main."
        }
      },
      "required": [
        "level"
      ],
      "type": "object"
    },
    "MlText": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "additionalProperties": {
            "minLength": 1,
            "type": "string"
          },
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^(?:[a-z]{2,3}(?:-[a-z]{3}){0,3}|[a-z]{4,8})(?:-[A-Z][a-z]{3})?(?:-(?:[A-Z]{2}|[0-9]{3}))?(?:-(?:[a-z0-9]{5,8}|[0-9][a-z0-9]{3}))*(?:-[a-wy-z0-9](?:-[a-z0-9]{2,8})+)*(?:-x(?:-[a-z0-9]{1,8})+)?$",
            "type": "string"
          },
          "type": "object"
        }
      ],
      "description": "Multilingual text: a neutral string, or an object keyed by canonical BCP 47 tags with non-empty string values (doc 05 §3.2). JSON Schema cannot express that all text is NFC or that the keys are in ascending byte order; the reader rejects both."
    },
    "Nm": {
      "description": "A length in nanometres (doc 05 §3.2). Written without fraction or exponent; JSON Schema cannot tell 5 from 5.0, the reader rejects the latter.",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
    },
    "PartRef": {
      "additionalProperties": true,
      "description": "A part on a device (doc 03 §7): the embedded copy and an optional part variant (FR-PRT-003).",
      "properties": {
        "copy": {
          "$ref": "#/$defs/Uuid",
          "description": "The copy ID of the embedded part, `v5(NS_LIBCOPY, library ‖ item)`."
        },
        "variant": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ident"
            },
            {
              "type": "null"
            }
          ],
          "description": "A variant key of the part."
        }
      },
      "required": [
        "copy"
      ],
      "type": "object"
    },
    "PartUse": {
      "additionalProperties": true,
      "description": "A part use on a device (ADR-0006): the part and its quantity in the part's order unit.",
      "properties": {
        "part": {
          "$ref": "#/$defs/PartRef",
          "description": "The part."
        },
        "qty": {
          "$ref": "#/$defs/Dec3",
          "description": "The quantity in the part's order unit (pieces, metres, sets)."
        }
      },
      "required": [
        "part",
        "qty"
      ],
      "type": "object"
    },
    "PlcAddress": {
      "additionalProperties": true,
      "description": "A canonical PLC address (doc 10 §2.5), rendered by the configuration project's profile.",
      "properties": {
        "area": {
          "$ref": "#/$defs/PlcArea",
          "description": "The area."
        },
        "bit": {
          "description": "The bit, for a bit address.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "byte": {
          "description": "The byte.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "size": {
          "$ref": "#/$defs/PlcSize",
          "description": "The access size; default a bit."
        }
      },
      "required": [
        "area",
        "byte"
      ],
      "type": "object"
    },
    "PlcArea": {
      "description": "The area of a PLC address.",
      "oneOf": [
        {
          "const": "i",
          "description": "Inputs.",
          "type": "string"
        },
        {
          "const": "q",
          "description": "Outputs.",
          "type": "string"
        },
        {
          "const": "m",
          "description": "Markers.",
          "type": "string"
        },
        {
          "const": "pi",
          "description": "Peripheral inputs.",
          "type": "string"
        },
        {
          "const": "pq",
          "description": "Peripheral outputs.",
          "type": "string"
        }
      ]
    },
    "PlcModule": {
      "additionalProperties": true,
      "description": "The `PlcModule` aspect (doc 10 §2.3): a card or sub-module of a station, on the station device or on a\ndescendant of it. Its I/O widths and maps come from the part's `plc` section.",
      "properties": {
        "integrated": {
          "description": "Created with the station; not deletable alone (FR-PLC-003).",
          "type": "boolean"
        },
        "part_use": {
          "description": "Which part use of the device supplies the PLC section (index into `Device.parts`); absent: the first\npart use whose part has one.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "slot": {
          "$ref": "#/$defs/SlotPath",
          "description": "The slot; default positional (the rank among the station's modules by `Device.position`)."
        },
        "start": {
          "$ref": "#/$defs/IoStarts",
          "description": "The start address per direction; default `auto` for both."
        }
      },
      "type": "object"
    },
    "PlcSize": {
      "description": "The access size of a PLC address.",
      "oneOf": [
        {
          "const": "bit",
          "description": "One bit (the default).",
          "type": "string"
        },
        {
          "const": "byte",
          "description": "A byte.",
          "type": "string"
        },
        {
          "const": "word",
          "description": "A word.",
          "type": "string"
        },
        {
          "const": "dword",
          "description": "A double word.",
          "type": "string"
        },
        {
          "const": "lword",
          "description": "A long word.",
          "type": "string"
        }
      ]
    },
    "PlcStation": {
      "additionalProperties": true,
      "description": "The `PlcStation` aspect (doc 10 §2.3): an addressable participant of a configuration project.",
      "properties": {
        "config_project": {
          "$ref": "#/$defs/Uuid",
          "description": "The configuration project."
        },
        "order": {
          "description": "Address-allocation order; absent: by ID (never by tag, page or bus address).",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "role": {
          "$ref": "#/$defs/StationRole",
          "description": "The station's role."
        }
      },
      "required": [
        "config_project",
        "role"
      ],
      "type": "object"
    },
    "Quantity": {
      "additionalProperties": true,
      "description": "A decimal value with its unit (doc 03 §3.2): `{\"value\": Dec3, \"unit\": Unit}`. Rendering (\"0.75 mm²\",\ndecimal comma in nl and de) is a query, never stored text (D-18).\n\n```\nuse ew_schema::{Quantity, Unit};\n\nlet q: Quantity = serde_json::from_str(r#\"{\"value\":\"20\",\"unit\":\"A\"}\"#).unwrap();\nassert_eq!(q.unit, Unit::A);\nassert_eq!(serde_json::to_string(&q).unwrap(), r#\"{\"value\":\"20\",\"unit\":\"A\"}\"#);\n```",
      "properties": {
        "unit": {
          "$ref": "#/$defs/Unit",
          "description": "Its unit."
        },
        "value": {
          "$ref": "#/$defs/Dec3",
          "description": "The number."
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "type": "object"
    },
    "RackSlot": {
      "additionalProperties": true,
      "description": "An authored rack position.",
      "properties": {
        "rack": {
          "description": "The rack.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "slot": {
          "description": "The slot.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "subslot": {
          "description": "The subslot.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "rack",
        "slot"
      ],
      "type": "object"
    },
    "Side": {
      "description": "A terminal side (doc 08 §2.1: side 1 is internal and side 2 external unless `Strip.field_side` says\notherwise).",
      "oneOf": [
        {
          "const": "side1",
          "description": "Side 1.",
          "type": "string"
        },
        {
          "const": "side2",
          "description": "Side 2.",
          "type": "string"
        }
      ]
    },
    "Slot": {
      "anyOf": [
        {
          "$ref": "#/$defs/Uuid"
        },
        {
          "const": "none"
        }
      ],
      "description": "A structure slot: a structure node ID or \"none\"; absent means inherit (doc 05 §3.2)."
    },
    "SlotPath": {
      "description": "The slot of a module (doc 10 §2.3).",
      "oneOf": [
        {
          "const": "positional",
          "description": "The 1-based rank among the station's I/O-module descendants by `Device.position` (the default).",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "Rack, slot and subslot.",
          "properties": {
            "rack": {
              "$ref": "#/$defs/RackSlot"
            }
          },
          "required": [
            "rack"
          ],
          "type": "object"
        }
      ]
    },
    "SourceRef": {
      "additionalProperties": true,
      "description": "The import provenance of a record (doc 14 §2.3, ADR-0004 amendment 1): the lineage and the source key\nfrom which the record's ID `v5(lineage namespace, key)` was derived.",
      "properties": {
        "key": {
          "description": "The source key, byte for byte (NFC), such as `qet:el:<uuid>`.",
          "type": "string"
        },
        "lineage": {
          "$ref": "#/$defs/Uuid",
          "description": "The import lineage."
        }
      },
      "required": [
        "lineage",
        "key"
      ],
      "type": "object"
    },
    "StationRole": {
      "description": "The role of a station (doc 10 §2.3).",
      "oneOf": [
        {
          "const": "cpu",
          "description": "A CPU.",
          "type": "string"
        },
        {
          "const": "head_station",
          "description": "A head station of remote I/O.",
          "type": "string"
        },
        {
          "const": "io_device",
          "description": "An I/O device.",
          "type": "string"
        },
        {
          "const": "valve_terminal",
          "description": "A valve terminal.",
          "type": "string"
        },
        {
          "const": "io_link_master",
          "description": "An IO-Link master.",
          "type": "string"
        },
        {
          "const": "drive",
          "description": "A drive.",
          "type": "string"
        },
        {
          "const": "external_partner",
          "description": "A placeholder for a partner outside the project (FR-BUS-005).",
          "type": "string"
        }
      ]
    },
    "Strip": {
      "additionalProperties": true,
      "description": "The `Strip` aspect (doc 03 §11).",
      "properties": {
        "accessories": {
          "description": "Accessories in mounting order (FR-TRM-016).",
          "items": {
            "$ref": "#/$defs/StripAccessory"
          },
          "type": "array"
        },
        "designation_scheme": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ident"
            },
            {
              "type": "null"
            }
          ],
          "description": "Terminal designation scheme (FR-NUM-024)."
        },
        "field_side": {
          "$ref": "#/$defs/Side",
          "description": "The terminal side facing the field; default side 2 (FR-TRM-012)."
        },
        "groups": {
          "description": "Range captions (\"Pneumatics\", \"Spare\"; FR-TRM-010).",
          "items": {
            "$ref": "#/$defs/TerminalGroup"
          },
          "type": "array"
        },
        "label_mode": {
          "$ref": "#/$defs/LabelMode",
          "description": "What terminals print; default the designation."
        },
        "tag_print": {
          "$ref": "#/$defs/TagPrint",
          "description": "Where the strip tag prints; default once per segment."
        }
      },
      "type": "object"
    },
    "StripAccessory": {
      "additionalProperties": true,
      "description": "One strip accessory placed after terminal `after_seq`.",
      "properties": {
        "after_seq": {
          "description": "The terminal sequence number it follows.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/AccessoryKind",
          "description": "The accessory kind."
        },
        "part": {
          "$ref": "#/$defs/PartRef",
          "description": "The part."
        }
      },
      "required": [
        "after_seq",
        "kind",
        "part"
      ],
      "type": "object"
    },
    "StructureAssignment": {
      "additionalProperties": true,
      "description": "Which structure node a page, device or structure box belongs to, one slot per aspect (doc 03 §5).\nMembers follow the canonical aspect order of `ew_rds::Aspect`; the product aspect is the device tree and\nhas no slot.\n\n```\nuse ew_schema::StructureAssignment;\n\nlet s: StructureAssignment = serde_json::from_str(\n    r#\"{\"function\":\"7d2c95e0-1f4a-5b38-a6e7-0c93b5d1f284\",\"location\":\"none\"}\"#,\n).unwrap();\nassert!(s.installation_site.is_none()); // absent: inherit\n```",
      "properties": {
        "document_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/Slot"
            },
            {
              "type": "null"
            }
          ],
          "description": "`&` (pages only)."
        },
        "function": {
          "anyOf": [
            {
              "$ref": "#/$defs/Slot"
            },
            {
              "type": "null"
            }
          ],
          "description": "`=`"
        },
        "functional_assignment": {
          "anyOf": [
            {
              "$ref": "#/$defs/Slot"
            },
            {
              "type": "null"
            }
          ],
          "description": "`==`"
        },
        "installation_site": {
          "anyOf": [
            {
              "$ref": "#/$defs/Slot"
            },
            {
              "type": "null"
            }
          ],
          "description": "`++`"
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/Slot"
            },
            {
              "type": "null"
            }
          ],
          "description": "`+`"
        },
        "type": {
          "anyOf": [
            {
              "$ref": "#/$defs/Slot"
            },
            {
              "type": "null"
            }
          ],
          "description": "`%`"
        },
        "user_defined": {
          "anyOf": [
            {
              "$ref": "#/$defs/Slot"
            },
            {
              "type": "null"
            }
          ],
          "description": "`#`"
        }
      },
      "type": "object"
    },
    "TagPrint": {
      "description": "Where a strip prints its tag (FR-TRM-011).",
      "oneOf": [
        {
          "const": "per_segment",
          "description": "Once per strip segment (the default).",
          "type": "string"
        },
        {
          "const": "per_page",
          "description": "Once per page.",
          "type": "string"
        }
      ]
    },
    "TagScheme": {
      "description": "The numbering scheme of a tag.",
      "oneOf": [
        {
          "const": "default",
          "description": "The project's active scheme (the default).",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "A named scheme.",
          "properties": {
            "named": {
              "$ref": "#/$defs/Ident"
            }
          },
          "required": [
            "named"
          ],
          "type": "object"
        },
        {
          "const": "child",
          "description": "Parent designation, separator, letter and counter (FR-NUM-013).",
