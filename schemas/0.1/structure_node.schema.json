{
  "$defs": {
    "Aspect": {
      "description": "The IEC 81346 aspect of a structure tree (doc 03 §5).",
      "enum": [
        "functional_assignment",
        "function",
        "installation_site",
        "location",
        "document_kind",
        "user_defined",
        "type"
      ],
      "type": "string"
    },
    "Ident": {
      "description": "An NFC identifier without surrounding white space (doc 05 §3.2).",
      "minLength": 1,
      "pattern": "^\\S(.*\\S)?$",
      "type": "string"
    },
    "MlText": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "additionalProperties": {
            "minLength": 1,
            "type": "string"
          },
          "minProperties": 1,
          "type": "object"
        }
      ],
      "description": "Multilingual text: a neutral string, or an object keyed by BCP 47 tags (doc 05 §3.2)."
    },
    "SourceRef": {
      "additionalProperties": true,
      "description": "The import provenance of a record (doc 14 §2.3, ADR-0004 amendment 1): the lineage and the source key\nfrom which the record's ID `v5(lineage namespace, key)` was derived.",
      "properties": {
        "key": {
          "description": "The source key, byte for byte (NFC), such as `qet:el:<uuid>`.",
          "type": "string"
        },
        "lineage": {
          "$ref": "#/$defs/Uuid",
          "description": "The import lineage."
        }
      },
      "required": [
        "lineage",
        "key"
      ],
      "type": "object"
    },
    "Uuid": {
      "description": "A lower-case hyphenated UUID (doc 05 §3.2).",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "One identifier in one aspect tree (doc 03 §5, rank 20).",
  "properties": {
    "$k": {
      "const": "structure_node",
      "description": "The kind name; always the first member."
    },
    "$v": {
      "description": "Per-kind schema version `$v`, omitted when 1.",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "aliases": {
      "description": "Import spellings that map to this node (\"JE2416\"; a set, sorted); never printed (D-03).",
      "items": {
        "$ref": "#/$defs/Ident"
      },
      "type": "array"
    },
    "aspect": {
      "$ref": "#/$defs/Aspect",
      "description": "The aspect tree."
    },
    "code": {
      "$ref": "#/$defs/Ident",
      "description": "The atomic code (\"J-E-2416\", FR-PRJ-017)."
    },
    "description": {
      "$ref": "#/$defs/MlText",
      "description": "Description."
    },
    "id": {
      "$ref": "#/$defs/Uuid",
      "description": "The record ID."
    },
    "order": {
      "description": "Sort order among siblings (FR-PRJ-012).",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "parent": {
      "anyOf": [
        {
          "$ref": "#/$defs/Uuid"
        },
        {
          "type": "null"
        }
      ],
      "description": "Parent node of the same aspect."
    },
    "source_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceRef"
        },
        {
          "type": "null"
        }
      ],
      "description": "Import provenance."
    }
  },
  "required": [
    "$k",
    "id",
    "aspect",
    "code"
  ],
  "title": "structure_node",
  "type": "object"
}
