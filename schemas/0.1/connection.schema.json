{
  "$defs": {
    "AssignedNumber": {
      "additionalProperties": true,
      "description": "The payload of [`NumberSpec::Assigned`].",
      "properties": {
        "counter": {
          "description": "The counter.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "counter"
      ],
      "type": "object"
    },
    "BridgeKind": {
      "description": "Kind of a terminal bridge.",
      "oneOf": [
        {
          "const": "plug_in",
          "description": "Plug-in bridge.",
          "type": "string"
        },
        {
          "const": "saddle",
          "description": "Saddle jumper.",
          "type": "string"
        },
        {
          "const": "wire",
          "description": "Wire bridge.",
          "type": "string"
        },
        {
          "const": "inter_level",
          "description": "Bridge between levels.",
          "type": "string"
        }
      ]
    },
    "BridgeSpec": {
      "additionalProperties": true,
      "description": "A terminal bridge (doc 08 §2.3): the connections of one group are one bridge object.",
      "properties": {
        "group": {
          "description": "Group number on the strip.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/BridgeKind",
          "description": "Bridge kind."
        },
        "shaft": {
          "description": "The shaft.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "group",
        "shaft"
      ],
      "type": "object"
    },
    "BusLine": {
      "additionalProperties": true,
      "description": "A bus line and the cable that carries it (FR-CBL-008).",
      "properties": {
        "cable": {
          "anyOf": [
            {
              "$ref": "#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ],
          "description": "The cable device."
        }
      },
      "type": "object"
    },
    "ColourCode": {
      "anyOf": [
        {
          "$ref": "#/$defs/Ident"
        },
        {
          "additionalProperties": false,
          "properties": {
            "foreign": {
              "$ref": "#/$defs/Ident"
            }
          },
          "required": [
            "foreign"
          ],
          "type": "object"
        }
      ],
      "description": "An IEC 60757 or profile-declared company colour code, or {\"foreign\": code} (doc 05 §3.2)."
    },
    "ColourSpec": {
      "description": "One or two colour codes (doc 03 §3.4).",
      "items": {
        "$ref": "#/$defs/ColourCode"
      },
      "maxItems": 2,
      "minItems": 1,
      "type": "array"
    },
    "ConnectionKind": {
      "description": "The kind of a connection (doc 08 §2.3). `Fluid(FluidLine)` (doc 11) and `SingleLine` (1.0) are additive\nvariants of their work packages; until then a file's value is kept as [`ConnectionKind::Unknown`], which\njoins no net (doc 05 §10.3 rule 3).",
      "oneOf": [
        {
          "const": "wire",
          "description": "One conductor (the default).",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "A cable core or shield.",
          "properties": {
            "core": {
              "$ref": "#/$defs/Uuid"
            }
          },
          "required": [
            "core"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A terminal bridge; joins potentials, never a wire.",
          "properties": {
            "bridge": {
              "$ref": "#/$defs/BridgeSpec"
            }
          },
          "required": [
            "bridge"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A single-line bus connection between bus-port CPs.",
          "properties": {
            "bus": {
              "$ref": "#/$defs/BusLine"
            }
          },
          "required": [
            "bus"
          ],
          "type": "object"
        },
        {
          "const": "overview",
          "description": "Excluded from nets.",
          "type": "string"
        },
        {
          "const": "internal",
          "description": "A link between CPs of two functions of one part that no FnDef declares.",
          "type": "string"
        }
      ]
    },
    "Csa": {
      "anyOf": [
        {
          "$ref": "#/$defs/Dec3"
        },
        {
          "additionalProperties": false,
          "properties": {
            "awg": {
              "maximum": 127,
              "minimum": -128,
              "type": "integer"
            }
          },
          "required": [
            "awg"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kcmil": {
              "$ref": "#/$defs/Dec3"
            }
          },
          "required": [
            "kcmil"
          ],
          "type": "object"
        }
      ],
      "description": "A cross-section: a Dec3 string in mm², {\"awg\": n} or {\"kcmil\": Dec3} (doc 08 §4.6)."
    },
    "Dec3": {
      "description": "A canonical decimal string: at most three fraction digits, no trailing fraction zeros, no leading zeros, no plus sign, no \"-0\", no exponent, no white space, no unit (doc 05 §3.2). The pattern bounds the integer part to 16 digits; the exact i64 range of the thousandths (about 9.2 x 10^15) is checked by the reader.",
      "maxLength": 21,
      "pattern": "^(?:0|-?[1-9][0-9]{0,15}(?:\\.[0-9]{0,2}[1-9])?|-?0\\.[0-9]{0,2}[1-9])$",
      "type": "string"
    },
    "Endpoint": {
      "description": "One end of a connection, a definition or a bond (ADR-0007, doc 03 §9): a connection point of a function\nor a junction. Encoding (doc 05 §3.2): `{\"cp\": [function, idx]}` or `{\"junction\": id}`.\n\n```\nuse ew_schema::Endpoint;\n\nlet e: Endpoint = serde_json::from_str(r#\"{\"cp\":[\"d40b6e93-25f7-5c1a-9e8d-7a3f1c05b6e2\",0]}\"#).unwrap();\nassert!(matches!(e, Endpoint::Cp(_, 0)));\n```",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Connection point `idx` of a function; its ID `v5(function, idx)` is derived, never stored.",
          "properties": {
            "cp": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "$ref": "#/$defs/Uuid"
                },
                {
                  "format": "uint16",
                  "maximum": 65535,
                  "minimum": 0,
                  "type": "integer"
                }
              ],
              "type": "array"
            }
          },
          "required": [
            "cp"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A junction.",
          "properties": {
            "junction": {
              "$ref": "#/$defs/Uuid"
            }
          },
          "required": [
            "junction"
          ],
          "type": "object"
        }
      ]
    },
    "Ident": {
      "description": "An identifier: non-empty, one line (no control character U+0000 to U+001F or U+007F to U+009F), without leading or trailing white space (the Unicode White_Space set); interior spaces are allowed (doc 05 §3.2). JSON Schema cannot express Unicode Normalization Form C; the reader rejects non-NFC text.",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000](?:[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000])?$",
      "type": "string"
    },
    "Nm": {
      "description": "A length in nanometres (doc 05 §3.2). Written without fraction or exponent; JSON Schema cannot tell 5 from 5.0, the reader rejects the latter.",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
    },
    "NumberSpec": {
      "description": "The wire number of a connection (doc 03 §8.7).",
      "oneOf": [
        {
          "const": "unassigned",
          "description": "Not numbered; prints \"?\" (the default).",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "A counter assigned by the numbering rule: `{\"assigned\": {\"counter\": n}}`.",
          "properties": {
            "assigned": {
              "$ref": "#/$defs/AssignedNumber"
            }
          },
          "required": [
            "assigned"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A frozen number (FR-NUM-011).",
          "properties": {
            "frozen": {
              "$ref": "#/$defs/Ident"
            }
          },
          "required": [
            "frozen"
          ],
          "type": "object"
        }
      ]
    },
    "PartRef": {
      "additionalProperties": true,
      "description": "A part on a device (doc 03 §7): the embedded copy and an optional part variant (FR-PRT-003).",
      "properties": {
        "copy": {
          "$ref": "#/$defs/Uuid",
          "description": "The copy ID of the embedded part, `v5(NS_LIBCOPY, library ‖ item)`."
        },
        "variant": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ident"
            },
            {
              "type": "null"
            }
          ],
          "description": "A variant key of the part."
        }
      },
      "required": [
        "copy"
      ],
      "type": "object"
    },
    "Pt2": {
      "description": "A point [x, y] in nanometres, y downwards (doc 05 §3.2).",
      "items": false,
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        }
      ],
      "type": "array"
    },
    "SourceRef": {
      "additionalProperties": true,
      "description": "The import provenance of a record (doc 14 §2.3, ADR-0004 amendment 1): the lineage and the source key\nfrom which the record's ID `v5(lineage namespace, key)` was derived.",
      "properties": {
        "key": {
          "description": "The source key, byte for byte (NFC), such as `qet:el:<uuid>`.",
          "type": "string"
        },
        "lineage": {
          "$ref": "#/$defs/Uuid",
          "description": "The import lineage."
        }
      },
      "required": [
        "lineage",
        "key"
      ],
      "type": "object"
    },
    "Uuid": {
      "description": "A lower-case hyphenated UUID (doc 05 §3.2).",
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "WireFlags": {
      "additionalProperties": true,
      "description": "Shielded and twisted flags of a wire.",
      "properties": {
        "shielded": {
          "description": "Shielded.",
          "type": "boolean"
        },
        "twisted": {
          "description": "Twisted.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "WireOverrides": {
      "additionalProperties": true,
      "description": "The explicit per-connection values (doc 03 §9, the CDP), rendered as a wire marker on request.\n\nNot in v0: `ends` (per-end overrides, doc 13 §2.3).",
      "properties": {
        "colour": {
          "anyOf": [
            {
              "$ref": "#/$defs/ColourSpec"
            },
            {
              "type": "null"
            }
          ],
          "description": "Colour."
        },
        "csa": {
          "anyOf": [
            {
              "$ref": "#/$defs/Csa"
            },
            {
              "type": "null"
            }
          ],
          "description": "Cross-section."
        },
        "flags": {
          "$ref": "#/$defs/WireFlags",
          "description": "Shielded and twisted flags."
        },
        "function": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ident"
            },
            {
              "type": "null"
            }
          ],
          "description": "Wire function."
        },
        "insulation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ident"
            },
            {
              "type": "null"
            }
          ],
          "description": "Insulation type."
        },
        "length": {
          "anyOf": [
            {
              "$ref": "#/$defs/Nm"
            },
            {
              "type": "null"
            }
          ],
          "description": "Manual wire length on the carrier connection (doc 12 §9)."
        },
        "show_marker": {
          "description": "Show the override as a wire marker.",
          "type": "boolean"
        },
        "wire_part": {
          "anyOf": [
            {
              "$ref": "#/$defs/PartRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "Wire part; on the first bridge of a group, the bridge part (level-6 data)."
        }
      },
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "One explicit logical edge with a route (ADR-0007, doc 03 §9, rank 34). Page-owned when drawn; a\npage-less connection (strip-editor bridge, internal link) lives in the shard of the device owning `a`.",
  "properties": {
    "$k": {
      "const": "connection",
      "description": "The kind name; always the first member."
    },
    "$v": {
      "description": "Per-kind schema version `$v`, omitted when 1.",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "a": {
      "$ref": "#/$defs/Endpoint",
      "description": "First endpoint."
    },
    "b": {
      "$ref": "#/$defs/Endpoint",
      "description": "Second endpoint."
    },
    "id": {
      "$ref": "#/$defs/Uuid",
      "description": "The record ID; also the wire ID of the physical wire it carries."
    },
    "kind": {
      "$ref": "#/$defs/ConnectionKind",
      "description": "The connection kind; default a wire."
    },
    "number": {
      "$ref": "#/$defs/NumberSpec",
      "description": "The wire number; default unassigned."
    },
    "overrides": {
      "$ref": "#/$defs/WireOverrides",
      "description": "Explicit per-connection values (the CDP, level 7)."
    },
    "page": {
      "anyOf": [
        {
          "$ref": "#/$defs/Uuid"
        },
        {
          "type": "null"
        }
      ],
      "description": "The page it is drawn on."
    },
    "route": {
      "description": "Orthogonal route in nm, in model order.",
      "items": {
        "$ref": "#/$defs/Pt2"
      },
      "type": "array"
    },
    "source_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceRef"
        },
        {
          "type": "null"
        }
      ],
      "description": "Import provenance."
    }
  },
  "required": [
    "$k",
    "id",
    "a",
    "b"
  ],
  "title": "connection",
  "type": "object"
}
