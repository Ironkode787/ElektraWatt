{
  "$defs": {
    "ContinuationPolicy": {
      "anyOf": [
        {
          "const": "sub_page",
          "description": "907, 907.1, 907.2 … (the default).",
          "type": "string"
        },
        {
          "const": "next_folio",
          "description": "907, 908, 909 …",
          "type": "string"
        }
      ],
      "description": "Continuation numbering of report pages."
    },
    "EmbedSpec": {
      "additionalProperties": true,
      "description": "Placement of an embedded report block.",
      "properties": {
        "page": {
          "$ref": "#/$defs/Uuid",
          "description": "The page."
        },
        "rect": {
          "$ref": "#/$defs/Rect",
          "description": "The area on the page."
        }
      },
      "required": [
        "page",
        "rect"
      ],
      "type": "object"
    },
    "EmptyPolicy": {
      "anyOf": [
        {
          "const": "omit_pages",
          "description": "No pages (the default).",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "One page with this text.",
          "properties": {
            "one_page": {
              "$ref": "#/$defs/MlText"
            }
          },
          "required": [
            "one_page"
          ],
          "type": "object"
        }
      ],
      "description": "What a block without rows prints."
    },
    "GroupBreak": {
      "anyOf": [
        {
          "const": "none",
          "description": "Rows continue.",
          "type": "string"
        },
        {
          "const": "new_page",
          "description": "A new page.",
          "type": "string"
        },
        {
          "const": "new_folio",
          "description": "A new folio.",
          "type": "string"
        }
      ],
      "description": "What happens at a group change."
    },
    "GroupSpec": {
      "additionalProperties": true,
      "description": "Grouping of report rows.",
      "properties": {
        "break": {
          "$ref": "#/$defs/GroupBreak",
          "description": "What happens at a group change; default nothing."
        },
        "key": {
          "$ref": "#/$defs/Ident",
          "description": "The group key column."
        }
      },
      "required": [
        "key"
      ],
      "type": "object"
    },
    "Ident": {
      "description": "An NFC identifier without surrounding white space (doc 05 §3.2).",
      "minLength": 1,
      "pattern": "^\\S(.*\\S)?$",
      "type": "string"
    },
    "ManualSelection": {
      "additionalProperties": true,
      "description": "Explicit include and exclude lists of entity IDs (sets, sorted).",
      "properties": {
        "exclude": {
          "description": "Entities always excluded.",
          "items": {
            "$ref": "#/$defs/Uuid"
          },
          "type": "array"
        },
        "include": {
          "description": "Entities always included.",
          "items": {
            "$ref": "#/$defs/Uuid"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "MlText": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "additionalProperties": {
            "minLength": 1,
            "type": "string"
          },
          "minProperties": 1,
          "type": "object"
        }
      ],
      "description": "Multilingual text: a neutral string, or an object keyed by BCP 47 tags (doc 05 §3.2)."
    },
    "Pt2": {
      "description": "A point [x, y] in nanometres, y downwards (doc 05 §3.2).",
      "items": false,
      "minItems": 2,
      "prefixItems": [
        {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        }
      ],
      "type": "array"
    },
    "Rect": {
      "description": "A rectangle [[x0, y0], [x1, y1]] in nanometres, minimum corner first (doc 05 §3.2).",
      "items": false,
      "minItems": 2,
      "prefixItems": [
        {
          "$ref": "#/$defs/Pt2"
        },
        {
          "$ref": "#/$defs/Pt2"
        }
      ],
      "type": "array"
    },
    "ReportKind": {
      "anyOf": [
        {
          "const": "profile_tables",
          "description": "Colour and size tables (embedded).",
          "type": "string"
        },
        {
          "const": "part_data",
          "description": "PART DATA box (embedded).",
          "type": "string"
        },
        {
          "const": "toc",
          "description": "Table of contents.",
          "type": "string"
        },
        {
          "const": "structure_overview",
          "description": "Structure-identifier and device-tag overview.",
          "type": "string"
        },
        {
          "const": "parts_summary",
          "description": "Summarised parts list.",
          "type": "string"
        },
        {
          "const": "parts_list",
          "description": "Parts list per device part line.",
          "type": "string"
        },
        {
          "const": "device_list",
          "description": "Device list.",
          "type": "string"
        },
        {
          "const": "terminal_diagram",
          "description": "Terminal diagram per strip.",
          "type": "string"
        },
        {
          "const": "terminal_overview",
          "description": "Terminal-strip overview.",
          "type": "string"
        },
        {
          "const": "cable_overview_diagrams",
          "description": "Cable overview and per-cable diagrams.",
          "type": "string"
        },
        {
          "const": "wire_list",
          "description": "Wire list.",
          "type": "string"
        },
        {
          "const": "plc_overview",
          "description": "PLC overview.",
          "type": "string"
        },
        {
          "const": "io_list",
          "description": "I/O assignment list.",
          "type": "string"
        },
        {
          "const": "potential_overview",
          "description": "Potential overview.",
          "type": "string"
        },
        {
          "const": "revision_overview",
          "description": "Revision overview.",
          "type": "string"
        },
        {
          "const": "open_items",
          "description": "Open items.",
          "type": "string"
        },
        {
          "const": "numbering_report",
          "description": "Numbering report.",
          "type": "string"
        },
        {
          "const": "enclosure_legend",
          "description": "Enclosure legend.",
          "type": "string"
        },
        {
          "const": "check_report",
          "description": "Check report.",
          "type": "string"
        }
      ],
      "description": "The built-in report kinds of the MVP (doc 09 §2.4); later kinds arrive as additive variants."
    },
    "ReportSource": {
      "anyOf": [
        {
          "additionalProperties": false,
          "description": "A built-in report kind (doc 09 §2.4).",
          "properties": {
            "kind": {
              "$ref": "#/$defs/ReportKind"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A user SQL report in `reports/<file>.sql` (untrusted until the project is trusted).",
          "properties": {
            "sql_query": {
              "$ref": "#/$defs/SqlQuery"
            }
          },
          "required": [
            "sql_query"
          ],
          "type": "object"
        }
      ],
      "description": "The row source of a report block: `{\"kind\": \"<report kind>\"}` or `{\"sql_query\": {\"api\", \"file\"}}`."
    },
    "SortKey": {
      "additionalProperties": true,
      "description": "One sort key: a column key and a direction.",
      "properties": {
        "descending": {
          "description": "Descending order; default ascending.",
          "type": "boolean"
        },
        "key": {
          "$ref": "#/$defs/Ident",
          "description": "The column key."
        }
      },
      "required": [
        "key"
      ],
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": true,
      "description": "The import provenance of a record (doc 14 §2.3, ADR-0004 amendment 1): the lineage and the source key\nfrom which the record's ID `v5(lineage namespace, key)` was derived.",
      "properties": {
        "key": {
          "description": "The source key, byte for byte (NFC), such as `qet:el:<uuid>`.",
          "type": "string"
        },
        "lineage": {
          "$ref": "#/$defs/Uuid",
          "description": "The import lineage."
        }
      },
      "required": [
        "lineage",
        "key"
      ],
      "type": "object"
    },
    "SqlQuery": {
      "additionalProperties": true,
      "description": "A user SQL report.",
      "properties": {
        "api": {
          "description": "The SQL projection API version (`\"v1\"`).",
          "type": "string"
        },
        "file": {
          "$ref": "#/$defs/Uuid",
          "description": "The UUID naming `reports/<uuid>.sql`."
        }
      },
      "required": [
        "api",
        "file"
      ],
      "type": "object"
    },
    "Uuid": {
      "description": "A lower-case hyphenated UUID (doc 05 §3.2).",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "A report placed in the page order (doc 03 §6, doc 09 §2.2, rank 45). Page-oriented blocks live in\n`report-blocks.jsonl`, embedded blocks in the file of `embedded.page`. Its pages are derived.\n\nNot in v0: `filter` (typed predicate or rhai expression, FR-EXT-011), `Kind.params`, the header and\nfooter rows of `group`, and `EmbedSpec.overflow`; their encodings are open (doc 09).",
  "properties": {
    "$k": {
      "const": "report_block",
      "description": "The kind name; always the first member."
    },
    "$v": {
      "description": "Per-kind schema version `$v`, omitted when 1.",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "continuation": {
      "$ref": "#/$defs/ContinuationPolicy",
      "description": "Continuation numbering; default sub-pages 907, 907.1 … (FR-PAG-030)."
    },
    "embedded": {
      "anyOf": [
        {
          "$ref": "#/$defs/EmbedSpec"
        },
        {
          "type": "null"
        }
      ],
      "description": "Placement on a page for embedded blocks."
    },
    "empty": {
      "$ref": "#/$defs/EmptyPolicy",
      "description": "What to print without rows; default no pages."
    },
    "first_folio": {
      "description": "The first folio (907).",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "form": {
      "$ref": "#/$defs/Uuid",
      "description": "The first page's form; its `continuation` names the next."
    },
    "group": {
      "anyOf": [
        {
          "$ref": "#/$defs/GroupSpec"
        },
        {
          "type": "null"
        }
      ],
      "description": "Grouping."
    },
    "id": {
      "$ref": "#/$defs/Uuid",
      "description": "The record ID; generated pages are `v5(id, page_index)`."
    },
    "manual": {
      "$ref": "#/$defs/ManualSelection",
      "description": "Explicit include and exclude lists (FR-REP-027)."
    },
    "section": {
      "anyOf": [
        {
          "$ref": "#/$defs/Uuid"
        },
        {
          "type": "null"
        }
      ],
      "description": "The section."
    },
    "sort": {
      "description": "Sort keys, natural collation.",
      "items": {
        "$ref": "#/$defs/SortKey"
      },
      "type": "array"
    },
    "source": {
      "$ref": "#/$defs/ReportSource",
      "description": "The row source."
    },
    "source_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceRef"
        },
        {
          "type": "null"
        }
      ],
      "description": "Import provenance."
    },
    "title": {
      "$ref": "#/$defs/MlText",
      "description": "Page-title format (\"Wire List {n}\")."
    }
  },
  "required": [
    "$k",
    "id",
    "source",
    "form",
    "first_folio"
  ],
  "title": "report_block",
  "type": "object"
}
