{
  "$defs": {
    "ColourCode": {
      "anyOf": [
        {
          "$ref": "#/$defs/Ident"
        },
        {
          "additionalProperties": false,
          "properties": {
            "foreign": {
              "$ref": "#/$defs/Ident"
            }
          },
          "required": [
            "foreign"
          ],
          "type": "object"
        }
      ],
      "description": "An IEC 60757 or profile-declared company colour code, or {\"foreign\": code} (doc 05 §3.2)."
    },
    "ColourSpec": {
      "description": "One or two colour codes (doc 03 §3.4).",
      "items": {
        "$ref": "#/$defs/ColourCode"
      },
      "maxItems": 2,
      "minItems": 1,
      "type": "array"
    },
    "Dec3": {
      "description": "A canonical decimal string: at most three fraction digits, no trailing fraction zeros, no leading zeros, no plus sign, no \"-0\", no exponent, no white space, no unit (doc 05 §3.2). The pattern bounds the integer part to 16 digits; the exact i64 range of the thousandths (about 9.2 x 10^15) is checked by the reader.",
      "maxLength": 21,
      "pattern": "^(?:0|-?[1-9][0-9]{0,15}(?:\\.[0-9]{0,2}[1-9])?|-?0\\.[0-9]{0,2}[1-9])$",
      "type": "string"
    },
    "Discipline": {
      "description": "Discipline of a connection point.",
      "oneOf": [
        {
          "const": "electrical",
          "description": "Electrical (the default).",
          "type": "string"
        },
        {
          "const": "pneumatic",
          "description": "Pneumatic.",
          "type": "string"
        },
        {
          "const": "vacuum",
          "description": "Vacuum.",
          "type": "string"
        },
        {
          "const": "hydraulic",
          "description": "Hydraulic.",
          "type": "string"
        },
        {
          "const": "bus",
          "description": "Bus.",
          "type": "string"
        }
      ]
    },
    "Ident": {
      "description": "An identifier: non-empty, one line (no control character U+0000 to U+001F or U+007F to U+009F), without leading or trailing white space (the Unicode White_Space set); interior spaces are allowed (doc 05 §3.2). JSON Schema cannot express Unicode Normalization Form C; the reader rejects non-NFC text.",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000](?:[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000])?$",
      "type": "string"
    },
    "LineKind": {
      "description": "The kind of a fluid line (doc 11 §2.4): pilot and drain lines are drawn dashed.",
      "oneOf": [
        {
          "const": "working",
          "description": "A working line (the default).",
          "type": "string"
        },
        {
          "const": "pilot",
          "description": "A pilot line.",
          "type": "string"
        },
        {
          "const": "exhaust",
          "description": "An exhaust line.",
          "type": "string"
        },
        {
          "const": "drain",
          "description": "A drain line.",
          "type": "string"
        },
        {
          "const": "flexible",
          "description": "A flexible line.",
          "type": "string"
        }
      ]
    },
    "LineKindTube": {
      "additionalProperties": true,
      "description": "The default tube of one line kind of a medium.",
      "properties": {
        "line_kind": {
          "$ref": "#/$defs/LineKind",
          "description": "The line kind."
        },
        "tube": {
          "$ref": "#/$defs/TubeSpec",
          "description": "Its tube."
        }
      },
      "required": [
        "tube"
      ],
      "type": "object"
    },
    "MlText": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "additionalProperties": {
            "minLength": 1,
            "type": "string"
          },
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^(?:[a-z]{2,3}(?:-[a-z]{3}){0,3}|[a-z]{4,8})(?:-[A-Z][a-z]{3})?(?:-(?:[A-Z]{2}|[0-9]{3}))?(?:-(?:[a-z0-9]{5,8}|[0-9][a-z0-9]{3}))*(?:-[a-wy-z0-9](?:-[a-z0-9]{2,8})+)*(?:-x(?:-[a-z0-9]{1,8})+)?$",
            "type": "string"
          },
          "type": "object"
        }
      ],
      "description": "Multilingual text: a neutral string, or an object keyed by canonical BCP 47 tags with non-empty string values (doc 05 §3.2). JSON Schema cannot express that all text is NFC or that the keys are in ascending byte order; the reader rejects both."
    },
    "Nm": {
      "description": "A length in nanometres (doc 05 §3.2). Written without fraction or exponent; JSON Schema cannot tell 5 from 5.0, the reader rejects the latter.",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
    },
    "PartRef": {
      "additionalProperties": true,
      "description": "A part on a device (doc 03 §7): the embedded copy and an optional part variant (FR-PRT-003).",
      "properties": {
        "copy": {
          "$ref": "#/$defs/Uuid",
          "description": "The copy ID of the embedded part, `v5(NS_LIBCOPY, library ‖ item)`."
        },
        "variant": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ident"
            },
            {
              "type": "null"
            }
          ],
          "description": "A variant key of the part."
        }
      },
      "required": [
        "copy"
      ],
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": true,
      "description": "The import provenance of a record (doc 14 §2.3, ADR-0004 amendment 1): the lineage and the source key\nfrom which the record's ID `v5(lineage namespace, key)` was derived.",
      "properties": {
        "key": {
          "description": "The source key, byte for byte (NFC), such as `qet:el:<uuid>`.",
          "type": "string"
        },
        "lineage": {
          "$ref": "#/$defs/Uuid",
          "description": "The import lineage."
        }
      },
      "required": [
        "lineage",
        "key"
      ],
      "type": "object"
    },
    "TempRange": {
      "additionalProperties": true,
      "description": "A temperature range in °C; either end may be open.",
      "properties": {
        "max": {
          "anyOf": [
            {
              "$ref": "#/$defs/Dec3"
            },
            {
              "type": "null"
            }
          ],
          "description": "The highest temperature."
        },
        "min": {
          "anyOf": [
            {
              "$ref": "#/$defs/Dec3"
            },
            {
              "type": "null"
            }
          ],
          "description": "The lowest temperature."
        }
      },
      "type": "object"
    },
    "TubeMaterial": {
      "description": "The material of a tube (doc 11 §2.4).",
      "oneOf": [
        {
          "const": "pu",
          "description": "Polyurethane.",
          "type": "string"
        },
        {
          "const": "pa",
          "description": "Polyamide.",
          "type": "string"
        },
        {
          "const": "pe",
          "description": "Polyethylene.",
          "type": "string"
        },
        {
          "const": "ptfe",
          "description": "PTFE.",
          "type": "string"
        },
        {
          "const": "pvc",
          "description": "PVC.",
          "type": "string"
        },
        {
          "const": "cu",
          "description": "Copper.",
          "type": "string"
        },
        {
          "const": "steel",
          "description": "Steel.",
          "type": "string"
        }
      ]
    },
    "TubeSpec": {
      "additionalProperties": true,
      "description": "A tube specification (doc 11 §2.4), every value optional: the overrides of a line, a medium's default and the\nproject's default use the same shape, and the effective specification is resolved value by value (doc 11 §5.4).",
      "properties": {
        "colour": {
          "anyOf": [
            {
              "$ref": "#/$defs/ColourSpec"
            },
            {
              "type": "null"
            }
          ],
          "description": "The colour (an IEC 60757 code)."
        },
        "id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Nm"
            },
            {
              "type": "null"
            }
          ],
          "description": "The inner diameter."
        },
        "material": {
          "anyOf": [
            {
              "$ref": "#/$defs/TubeMaterial"
            },
            {
              "type": "null"
            }
          ],
          "description": "The material."
        },
        "od": {
          "anyOf": [
            {
              "$ref": "#/$defs/Nm"
            },
            {
              "type": "null"
            }
          ],
          "description": "The outer diameter."
        },
        "p_rating": {
          "anyOf": [
            {
              "$ref": "#/$defs/Dec3"
            },
            {
              "type": "null"
            }
          ],
          "description": "The pressure rating (bar)."
        },
        "part": {
          "anyOf": [
            {
              "$ref": "#/$defs/PartRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "The tube part."
        },
        "t_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/TempRange"
            },
            {
              "type": "null"
            }
          ],
          "description": "The temperature range (°C)."
        }
      },
      "type": "object"
    },
    "Uuid": {
      "description": "A lower-case hyphenated UUID (doc 05 §3.2).",
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "A project medium (doc 11 §2.5, FR-FLU-008, rank 14): \"compressed air 6 bar\".",
  "properties": {
    "$k": {
      "const": "medium",
      "description": "The kind name; always the first member."
    },
    "$v": {
      "description": "Per-kind schema version `$v`, omitted when 1.",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "code": {
      "anyOf": [
        {
          "$ref": "#/$defs/Ident"
        },
        {
          "type": "null"
        }
      ],
      "description": "The ISO 1219-2 medium letter, needed only when a project uses several media."
    },
    "colour": {
      "anyOf": [
        {
          "$ref": "#/$defs/ColourSpec"
        },
        {
          "type": "null"
        }
      ],
      "description": "The colour of its tubes."
    },
    "default_tube": {
      "$ref": "#/$defs/TubeSpec",
      "description": "The default tube of its lines (doc 11 §5.4 level 2)."
    },
    "discipline": {
      "$ref": "#/$defs/Discipline",
      "description": "The discipline: pneumatic (the default), vacuum or hydraulic."
    },
    "id": {
      "$ref": "#/$defs/Uuid",
      "description": "The record ID."
    },
    "line_kind_tubes": {
      "description": "The default tube of the lines of a kind, before `default_tube` (a pilot line's 4×2.7 mm).",
      "items": {
        "$ref": "#/$defs/LineKindTube"
      },
      "type": "array"
    },
    "name": {
      "$ref": "#/$defs/MlText",
      "description": "The name."
    },
    "p_nom": {
      "$ref": "#/$defs/Dec3",
      "description": "The nominal pressure (bar, gauge)."
    },
    "quality": {
      "anyOf": [
        {
          "$ref": "#/$defs/Ident"
        },
        {
          "type": "null"
        }
      ],
      "description": "The quality class per ISO 8573-1 (\"[1:4:1]\")."
    },
    "source_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceRef"
        },
        {
          "type": "null"
        }
      ],
      "description": "Import provenance."
    },
    "t_range": {
      "anyOf": [
        {
          "$ref": "#/$defs/TempRange"
        },
        {
          "type": "null"
        }
      ],
      "description": "The temperature range (°C)."
    }
  },
  "required": [
    "$k",
    "id",
    "name",
    "p_nom"
  ],
  "title": "medium",
  "type": "object"
}
