{
  "$defs": {
    "CableCore": {
      "additionalProperties": true,
      "description": "One core of a cable part.",
      "properties": {
        "colour": {
          "anyOf": [
            {
              "$ref": "#/$defs/ColourSpec"
            },
            {
              "type": "null"
            }
          ],
          "description": "Colour."
        },
        "core": {
          "$ref": "#/$defs/Ident",
          "description": "Core identification."
        },
        "csa": {
          "anyOf": [
            {
              "$ref": "#/$defs/Csa"
            },
            {
              "type": "null"
            }
          ],
          "description": "Cross-section."
        },
        "pair": {
          "description": "Pair number.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "shield": {
          "description": "A shield.",
          "type": "boolean"
        }
      },
      "required": [
        "core"
      ],
      "type": "object"
    },
    "ChannelKind": {
      "description": "The kind of a channel (doc 10 §2.4). `multi_function` (IO-Link port modes, 1.0) is additive.",
      "oneOf": [
        {
          "const": "di",
          "description": "Digital input.",
          "type": "string"
        },
        {
          "const": "do",
          "description": "Digital output.",
          "type": "string"
        },
        {
          "const": "ai",
          "description": "Analogue input.",
          "type": "string"
        },
        {
          "const": "ao",
          "description": "Analogue output.",
          "type": "string"
        },
        {
          "const": "counter",
          "description": "Counter.",
          "type": "string"
        },
        {
          "const": "io_link_port",
          "description": "IO-Link port.",
          "type": "string"
        },
        {
          "const": "power_supply",
          "description": "Power supply.",
          "type": "string"
        }
      ]
    },
    "ChannelSpec": {
      "additionalProperties": true,
      "description": "The channels a module part instantiates.",
      "properties": {
        "count": {
          "description": "How many (numbers 0 … count − 1).",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "data_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ident"
            },
            {
              "type": "null"
            }
          ],
          "description": "The data type in the profile vocabulary (\"Bool\")."
        },
        "designation": {
          "description": "The automatic designation pattern over `{n}` (\"{n}\", \"DO {n}\").",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/ChannelKind",
          "description": "Their kind."
        }
      },
      "required": [
        "count",
        "kind"
      ],
      "type": "object"
    },
    "ChannelState": {
      "description": "An explicit channel state (doc 10 §3.2); `used` is never stored, it is derived from the target.",
      "oneOf": [
        {
          "const": "spare",
          "description": "Spare.",
          "type": "string"
        },
        {
          "const": "reserved",
          "description": "Reserved.",
          "type": "string"
        },
        {
          "const": "deactivated",
          "description": "Deactivated.",
          "type": "string"
        }
      ]
    },
    "ClampKey": {
      "description": "The clamp of a terminal CP (doc 08 §2.3): `{\"clamp\": \"a\"}`, `{\"shaft\": 1}` or `\"rail_foot\"`.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A wire clamp a, b, c ….",
          "properties": {
            "clamp": {
              "maxLength": 1,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "clamp"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A bridge shaft.",
          "properties": {
            "shaft": {
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "shaft"
          ],
          "type": "object"
        },
        {
          "const": "rail_foot",
          "description": "The rail foot of a PE terminal.",
          "type": "string"
        }
      ]
    },
    "ColourCode": {
      "anyOf": [
        {
          "$ref": "#/$defs/Ident"
        },
        {
          "additionalProperties": false,
          "properties": {
            "foreign": {
              "$ref": "#/$defs/Ident"
            }
          },
          "required": [
            "foreign"
          ],
          "type": "object"
        }
      ],
      "description": "An IEC 60757 or profile-declared company colour code, or {\"foreign\": code} (doc 05 §3.2)."
    },
    "ColourSpec": {
      "description": "One or two colour codes (doc 03 §3.4).",
      "items": {
        "$ref": "#/$defs/ColourCode"
      },
      "maxItems": 2,
      "minItems": 1,
      "type": "array"
    },
    "Confidence": {
      "description": "Confidence of one section of library data.",
      "oneOf": [
        {
          "const": "verified",
          "description": "Checked against a source.",
          "type": "string"
        },
        {
          "const": "unverified",
          "description": "Not yet checked.",
          "type": "string"
        },
        {
          "const": "test",
          "description": "Test data.",
          "type": "string"
        }
      ]
    },
    "CpData": {
      "additionalProperties": true,
      "description": "One CP of a part's pattern (doc 07 §2.5, L1). Clamp ranges, maximum conductors, twin-ferrule permission\nand load current (1.0) are kept in `extra` until their work packages.",
      "properties": {
        "clamp": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClampKey"
            },
            {
              "type": "null"
            }
          ],
          "description": "Terminal clamp."
        },
        "designation": {
          "$ref": "#/$defs/Ident",
          "description": "Designation."
        },
        "idx": {
          "description": "Index.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "level": {
          "description": "Terminal level.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "potential_role": {
          "anyOf": [
            {
              "$ref": "#/$defs/PotentialType"
            },
            {
              "type": "null"
            }
          ],
          "description": "Potential role."
        },
        "side": {
          "anyOf": [
            {
              "$ref": "#/$defs/Side"
            },
            {
              "type": "null"
            }
          ],
          "description": "Terminal side."
        }
      },
      "required": [
        "idx",
        "designation"
      ],
      "type": "object"
    },
    "Csa": {
      "anyOf": [
        {
          "$ref": "#/$defs/Dec3"
        },
        {
          "additionalProperties": false,
          "properties": {
            "awg": {
              "maximum": 127,
              "minimum": -128,
              "type": "integer"
            }
          },
          "required": [
            "awg"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kcmil": {
              "$ref": "#/$defs/Dec3"
            }
          },
          "required": [
            "kcmil"
          ],
          "type": "object"
        }
      ],
      "description": "A cross-section: a Dec3 string in mm², {\"awg\": n} or {\"kcmil\": Dec3} (doc 08 §4.6)."
    },
    "Date": {
      "description": "An authored date YYYY-MM-DD (doc 05 §3.2).",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "type": "string"
    },
    "Dec3": {
      "description": "A canonical decimal string: at most three fraction digits, no trailing fraction zeros, no leading zeros, no plus sign, no \"-0\", no exponent, no white space, no unit (doc 05 §3.2). The pattern bounds the integer part to 16 digits; the exact i64 range of the thousandths (about 9.2 x 10^15) is checked by the reader.",
      "maxLength": 21,
      "pattern": "^(?:0|-?[1-9][0-9]{0,15}(?:\\.[0-9]{0,2}[1-9])?|-?0\\.[0-9]{0,2}[1-9])$",
      "type": "string"
    },
    "Deprecation": {
      "additionalProperties": true,
      "description": "The payload of [`ItemStatus::Deprecated`].",
      "properties": {
        "successor": {
          "anyOf": [
            {
              "$ref": "#/$defs/LibRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "The successor."
        }
      },
      "type": "object"
    },
    "FreeProp": {
      "additionalProperties": true,
      "description": "A free property (EPLAN free properties, user fields).",
      "properties": {
        "key": {
          "$ref": "#/$defs/Ident",
          "description": "Key."
        },
        "value": {
          "$ref": "#/$defs/MlText",
          "description": "Value."
        }
      },
      "required": [
        "key",
        "value"
      ],
      "type": "object"
    },
    "Ident": {
      "description": "An identifier: non-empty, one line (no control character U+0000 to U+001F or U+007F to U+009F), without leading or trailing white space (the Unicode White_Space set); interior spaces are allowed (doc 05 §3.2). JSON Schema cannot express Unicode Normalization Form C; the reader rejects non-NFC text.",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000](?:[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000])?$",
      "type": "string"
    },
    "IoClass": {
      "description": "The address class of an I/O range (the profile keeps one allocation cursor per class).",
      "oneOf": [
        {
          "const": "digital",
          "description": "Digital (the default).",
          "type": "string"
        },
        {
          "const": "analog",
          "description": "Analogue.",
          "type": "string"
        }
      ]
    },
    "IoDir": {
      "description": "The direction of an I/O range.",
      "oneOf": [
        {
          "const": "in",
          "description": "Inputs.",
          "type": "string"
        },
        {
          "const": "out",
          "description": "Outputs.",
          "type": "string"
        }
      ]
    },
    "IoRange": {
      "additionalProperties": true,
      "description": "One I/O range of a part.",
      "properties": {
        "bits": {
          "description": "The width in bits.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "class": {
          "$ref": "#/$defs/IoClass",
          "description": "The address class; default digital."
        },
        "dir": {
          "$ref": "#/$defs/IoDir",
          "description": "The direction."
        }
      },
      "required": [
        "dir",
        "bits"
      ],
      "type": "object"
    },
    "ItemMeta": {
      "additionalProperties": true,
      "description": "Provenance of a library item (doc 07 §2.1, §2.5). The item's semantic version is the copy metadata\n`version` of the [`LibCopy`] and is stored once, there.",
      "properties": {
        "as_of": {
          "anyOf": [
            {
              "$ref": "#/$defs/Date"
            },
            {
              "type": "null"
            }
          ],
          "description": "Date of the data."
        },
        "confidence": {
          "additionalProperties": {
            "$ref": "#/$defs/Confidence"
          },
          "description": "Confidence per section, keyed by section name.",
          "type": "object"
        },
        "foreign_terms": {
          "description": "Imported content under foreign terms.",
          "type": "boolean"
        },
        "key": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ident"
            },
            {
              "type": "null"
            }
          ],
          "description": "Human key (`pxc.2904602`, `ew.iec.mcb-1pn`)."
        },
        "licence": {
          "description": "SPDX licence expression of the item.",
          "type": [
            "string",
            "null"
          ]
        },
        "sources": {
          "description": "Where the data came from: datasheet references, file hashes, manual entry.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/ItemStatus",
          "description": "Item status; default released."
        }
      },
      "type": "object"
    },
    "ItemStatus": {
      "description": "Status of a library item.",
      "oneOf": [
        {
          "const": "draft",
          "description": "Draft.",
          "type": "string"
        },
        {
          "const": "released",
          "description": "Released (the default).",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "Deprecated, with an optional successor: `{\"deprecated\": {\"successor\": …}}`.",
          "properties": {
            "deprecated": {
              "$ref": "#/$defs/Deprecation"
            }
          },
          "required": [
            "deprecated"
          ],
          "type": "object"
        },
        {
          "const": "withdrawn",
          "description": "Withdrawn.",
          "type": "string"
        }
      ]
    },
    "LibRef": {
      "additionalProperties": true,
      "description": "A reference between library items (doc 07 §2.1): library, item and a semantic-version requirement.",
      "properties": {
        "item": {
          "$ref": "#/$defs/Uuid",
          "description": "The item's UUID, stable across versions."
        },
        "library": {
          "$ref": "#/$defs/Uuid",
          "description": "The library's UUID."
        },
        "version_req": {
          "description": "A semantic-version requirement such as `\"^1\"`.",
          "type": "string"
        }
      },
      "required": [
        "library",
        "item",
        "version_req"
      ],
      "type": "object"
    },
    "MapSpec": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "items": {
            "maximum": 4294967295,
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        }
      ],
      "description": "A part-data map (doc 10 §2.6): an expression \"<k>n[+<c>]\" or \"<k>p[+<c>]\", or an explicit list."
    },
    "MlText": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "additionalProperties": {
            "minLength": 1,
            "type": "string"
          },
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^(?:[a-z]{2,3}(?:-[a-z]{3}){0,3}|[a-z]{4,8})(?:-[A-Z][a-z]{3})?(?:-(?:[A-Z]{2}|[0-9]{3}))?(?:-(?:[a-z0-9]{5,8}|[0-9][a-z0-9]{3}))*(?:-[a-wy-z0-9](?:-[a-z0-9]{2,8})+)*(?:-x(?:-[a-z0-9]{1,8})+)?$",
            "type": "string"
          },
          "type": "object"
        }
      ],
      "description": "Multilingual text: a neutral string, or an object keyed by canonical BCP 47 tags with non-empty string values (doc 05 §3.2). JSON Schema cannot express that all text is NFC or that the keys are in ascending byte order; the reader rejects both."
    },
    "OrderUnit": {
      "description": "Order unit of a part (FR-PRT-026).",
      "oneOf": [
        {
          "const": "piece",
          "description": "Piece (the default).",
          "type": "string"
        },
        {
          "const": "m",
          "description": "Metre, written `m` like the unit of a `Quantity` (doc 05 §3.2).",
          "type": "string"
        },
        {
          "const": "set",
          "description": "Set.",
          "type": "string"
        }
      ]
    },
    "PartKind": {
      "description": "Part kinds (doc 07 §2.5).",
      "oneOf": [
        {
          "const": "device",
          "description": "A device (the default).",
          "type": "string"
        },
        {
          "const": "terminal",
          "description": "Terminal.",
          "type": "string"
        },
        {
          "const": "cable",
          "description": "Cable.",
          "type": "string"
        },
        {
          "const": "wire",
          "description": "Wire.",
          "type": "string"
        },
        {
          "const": "ferrule",
          "description": "Ferrule.",
          "type": "string"
        },
        {
          "const": "marker",
          "description": "Marker.",
          "type": "string"
        },
        {
          "const": "duct",
          "description": "Duct.",
          "type": "string"
        },
        {
          "const": "rail",
          "description": "Rail.",
          "type": "string"
        },
        {
          "const": "busbar",
          "description": "Busbar.",
          "type": "string"
        },
        {
          "const": "end_bracket",
          "description": "End bracket.",
          "type": "string"
        },
        {
          "const": "enclosure",
          "description": "Enclosure.",
          "type": "string"
        },
        {
          "const": "mounting_plate",
          "description": "Mounting plate.",
          "type": "string"
        },
        {
          "const": "tube",
          "description": "Tube.",
          "type": "string"
        },
        {
          "const": "accessory",
          "description": "Accessory.",
          "type": "string"
        },
        {
          "const": "configured",
          "description": "Configured product.",
          "type": "string"
        }
      ]
    },
    "PartSections": {
      "additionalProperties": true,
      "description": "Domain sections of a part (FR-PRT-010). Typed: the cable cores and the PLC section.",
      "properties": {
        "cable_cores": {
          "description": "Cores of a cable part, from which conductors are generated (FR-CBL-004).",
          "items": {
            "$ref": "#/$defs/CableCore"
          },
          "type": "array"
        },
        "plc": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlcSection"
            },
            {
              "type": "null"
            }
          ],
          "description": "The PLC section (doc 10 §2.6)."
        }
      },
      "type": "object"
    },
    "PlcRole": {
      "description": "The PLC role of a part.",
      "oneOf": [
        {
          "const": "station",
          "description": "A station (CPU, head, bus node).",
          "type": "string"
        },
        {
          "const": "module",
          "description": "An I/O module.",
          "type": "string"
        }
      ]
    },
    "PlcSection": {
      "additionalProperties": true,
      "description": "The PLC section of a part (doc 10 §2.6, level L2 part data). The supply groups, earth, bus ports and the\n`meta` confidence are additive and stay in `extra` until their work packages.",
      "properties": {
        "bit_of": {
          "anyOf": [
            {
              "$ref": "#/$defs/MapSpec"
            },
            {
              "type": "null"
            }
          ],
          "description": "The channel map: channel number → bit offset in the module's range (doc 10 §2.6, \"n\", \"16n\" or a\nlist); absent: linear."
        },
        "channels": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChannelSpec"
            },
            {
              "type": "null"
            }
          ],
          "description": "The channels a module instantiates."
        },
        "io": {
          "description": "The I/O ranges the part occupies.",
          "items": {
            "$ref": "#/$defs/IoRange"
          },
          "type": "array"
        },
        "pin_of": {
          "anyOf": [
            {
              "$ref": "#/$defs/MapSpec"
            },
            {
              "type": "null"
            }
          ],
          "description": "The channel → pin map of a module with physical pins (doc 10 §3.3, normaliser N3): channel number →\nthe CP index (`idx`) on the module device's main function (\"n\", \"n+1\" or a list); absent: the\nchannels have no pins (internal channels, such as the solenoid outputs of a valve-terminal module)."
        },
        "positions": {
          "anyOf": [
            {
              "$ref": "#/$defs/PositionMap"
            },
            {
              "type": "null"
            }
          ],
          "description": "The solenoid-position map of a valve-terminal module (doc 10 §2.6 `[plc.positions]`, §3.2 step 4,\n§3.3 normaliser N2); absent: the module serves no valve positions."
        },
        "role": {
          "$ref": "#/$defs/PlcRole",
          "description": "What the part is in the PLC model."
        },
        "unbound": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChannelState"
            },
            {
              "type": "null"
            }
          ],
          "description": "The state of channels neither bound nor claimed (doc 10 §3.2); absent: spare."
        }
      },
      "required": [
        "role"
      ],
      "type": "object"
    },
    "PositionMap": {
      "additionalProperties": true,
      "description": "The solenoid-position map of a valve-terminal module part (doc 10 §2.6 `[plc.positions]`): the channel\nthat each solenoid of the valve at position index `p` drives. The position index is 0-based: the valve\nchild at `Device.position` = q sits at p = q − 1 (doc 11 §3.2). Part 533361 of Golden A carries the test\ninput H1, `count = 4`, solenoid 14 → `2p`, solenoid 12 → `2p+1` (doc 20 §11.2).",
      "properties": {
        "count": {
          "description": "The number of valve positions (p = 0 … count − 1).",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "map": {
          "description": "One entry per solenoid name, in part-data order.",
          "items": {
            "$ref": "#/$defs/SolenoidChannel"
          },
          "type": "array"
        }
      },
      "required": [
        "count"
      ],
      "type": "object"
    },
    "PotentialType": {
      "description": "Potential types (doc 03 §9.1, FR-CON-010).",
      "oneOf": [
        {
          "const": "l1",
          "description": "Phase L1.",
          "type": "string"
        },
        {
          "const": "l2",
          "description": "Phase L2.",
          "type": "string"
        },
        {
          "const": "l3",
          "description": "Phase L3.",
          "type": "string"
        },
        {
          "const": "l",
          "description": "Single-phase line.",
          "type": "string"
        },
        {
          "const": "n",
          "description": "Neutral.",
          "type": "string"
        },
        {
          "const": "pe",
          "description": "Protective earth.",
          "type": "string"
        },
        {
          "const": "pen",
          "description": "Combined PE and N.",
          "type": "string"
        },
        {
          "const": "fe",
          "description": "Functional earth.",
          "type": "string"
        },
        {
          "const": "l_plus",
          "description": "DC positive.",
          "type": "string"
        },
        {
          "const": "l_minus",
          "description": "DC negative.",
          "type": "string"
        },
        {
          "const": "m",
          "description": "DC mid or 0 V.",
          "type": "string"
        },
        {
          "const": "signal",
          "description": "Signal.",
          "type": "string"
        },
        {
          "const": "undefined",
          "description": "Undefined.",
          "type": "string"
        }
      ]
    },
    "Quantity": {
      "additionalProperties": true,
      "description": "A decimal value with its unit (doc 03 §3.2): `{\"value\": Dec3, \"unit\": Unit}`. Rendering (\"0.75 mm²\",\ndecimal comma in nl and de) is a query, never stored text (D-18).\n\n```\nuse ew_schema::{Quantity, Unit};\n\nlet q: Quantity = serde_json::from_str(r#\"{\"value\":\"20\",\"unit\":\"A\"}\"#).unwrap();\nassert_eq!(q.unit, Unit::A);\nassert_eq!(serde_json::to_string(&q).unwrap(), r#\"{\"value\":\"20\",\"unit\":\"A\"}\"#);\n```",
      "properties": {
        "unit": {
          "$ref": "#/$defs/Unit",
          "description": "Its unit."
        },
        "value": {
          "$ref": "#/$defs/Dec3",
          "description": "The number."
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "type": "object"
    },
    "Sha256": {
      "description": "A SHA-256 digest sha256:<64 lower-case hex> (doc 05 §3.2).",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "Side": {
      "description": "A terminal side (doc 08 §2.1: side 1 is internal and side 2 external unless `Strip.field_side` says\notherwise).",
      "oneOf": [
        {
          "const": "side1",
          "description": "Side 1.",
          "type": "string"
        },
        {
          "const": "side2",
          "description": "Side 2.",
          "type": "string"
        }
      ]
    },
    "SolenoidChannel": {
      "additionalProperties": true,
      "description": "One entry of a [`PositionMap`]: the channel of one solenoid as a function of the position index.",
      "properties": {
        "channel": {
          "$ref": "#/$defs/MapSpec",
          "description": "The channel number at position index p: a `p` expression (\"2p\", \"2p+1\") or a list indexed by p."
        },
        "solenoid": {
          "$ref": "#/$defs/Ident",
          "description": "The solenoid (\"14\", \"12\"), matched against the designation of the valve's coil CP."
        }
      },
      "required": [
        "solenoid",
        "channel"
      ],
      "type": "object"
    },
    "TechVal": {
      "anyOf": [
        {
          "$ref": "#/$defs/Quantity",
          "description": "A quantity such as 20 A."
        },
        {
          "$ref": "#/$defs/Ident",
          "description": "An identifier such as the tripping curve `C`."
        }
      ],
      "description": "The value of a [`TechValue`], told apart by JSON type: an object is a [`Quantity`], a string an\n[`Ident`]. Any other JSON type is kept as [`TechVal::Unknown`]; an object that is not a quantity or a\nstring that is not an identifier is a malformed variant (`quantity`, `ident`)."
    },
    "TechValue": {
      "additionalProperties": true,
      "description": "One technical value (doc 05 §3.2 `TechValue`): `{\"key\", \"value\"}` whose value is a [`Quantity`] or an\n[`Ident`], told apart by JSON type.",
      "properties": {
        "key": {
          "$ref": "#/$defs/Ident",
          "description": "The property key, such as `i_out` or `curve`."
        },
        "value": {
          "$ref": "#/$defs/TechVal",
          "description": "The value."
        }
      },
      "required": [
        "key",
        "value"
      ],
      "type": "object"
    },
    "TemplateFn": {
      "additionalProperties": true,
      "description": "One function of a part's template (FR-PRT-007).",
      "properties": {
        "cps": {
          "description": "Indices into `cp_pattern`.",
          "items": {
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "fndef": {
          "$ref": "#/$defs/LibRef",
          "description": "The function definition."
        },
        "main": {
          "description": "The main function of the part.",
          "type": "boolean"
        }
      },
      "required": [
        "fndef"
      ],
      "type": "object"
    },
    "Unit": {
      "description": "The units of doc 03 §3.2 and the order units of FR-PRT-026. Persisted as the unit symbol in ASCII\n(`\"mm2\"`, `\"degC\"`), so files stay greppable; rendering uses the typographic symbol.",
      "oneOf": [
        {
          "const": "mm2",
          "description": "Square millimetre (cross-sections).",
          "type": "string"
        },
        {
          "const": "A",
          "description": "Ampere.",
          "type": "string"
        },
        {
          "const": "V",
          "description": "Volt.",
          "type": "string"
        },
        {
          "const": "Hz",
          "description": "Hertz.",
          "type": "string"
        },
        {
          "const": "bar",
          "description": "Bar (pressure).",
          "type": "string"
        },
        {
          "const": "degC",
          "description": "Degree Celsius.",
          "type": "string"
        },
        {
          "const": "kg",
          "description": "Kilogram.",
          "type": "string"
        },
        {
          "const": "W",
          "description": "Watt.",
          "type": "string"
        },
        {
          "const": "m",
          "description": "Metre (lengths and the order unit of cables).",
          "type": "string"
        },
        {
          "const": "piece",
          "description": "Piece (the default order unit).",
          "type": "string"
        },
        {
          "const": "set",
          "description": "Set (order unit).",
          "type": "string"
        }
      ]
    },
    "Uuid": {
      "description": "A lower-case hyphenated UUID (doc 05 §3.2).",
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "An embedded library copy (doc 07 §2.1, doc 05 §13.2): `$k`, `id` (the copy ID\n`v5(NS_LIBCOPY, library ‖ item)`), `$v`, the copy metadata, then the item's own members.\n\n`sha256` is taken over the canonical compact JSON of the item's own members, without `id` and the copy\nmetadata, so the copy's hash equals the published item's (EW-CORE-014).\n\nDeserialisation reads the copy metadata itself and hands the remaining members to the item's own\ndeserialiser, so errors inside the item keep their paths (a flattened field would lose them).",
  "properties": {
    "$k": {
      "const": "part",
      "description": "The kind name; always the first member."
    },
    "$v": {
      "description": "Per-kind schema version `$v`, omitted when 1.",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "category": {
      "description": "Function category for compatibility filters.",
      "maxItems": 3,
      "minItems": 3,
      "prefixItems": [
        {
          "$ref": "#/$defs/Ident"
        },
        {
          "$ref": "#/$defs/Ident"
        },
        {
          "$ref": "#/$defs/Ident"
        }
      ],
      "type": [
        "array",
        "null"
      ]
    },
    "cp_pattern": {
      "description": "CP pattern, keyed by `idx` (FR-PRT-008).",
      "items": {
        "$ref": "#/$defs/CpData"
      },
      "type": "array"
    },
    "description": {
      "$ref": "#/$defs/MlText",
      "description": "A noun phrase, never ratings (D-35)."
    },
    "free_props": {
      "description": "Free properties, keyed by `key`.",
      "items": {
        "$ref": "#/$defs/FreeProp"
      },
      "type": "array"
    },
    "function_template": {
      "description": "Function template (FR-PRT-007).",
      "items": {
        "$ref": "#/$defs/TemplateFn"
      },
      "type": "array"
    },
    "gtin": {
      "anyOf": [
        {
          "$ref": "#/$defs/Ident"
        },
        {
          "type": "null"
        }
      ],
      "description": "GTIN."
    },
    "id": {
      "$ref": "#/$defs/Uuid",
      "description": "The copy ID."
    },
    "item_id": {
      "$ref": "#/$defs/Uuid",
      "description": "The item's UUID, stable across versions."
    },
    "kind": {
      "$ref": "#/$defs/PartKind",
      "description": "Part kind; default device."
    },
    "library_id": {
      "$ref": "#/$defs/Uuid",
      "description": "The library's UUID (the project ID for project-local items)."
    },
    "manufacturer": {
      "$ref": "#/$defs/LibRef",
      "description": "The manufacturer record."
    },
    "meta": {
      "$ref": "#/$defs/ItemMeta",
      "description": "Provenance."
    },
    "order_number": {
      "anyOf": [
        {
          "$ref": "#/$defs/Ident"
        },
        {
          "type": "null"
        }
      ],
      "description": "Order number."
    },
    "part_number": {
      "$ref": "#/$defs/Ident",
      "description": "Part number, verbatim."
    },
    "sections": {
      "$ref": "#/$defs/PartSections",
      "description": "Domain sections."
    },
    "sha256": {
      "$ref": "#/$defs/Sha256",
      "description": "Hash of the item's own members."
    },
    "tech_data": {
      "description": "Technical data, keyed by `key`.",
      "items": {
        "$ref": "#/$defs/TechValue"
      },
      "type": "array"
    },
    "type_designation": {
      "anyOf": [
        {
          "$ref": "#/$defs/Ident"
        },
        {
          "type": "null"
        }
      ],
      "description": "Type designation (\"PT 2.5-TWIN\")."
    },
    "unit": {
      "$ref": "#/$defs/OrderUnit",
      "description": "Order unit; default piece."
    },
    "version": {
      "description": "The item's semantic version (`MAJOR.MINOR.PATCH`).",
      "type": "string"
    }
  },
  "required": [
    "$k",
    "id",
    "library_id",
    "item_id",
    "version",
    "sha256",
    "manufacturer",
    "part_number"
  ],
  "title": "part",
  "type": "object"
}
