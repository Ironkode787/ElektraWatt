{
  "$defs": {
    "ExchangeObject": {
      "description": "What an exchanged object is.",
      "oneOf": [
        {
          "const": "station",
          "description": "A station.",
          "type": "string"
        },
        {
          "const": "module",
          "description": "A module.",
          "type": "string"
        },
        {
          "const": "channel",
          "description": "A channel.",
          "type": "string"
        },
        {
          "const": "tag",
          "description": "A tag: the symbol of a channel.",
          "type": "string"
        },
        {
          "const": "node",
          "description": "The node of a bus interface.",
          "type": "string"
        },
        {
          "const": "instrument",
          "description": "A row of an instrument list (doc 10 §4.7, FR-PLC-050).",
          "type": "string"
        }
      ]
    },
    "Uuid": {
      "description": "A lower-case hyphenated UUID (doc 05 §3.2).",
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "The ID an exchange file gave an object of the project (doc 10 §4.2, rank 71): the first key an import matches\nby (FR-PLC-032). Its ID is `v5(config_project, \"foreign\", object, target)`.",
  "properties": {
    "$k": {
      "const": "foreign_id",
      "description": "The kind name; always the first member."
    },
    "$v": {
      "description": "Per-kind schema version `$v`, omitted when 1.",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "config_project": {
      "$ref": "#/$defs/Uuid",
      "description": "The configuration project, whose file holds the record."
    },
    "foreign": {
      "description": "The ID in the exchange file.",
      "type": "string"
    },
    "id": {
      "$ref": "#/$defs/Uuid",
      "description": "The record ID."
    },
    "object": {
      "$ref": "#/$defs/ExchangeObject",
      "description": "What the object is."
    },
    "target": {
      "$ref": "#/$defs/Uuid",
      "description": "The project's record the object is (as [`ExchangeRecord::target`])."
    }
  },
  "required": [
    "$k",
    "id",
    "config_project",
    "object",
    "target",
    "foreign"
  ],
  "title": "foreign_id",
  "type": "object"
}
