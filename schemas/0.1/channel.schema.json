{
  "$defs": {
    "AddrSpec": {
      "description": "An address specification (doc 10 §2.5): derived, deliberate, excluded or open.",
      "oneOf": [
        {
          "const": "auto",
          "description": "Module start plus the address-map offset (the default).",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "A deliberate value; every deviation from the derived value is reported (EW-PLC-012).",
          "properties": {
            "manual": {
              "$ref": "#/$defs/PlcAddress"
            }
          },
          "required": [
            "manual"
          ],
          "type": "object"
        },
        {
          "const": "excluded",
          "description": "Not addressed (\"do not include in addressing\").",
          "type": "string"
        },
        {
          "const": "tbd",
          "description": "A typed open item; prints \"TBD\" and blocks release (EW-PLC-015).",
          "type": "string"
        }
      ]
    },
    "ChannelKind": {
      "description": "The kind of a channel (doc 10 §2.4). `multi_function` (IO-Link port modes, 1.0) is additive.",
      "oneOf": [
        {
          "const": "di",
          "description": "Digital input.",
          "type": "string"
        },
        {
          "const": "do",
          "description": "Digital output.",
          "type": "string"
        },
        {
          "const": "ai",
          "description": "Analogue input.",
          "type": "string"
        },
        {
          "const": "ao",
          "description": "Analogue output.",
          "type": "string"
        },
        {
          "const": "counter",
          "description": "Counter.",
          "type": "string"
        },
        {
          "const": "io_link_port",
          "description": "IO-Link port.",
          "type": "string"
        },
        {
          "const": "power_supply",
          "description": "Power supply.",
          "type": "string"
        }
      ]
    },
    "ChannelState": {
      "description": "An explicit channel state (doc 10 §3.2); `used` is never stored, it is derived from the target.",
      "oneOf": [
        {
          "const": "spare",
          "description": "Spare.",
          "type": "string"
        },
        {
          "const": "reserved",
          "description": "Reserved.",
          "type": "string"
        },
        {
          "const": "deactivated",
          "description": "Deactivated.",
          "type": "string"
        }
      ]
    },
    "Endpoint": {
      "description": "One end of a connection, a definition or a bond (ADR-0007, doc 03 §9): a connection point of a function\nor a junction. Encoding (doc 05 §3.2): `{\"cp\": [function, idx]}` or `{\"junction\": id}`.\n\n```\nuse ew_schema::Endpoint;\n\nlet e: Endpoint = serde_json::from_str(r#\"{\"cp\":[\"d40b6e93-25f7-5c1a-9e8d-7a3f1c05b6e2\",0]}\"#).unwrap();\nassert!(matches!(e, Endpoint::Cp(_, 0)));\n```",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Connection point `idx` of a function; its ID `v5(function, idx)` is derived, never stored.",
          "properties": {
            "cp": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "$ref": "#/$defs/Uuid"
                },
                {
                  "format": "uint16",
                  "maximum": 65535,
                  "minimum": 0,
                  "type": "integer"
                }
              ],
              "type": "array"
            }
          },
          "required": [
            "cp"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A junction.",
          "properties": {
            "junction": {
              "$ref": "#/$defs/Uuid"
            }
          },
          "required": [
            "junction"
          ],
          "type": "object"
        }
      ]
    },
    "Ident": {
      "description": "An identifier: non-empty, one line (no control character U+0000 to U+001F or U+007F to U+009F), without leading or trailing white space (the Unicode White_Space set); interior spaces are allowed (doc 05 §3.2). JSON Schema cannot express Unicode Normalization Form C; the reader rejects non-NFC text.",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000](?:[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000])?$",
      "type": "string"
    },
    "MlText": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "additionalProperties": {
            "minLength": 1,
            "type": "string"
          },
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^(?:[a-z]{2,3}(?:-[a-z]{3}){0,3}|[a-z]{4,8})(?:-[A-Z][a-z]{3})?(?:-(?:[A-Z]{2}|[0-9]{3}))?(?:-(?:[a-z0-9]{5,8}|[0-9][a-z0-9]{3}))*(?:-[a-wy-z0-9](?:-[a-z0-9]{2,8})+)*(?:-x(?:-[a-z0-9]{1,8})+)?$",
            "type": "string"
          },
          "type": "object"
        }
      ],
      "description": "Multilingual text: a neutral string, or an object keyed by canonical BCP 47 tags with non-empty string values (doc 05 §3.2). JSON Schema cannot express that all text is NFC or that the keys are in ascending byte order; the reader rejects both."
    },
    "PlcAddress": {
      "additionalProperties": true,
      "description": "A canonical PLC address (doc 10 §2.5), rendered by the configuration project's profile.",
      "properties": {
        "area": {
          "$ref": "#/$defs/PlcArea",
          "description": "The area."
        },
        "bit": {
          "description": "The bit, for a bit address.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "byte": {
          "description": "The byte.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "size": {
          "$ref": "#/$defs/PlcSize",
          "description": "The access size; default a bit."
        }
      },
      "required": [
        "area",
        "byte"
      ],
      "type": "object"
    },
    "PlcArea": {
      "description": "The area of a PLC address.",
      "oneOf": [
        {
          "const": "i",
          "description": "Inputs.",
          "type": "string"
        },
        {
          "const": "q",
          "description": "Outputs.",
          "type": "string"
        },
        {
          "const": "m",
          "description": "Markers.",
          "type": "string"
        },
        {
          "const": "pi",
          "description": "Peripheral inputs.",
          "type": "string"
        },
        {
          "const": "pq",
          "description": "Peripheral outputs.",
          "type": "string"
        }
      ]
    },
    "PlcSize": {
      "description": "The access size of a PLC address.",
      "oneOf": [
        {
          "const": "bit",
          "description": "One bit (the default).",
          "type": "string"
        },
        {
          "const": "byte",
          "description": "A byte.",
          "type": "string"
        },
        {
          "const": "word",
          "description": "A word.",
          "type": "string"
        },
        {
          "const": "dword",
          "description": "A double word.",
          "type": "string"
        },
        {
          "const": "lword",
          "description": "A long word.",
          "type": "string"
        }
      ]
    },
    "SourceRef": {
      "additionalProperties": true,
      "description": "The import provenance of a record (doc 14 §2.3, ADR-0004 amendment 1): the lineage and the source key\nfrom which the record's ID `v5(lineage namespace, key)` was derived.",
      "properties": {
        "key": {
          "description": "The source key, byte for byte (NFC), such as `qet:el:<uuid>`.",
          "type": "string"
        },
        "lineage": {
          "$ref": "#/$defs/Uuid",
          "description": "The import lineage."
        }
      },
      "required": [
        "lineage",
        "key"
      ],
      "type": "object"
    },
    "Uuid": {
      "description": "A lower-case hyphenated UUID (doc 05 §3.2).",
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "The logical I/O unit (doc 10 §2.4, rank 37, in the shard of its module device). Its ID is\n`v5(module, \"channel\", number)` ([`ew_ids::v5::plc_channel_id`]). Address, state, designation, symbol,\ntarget and texts are derived where the record leaves them open (doc 10 §3.1–§3.5).",
  "properties": {
    "$k": {
      "const": "channel",
      "description": "The kind name; always the first member."
    },
    "$v": {
      "description": "Per-kind schema version `$v`, omitted when 1.",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "address": {
      "$ref": "#/$defs/AddrSpec",
      "description": "The address specification; default `auto`."
    },
    "binding": {
      "anyOf": [
        {
          "$ref": "#/$defs/Endpoint"
        },
        {
          "type": "null"
        }
      ],
      "description": "The signal CP: a module pin, or the served coil's internal CP (no connection row)."
    },
    "comment": {
      "$ref": "#/$defs/MlText",
      "description": "The PLC comment."
    },
    "designation": {
      "anyOf": [
        {
          "$ref": "#/$defs/Ident"
        },
        {
          "type": "null"
        }
      ],
      "description": "Manual designation; absent: the part's pattern over `number`."
    },
    "id": {
      "$ref": "#/$defs/Uuid",
      "description": "The record ID."
    },
    "kind": {
      "$ref": "#/$defs/ChannelKind",
      "description": "The channel kind."
    },
    "module": {
      "$ref": "#/$defs/Uuid",
      "description": "The module device."
    },
    "number": {
      "description": "The 0-based channel number.",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "source_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceRef"
        },
        {
          "type": "null"
        }
      ],
      "description": "Import provenance."
    },
    "state": {
      "anyOf": [
        {
          "$ref": "#/$defs/ChannelState"
        },
        {
          "type": "null"
        }
      ],
      "description": "An explicit state; absent: derived (doc 10 §3.2)."
    },
    "symbol": {
      "anyOf": [
        {
          "$ref": "#/$defs/Ident"
        },
        {
          "type": "null"
        }
      ],
      "description": "Manual symbol; absent: none before the symbol templates (1.0)."
    },
    "target": {
      "anyOf": [
        {
          "$ref": "#/$defs/Uuid"
        },
        {
          "type": "null"
        }
      ],
      "description": "A manual target override (FR-PLC-054)."
    }
  },
  "required": [
    "$k",
    "id",
    "module",
    "number",
    "kind"
  ],
  "title": "channel",
  "type": "object"
}
