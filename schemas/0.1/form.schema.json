  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "An embedded library copy (doc 07 §2.1, doc 05 §13.2): `$k`, `id` (the copy ID\n`v5(NS_LIBCOPY, library ‖ item)`), `$v`, the copy metadata, then the item's own members.\n\n`sha256` is taken over the canonical compact JSON of the item's own members, without `id` and the copy\nmetadata, so the copy's hash equals the published item's (EW-CORE-014).\n\nDeserialisation reads the copy metadata itself and hands the remaining members to the item's own\ndeserialiser, so errors inside the item keep their paths (a flattened field would lose them).",
  "properties": {
    "$k": {
      "const": "form",
      "description": "The kind name; always the first member."
    },
    "$v": {
      "description": "Per-kind schema version `$v`, omitted when 1.",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "cells": {
      "description": "Static cells: labels and placeholders.",
      "items": {
        "$ref": "#/$defs/FormCell"
      },
      "type": "array"
    },
    "continuation": {
      "anyOf": [
        {
          "$ref": "#/$defs/Uuid"
        },
        {
          "type": "null"
        }
      ],
      "description": "The next form of report pages (FR-REP-032)."
    },
    "data": {
      "anyOf": [
        {
          "$ref": "#/$defs/DataArea"
        },
        {
          "type": "null"
        }
      ],
      "description": "The data area of report forms."
    },
    "graphics": {
      "description": "Rules, boxes, drop shadows, logos.",
      "items": {
        "$ref": "#/$defs/Primitive"
      },
      "type": "array"
    },
    "grid": {
      "anyOf": [
        {
          "$ref": "#/$defs/FrameGrid"
        },
        {
          "type": "null"
        }
      ],
      "description": "Columns, rows and header bands (FR-PAG-014)."
    },
    "id": {
      "$ref": "#/$defs/Uuid",
      "description": "The copy ID."
    },
    "item_id": {
      "$ref": "#/$defs/Uuid",
      "description": "The item's UUID, stable across versions."
    },
    "kind": {
      "$ref": "#/$defs/FormKind",
      "description": "Form kind."
    },
    "library_id": {
      "$ref": "#/$defs/Uuid",
      "description": "The library's UUID (the project ID for project-local items)."
    },
    "meta": {
      "$ref": "#/$defs/ItemMeta",
      "description": "Provenance."
    },
    "page_to_sheet": {
      "anyOf": [
        {
          "$ref": "#/$defs/SheetTransform"
        },
        {
          "type": "null"
        }
      ],
      "description": "Uniform integer scale and offset, QET-compatible frames only; absent means scale 1."
    },
    "sha256": {
      "$ref": "#/$defs/Sha256",
      "description": "Hash of the item's own members."
    },
    "sheet": {
      "$ref": "#/$defs/SheetSpec",
      "description": "The sheet."
    },
    "title_block": {
      "anyOf": [
        {
          "$ref": "#/$defs/Uuid"
        },
        {
          "type": "null"
        }
      ],
      "description": "The title-block form."
    },
    "version": {
      "description": "The item's semantic version (`MAJOR.MINOR.PATCH`).",
      "type": "string"
    }
  },
  "required": [
    "$k",
    "id",
    "library_id",
    "item_id",
    "version",
    "sha256",
    "kind",
    "sheet"
  ],
  "title": "form",
  "type": "object"
}
