{
  "$defs": {
    "Align": {
      "description": "Text alignment at the anchor point: nine positions.",
      "oneOf": [
        {
          "const": "top_left",
          "description": "Top left.",
          "type": "string"
        },
        {
          "const": "top_centre",
          "description": "Top centre.",
          "type": "string"
        },
        {
          "const": "top_right",
          "description": "Top right.",
          "type": "string"
        },
        {
          "const": "middle_left",
          "description": "Middle left.",
          "type": "string"
        },
        {
          "const": "centre",
          "description": "Centre.",
          "type": "string"
        },
        {
          "const": "middle_right",
          "description": "Middle right.",
          "type": "string"
        },
        {
          "const": "bottom_left",
          "description": "Bottom left.",
          "type": "string"
        },
        {
          "const": "bottom_centre",
          "description": "Bottom centre.",
          "type": "string"
        },
        {
          "const": "bottom_right",
          "description": "Bottom right.",
          "type": "string"
        }
      ]
    },
    "Angle2": {
      "description": "An angle in 10^-3 degree, counter-clockwise on the sheet, within the i32 range (doc 05 §3.2).",
      "maximum": 2147483647,
      "minimum": -2147483648,
      "type": "integer"
    },
    "ArcPrim": {
      "additionalProperties": true,
      "description": "An elliptic arc (QET's arc: bounding rectangle, start angle and sweep, counter-clockwise).",
      "properties": {
        "rect": {
          "$ref": "#/$defs/Rect",
          "description": "The bounding rectangle of the full ellipse."
        },
        "start": {
          "$ref": "#/$defs/Angle2",
          "description": "Start angle."
        },
        "stroke": {
          "anyOf": [
            {
              "$ref": "#/$defs/Stroke"
            },
            {
              "type": "null"
            }
          ],
          "description": "Stroke."
        },
        "sweep": {
          "$ref": "#/$defs/Angle2",
          "description": "Sweep angle."
        }
      },
      "required": [
        "rect",
        "sweep"
      ],
      "type": "object"
    },
    "CirclePrim": {
      "additionalProperties": true,
      "description": "A circle.",
      "properties": {
        "centre": {
          "$ref": "#/$defs/Pt2",
          "description": "Centre."
        },
        "fill": {
          "anyOf": [
            {
              "$ref": "#/$defs/Colour"
            },
            {
              "type": "null"
            }
          ],
          "description": "Fill."
        },
        "r": {
          "$ref": "#/$defs/Nm",
          "description": "Radius."
        },
        "stroke": {
          "anyOf": [
            {
              "$ref": "#/$defs/Stroke"
            },
            {
              "type": "null"
            }
          ],
          "description": "Stroke."
        }
      },
      "required": [
        "centre",
        "r"
      ],
      "type": "object"
    },
    "Colour": {
      "description": "A drawing colour: the layer's colour (the default) or an explicit sRGB value.",
      "oneOf": [
        {
          "const": "by_layer",
          "description": "The layer's colour (the default).",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "An explicit colour.",
          "properties": {
            "rgb": {
              "$ref": "#/$defs/Rgb"
            }
          },
          "required": [
            "rgb"
          ],
          "type": "object"
        }
      ]
    },
    "Confidence": {
      "description": "Confidence of one section of library data.",
      "oneOf": [
        {
          "const": "verified",
          "description": "Checked against a source.",
          "type": "string"
        },
        {
          "const": "unverified",
          "description": "Not yet checked.",
          "type": "string"
        },
        {
          "const": "test",
          "description": "Test data.",
          "type": "string"
        }
      ]
    },
    "Dash": {
      "description": "A dash pattern scaled by the pen width (doc 07 §2.3).",
      "oneOf": [
        {
          "const": "solid",
          "description": "Solid (the default).",
          "type": "string"
        },
        {
          "const": "dash42",
          "description": "Dash 4, gap 2 (× pen width).",
          "type": "string"
        },
        {
          "const": "dot12",
          "description": "Dot 1, gap 2.",
          "type": "string"
        },
        {
          "const": "dash_dot",
          "description": "Dash-dot.",
          "type": "string"
        }
      ]
    },
    "DataArea": {
      "additionalProperties": true,
      "description": "The data area of a report form.",
      "properties": {
        "grid": {
          "$ref": "#/$defs/TableStyle",
          "description": "Table lines and fills."
        },
        "header": {
          "$ref": "#/$defs/RowTemplate",
          "description": "The header row."
        },
        "rect": {
          "$ref": "#/$defs/Rect",
          "description": "The area."
        },
        "rows": {
          "$ref": "#/$defs/RowTemplates",
          "description": "Row templates per row kind."
        }
      },
      "required": [
        "rect",
        "header"
      ],
      "type": "object"
    },
    "Date": {
      "description": "An authored date YYYY-MM-DD (doc 05 §3.2).",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "type": "string"
    },
    "Deprecation": {
      "additionalProperties": true,
      "description": "The payload of [`ItemStatus::Deprecated`].",
      "properties": {
        "successor": {
          "anyOf": [
            {
              "$ref": "#/$defs/LibRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "The successor."
        }
      },
      "type": "object"
    },
    "EllipsePrim": {
      "additionalProperties": true,
      "description": "An ellipse.",
      "properties": {
        "fill": {
          "anyOf": [
            {
              "$ref": "#/$defs/Colour"
            },
            {
              "type": "null"
            }
          ],
          "description": "Fill."
        },
        "rect": {
          "$ref": "#/$defs/Rect",
          "description": "The bounding rectangle."
        },
        "stroke": {
          "anyOf": [
            {
              "$ref": "#/$defs/Stroke"
            },
            {
              "type": "null"
            }
          ],
          "description": "Stroke."
        }
      },
      "required": [
        "rect"
      ],
      "type": "object"
    },
    "FormCell": {
      "additionalProperties": true,
      "description": "One form cell: a label and a placeholder bound to project, page, party or derived values.",
      "properties": {
        "align": {
          "$ref": "#/$defs/Align",
          "description": "Alignment."
        },
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/MlText"
            },
            {
              "type": "null"
            }
          ],
          "description": "Static label text."
        },
        "overflow": {
          "$ref": "#/$defs/Overflow",
          "description": "What happens when the text does not fit; never silent clipping (FR-REP-039)."
        },
        "rect": {
          "$ref": "#/$defs/Rect",
          "description": "The cell area."
        },
        "style": {
          "$ref": "#/$defs/Ident",
          "description": "Text style key."
        },
        "value": {
          "description": "The placeholder, such as `\"{page.title}\"` (doc 09 §2.6).",
          "type": [
            "string",
            "null"
          ]
        },
        "visible_if": {
          "description": "Visibility condition, a pure expression.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "rect",
        "style",
        "align",
        "overflow"
      ],
      "type": "object"
    },
    "FormKind": {
      "description": "Form kinds.",
      "oneOf": [
        {
          "const": "frame",
          "description": "Page frame.",
          "type": "string"
        },
        {
          "const": "title_block",
          "description": "Title block.",
          "type": "string"
        },
        {
          "const": "cover",
          "description": "Cover.",
          "type": "string"
        },
        {
          "const": "divider",
          "description": "Section divider.",
          "type": "string"
        },
        {
          "const": "report",
          "description": "Report page.",
          "type": "string"
        },
        {
          "const": "label",
          "description": "Label.",
          "type": "string"
        }
      ]
    },
    "FrameColumns": {
      "additionalProperties": true,
      "description": "The columns of a frame grid.",
      "properties": {
        "count": {
          "description": "Number of columns.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "labels": {
          "description": "Explicit labels; empty means numbers from `start_index`.",
          "items": {
            "$ref": "#/$defs/Ident"
          },
          "type": "array"
        },
        "start_index": {
          "description": "Number of the first column (0 on the QET-compatible frame).",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "width": {
          "$ref": "#/$defs/Grid",
          "description": "Column width as a rational step."
        }
      },
      "required": [
        "count",
        "width"
      ],
      "type": "object"
    },
    "FrameGrid": {
      "additionalProperties": true,
      "description": "The column and row grid of a frame (doc 03 §6).",
      "properties": {
        "columns": {
          "$ref": "#/$defs/FrameColumns",
          "description": "Columns."
        },
        "header_band": {
          "anyOf": [
            {
              "$ref": "#/$defs/Grid"
            },
            {
              "type": "null"
            }
          ],
          "description": "Thickness of the header bands along the top and left edges, where the labels print."
        },
        "rows": {
          "$ref": "#/$defs/FrameRows",
          "description": "Rows."
        }
      },
      "required": [
        "columns",
        "rows"
      ],
      "type": "object"
    },
    "FrameRows": {
      "additionalProperties": true,
      "description": "The rows of a frame grid.",
      "properties": {
        "count": {
          "description": "Number of rows.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "height": {
          "$ref": "#/$defs/Grid",
          "description": "Row height as a rational step."
        },
        "labels": {
          "description": "Explicit labels; empty means letters from A.",
          "items": {
            "$ref": "#/$defs/Ident"
          },
          "type": "array"
        },
        "skip_io": {
          "description": "Skip the letters I and O.",
          "type": "boolean"
        }
      },
      "required": [
        "count",
        "height"
      ],
      "type": "object"
    },
    "Grid": {
      "additionalProperties": false,
      "description": "A rational grid step num/den in nanometres (doc 05 §3.2). JSON Schema cannot express that num/den is reduced or at least 1 nm (num >= den): the reader rejects unreduced and sub-nanometre steps.",
      "properties": {
        "den": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        "num": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "num",
        "den"
      ],
      "type": "object"
    },
    "Ident": {
      "description": "An identifier: non-empty, one line (no control character U+0000 to U+001F or U+007F to U+009F), without leading or trailing white space (the Unicode White_Space set); interior spaces are allowed (doc 05 §3.2). JSON Schema cannot express Unicode Normalization Form C; the reader rejects non-NFC text.",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000](?:[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000])?$",
      "type": "string"
    },
    "ImagePrim": {
      "additionalProperties": true,
      "description": "An image asset placed in a rectangle.",
      "properties": {
        "asset": {
          "$ref": "#/$defs/Sha256",
          "description": "The asset `assets/<sha256>.<ext>`."
        },
        "rect": {
          "$ref": "#/$defs/Rect",
          "description": "The placement."
        }
      },
      "required": [
        "rect",
        "asset"
      ],
      "type": "object"
    },
    "ItemMeta": {
      "additionalProperties": true,
      "description": "Provenance of a library item (doc 07 §2.1, §2.5). The item's semantic version is the copy metadata\n`version` of the [`LibCopy`] and is stored once, there.",
      "properties": {
        "as_of": {
          "anyOf": [
            {
              "$ref": "#/$defs/Date"
            },
            {
              "type": "null"
            }
          ],
          "description": "Date of the data."
        },
        "confidence": {
          "additionalProperties": {
            "$ref": "#/$defs/Confidence"
          },
          "description": "Confidence per section, keyed by section name.",
          "type": "object"
        },
        "foreign_terms": {
          "description": "Imported content under foreign terms.",
          "type": "boolean"
        },
        "key": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ident"
            },
            {
              "type": "null"
            }
          ],
          "description": "Human key (`pxc.2904602`, `ew.iec.mcb-1pn`)."
        },
        "licence": {
          "description": "SPDX licence expression of the item.",
          "type": [
            "string",
            "null"
          ]
        },
        "sources": {
          "description": "Where the data came from: datasheet references, file hashes, manual entry.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/ItemStatus",
          "description": "Item status; default released."
        }
      },
      "type": "object"
    },
    "ItemStatus": {
      "description": "Status of a library item.",
      "oneOf": [
        {
          "const": "draft",
          "description": "Draft.",
          "type": "string"
        },
        {
          "const": "released",
          "description": "Released (the default).",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "Deprecated, with an optional successor: `{\"deprecated\": {\"successor\": …}}`.",
          "properties": {
            "deprecated": {
              "$ref": "#/$defs/Deprecation"
            }
          },
          "required": [
            "deprecated"
          ],
          "type": "object"
        },
        {
          "const": "withdrawn",
          "description": "Withdrawn.",
          "type": "string"
        }
      ]
    },
    "LibRef": {
      "additionalProperties": true,
      "description": "A reference between library items (doc 07 §2.1): library, item and a semantic-version requirement.",
      "properties": {
        "item": {
          "$ref": "#/$defs/Uuid",
          "description": "The item's UUID, stable across versions."
        },
        "library": {
          "$ref": "#/$defs/Uuid",
          "description": "The library's UUID."
        },
        "version_req": {
          "description": "A semantic-version requirement such as `\"^1\"`.",
          "type": "string"
        }
      },
      "required": [
        "library",
        "item",
        "version_req"
      ],
      "type": "object"
    },
    "LinePrim": {
      "additionalProperties": true,
      "description": "A straight line.",
      "properties": {
        "from": {
          "$ref": "#/$defs/Pt2",
          "description": "Start."
        },
        "stroke": {
          "anyOf": [
            {
              "$ref": "#/$defs/Stroke"
            },
            {
              "type": "null"
            }
          ],
          "description": "Stroke; absent means not stroked."
        },
        "to": {
          "$ref": "#/$defs/Pt2",
          "description": "End."
        }
      },
      "required": [
        "from",
        "to"
      ],
      "type": "object"
    },
    "MlText": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "additionalProperties": {
            "minLength": 1,
            "type": "string"
          },
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^(?:[a-z]{2,3}(?:-[a-z]{3}){0,3}|[a-z]{4,8})(?:-[A-Z][a-z]{3})?(?:-(?:[A-Z]{2}|[0-9]{3}))?(?:-(?:[a-z0-9]{5,8}|[0-9][a-z0-9]{3}))*(?:-[a-wy-z0-9](?:-[a-z0-9]{2,8})+)*(?:-x(?:-[a-z0-9]{1,8})+)?$",
            "type": "string"
          },
          "type": "object"
        }
      ],
      "description": "Multilingual text: a neutral string, or an object keyed by canonical BCP 47 tags with non-empty string values (doc 05 §3.2). JSON Schema cannot express that all text is NFC or that the keys are in ascending byte order; the reader rejects both."
    },
    "Nm": {
      "description": "A length in nanometres (doc 05 §3.2). Written without fraction or exponent; JSON Schema cannot tell 5 from 5.0, the reader rejects the latter.",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
    },
    "Overflow": {
      "description": "Overflow policy of a form cell.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Shrink down to a minimum cap height: `{\"shrink_to_fit\": {\"min_cap_height\": nm}}`.",
          "properties": {
            "shrink_to_fit": {
              "$ref": "#/$defs/ShrinkSpec"
            }
          },
          "required": [
            "shrink_to_fit"
          ],
          "type": "object"
        },
        {
          "const": "ellipsis",
          "description": "Cut with an ellipsis.",
          "type": "string"
        },
        {
          "const": "error",
          "description": "Report an error.",
          "type": "string"
        }
      ]
    },
    "Pen": {
      "description": "A house pen or an explicit width (doc 07 §2.3, FR-SYM-003): `\"p026\"` or `{\"width\": nm}`.",
      "oneOf": [
        {
          "const": "p013",
          "description": "0.13 mm.",
          "type": "string"
        },
        {
          "const": "p018",
          "description": "0.18 mm.",
          "type": "string"
        },
        {
          "const": "p026",
          "description": "0.26 mm.",
          "type": "string"
        },
        {
          "const": "p042",
          "description": "0.42 mm.",
          "type": "string"
        },
        {
          "const": "p052",
          "description": "0.52 mm.",
          "type": "string"
        },
        {
          "const": "p130",
          "description": "1.30 mm.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "An explicit width.",
          "properties": {
            "width": {
              "$ref": "#/$defs/Nm"
            }
          },
          "required": [
            "width"
          ],
          "type": "object"
        }
      ]
    },
    "PolygonPrim": {
      "additionalProperties": true,
      "description": "A polygon.",
      "properties": {
        "closed": {
          "description": "Whether the last point joins the first.",
          "type": "boolean"
        },
        "fill": {
          "anyOf": [
            {
              "$ref": "#/$defs/Colour"
            },
            {
              "type": "null"
            }
          ],
          "description": "Fill."
        },
        "points": {
          "description": "Points in order.",
          "items": {
            "$ref": "#/$defs/Pt2"
          },
          "type": "array"
        },
        "stroke": {
          "anyOf": [
            {
              "$ref": "#/$defs/Stroke"
            },
            {
              "type": "null"
            }
          ],
          "description": "Stroke."
        }
      },
      "required": [
        "points"
      ],
      "type": "object"
    },
    "PolylinePrim": {
      "additionalProperties": true,
      "description": "An open polyline.",
      "properties": {
        "points": {
          "description": "Points in order.",
          "items": {
            "$ref": "#/$defs/Pt2"
          },
          "type": "array"
        },
        "stroke": {
          "anyOf": [
            {
              "$ref": "#/$defs/Stroke"
            },
            {
              "type": "null"
            }
          ],
          "description": "Stroke."
        }
      },
      "required": [
        "points"
      ],
      "type": "object"
    },
    "Primitive": {
      "description": "A graphic primitive in nanometres, relative to its owner's origin (doc 07 §2.3).",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A straight line.",
          "properties": {
            "line": {
              "$ref": "#/$defs/LinePrim"
            }
          },
          "required": [
            "line"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "An open polyline.",
          "properties": {
            "polyline": {
              "$ref": "#/$defs/PolylinePrim"
            }
          },
          "required": [
            "polyline"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A rectangle with optional rounded corners and drop shadow.",
          "properties": {
            "rect": {
              "$ref": "#/$defs/RectPrim"
            }
          },
          "required": [
            "rect"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A circle.",
          "properties": {
            "circle": {
              "$ref": "#/$defs/CirclePrim"
            }
          },
          "required": [
            "circle"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "An ellipse in a bounding rectangle.",
          "properties": {
            "ellipse": {
              "$ref": "#/$defs/EllipsePrim"
            }
          },
          "required": [
            "ellipse"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "An elliptic arc in a bounding rectangle.",
          "properties": {
            "arc": {
              "$ref": "#/$defs/ArcPrim"
            }
          },
          "required": [
            "arc"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A polygon.",
          "properties": {
            "polygon": {
              "$ref": "#/$defs/PolygonPrim"
            }
          },
          "required": [
            "polygon"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A text.",
          "properties": {
            "text": {
              "$ref": "#/$defs/TextPrim"
            }
          },
          "required": [
            "text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "An image asset.",
          "properties": {
            "image": {
              "$ref": "#/$defs/ImagePrim"
            }
          },
          "required": [
            "image"
          ],
          "type": "object"
        }
      ]
    },
    "Pt2": {
      "description": "A point [x, y] in nanometres, y downwards (doc 05 §3.2).",
      "items": false,
