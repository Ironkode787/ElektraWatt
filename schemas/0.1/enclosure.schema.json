            },
            {
              "maximum": 2000000000,
              "minimum": -2000000000,
              "type": "integer"
            },
            {
              "maximum": 2000000000,
              "minimum": -2000000000,
              "type": "integer"
            },
            {
              "maximum": 2000000000,
              "minimum": -2000000000,
              "type": "integer"
            }
          ],
          "type": "array"
        },
        "t": {
          "items": false,
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer"
            },
            {
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer"
            },
            {
              "maximum": 9007199254740991,
