  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "An enclosure (doc 03 §16, rank 51, the layout file of its space): the cabinet body, tagged by its device, which\ncarries the enclosure part (-UC1, NSYPLA1074G), so the part reaches the BOM by the one path (ADR-0006). At the\nMVP a space holds at most one enclosure (WP-S4.01 D3).",
  "properties": {
    "$k": {
      "const": "enclosure",
      "description": "The kind name; always the first member."
    },
    "$v": {
      "description": "Per-kind schema version `$v`, omitted when 1.",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "device": {
      "$ref": "#/$defs/Uuid",
      "description": "The device that carries the enclosure part (delete policy forbid: the device cannot vanish under its\nenclosure)."
    },
    "id": {
      "$ref": "#/$defs/Uuid",
      "description": "The record ID."
    },
    "pose": {
      "$ref": "#/$defs/Pose3",
      "description": "The pose in the space: origin at the bottom-left-rear outside corner, x right, y up, z towards the door."
    },
    "space": {
      "$ref": "#/$defs/Uuid",
      "description": "The layout space (delete policy cascade)."
    }
  },
  "required": [
    "$k",
    "id",
    "space",
    "device",
    "pose"
  ],
  "title": "enclosure",
  "type": "object"
}
