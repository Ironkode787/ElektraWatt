{
  "$defs": {
    "Confidence": {
      "description": "Confidence of one section of library data.",
      "oneOf": [
        {
          "const": "verified",
          "description": "Checked against a source.",
          "type": "string"
        },
        {
          "const": "unverified",
          "description": "Not yet checked.",
          "type": "string"
        },
        {
          "const": "test",
          "description": "Test data.",
          "type": "string"
        }
      ]
    },
    "Date": {
      "description": "An authored date YYYY-MM-DD (doc 05 §3.2).",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "type": "string"
    },
    "Deprecation": {
      "additionalProperties": true,
      "description": "The payload of [`ItemStatus::Deprecated`].",
      "properties": {
        "successor": {
          "anyOf": [
            {
              "$ref": "#/$defs/LibRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "The successor."
        }
      },
      "type": "object"
    },
    "Ident": {
      "description": "An identifier: non-empty, one line (no control character U+0000 to U+001F or U+007F to U+009F), without leading or trailing white space (the Unicode White_Space set); interior spaces are allowed (doc 05 §3.2). JSON Schema cannot express Unicode Normalization Form C; the reader rejects non-NFC text.",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000](?:[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000])?$",
      "type": "string"
    },
    "ItemMeta": {
      "additionalProperties": true,
      "description": "Provenance of a library item (doc 07 §2.1, §2.5). The item's semantic version is the copy metadata\n`version` of the [`LibCopy`] and is stored once, there.",
      "properties": {
        "as_of": {
          "anyOf": [
            {
              "$ref": "#/$defs/Date"
            },
            {
              "type": "null"
            }
          ],
          "description": "Date of the data."
        },
        "confidence": {
          "additionalProperties": {
            "$ref": "#/$defs/Confidence"
          },
          "description": "Confidence per section, keyed by section name.",
          "type": "object"
        },
        "foreign_terms": {
          "description": "Imported content under foreign terms.",
          "type": "boolean"
        },
        "key": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ident"
            },
            {
              "type": "null"
            }
          ],
          "description": "Human key (`pxc.2904602`, `ew.iec.mcb-1pn`)."
        },
        "licence": {
          "description": "SPDX licence expression of the item.",
          "type": [
            "string",
            "null"
          ]
        },
        "sources": {
          "description": "Where the data came from: datasheet references, file hashes, manual entry.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/ItemStatus",
          "description": "Item status; default released."
        }
      },
      "type": "object"
    },
    "ItemStatus": {
      "description": "Status of a library item.",
      "oneOf": [
        {
          "const": "draft",
          "description": "Draft.",
          "type": "string"
        },
        {
          "const": "released",
          "description": "Released (the default).",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "Deprecated, with an optional successor: `{\"deprecated\": {\"successor\": …}}`.",
          "properties": {
            "deprecated": {
              "$ref": "#/$defs/Deprecation"
            }
          },
          "required": [
            "deprecated"
          ],
          "type": "object"
        },
        {
          "const": "withdrawn",
          "description": "Withdrawn.",
          "type": "string"
        }
      ]
    },
    "LibRef": {
      "additionalProperties": true,
      "description": "A reference between library items (doc 07 §2.1): library, item and a semantic-version requirement.",
      "properties": {
        "item": {
          "$ref": "#/$defs/Uuid",
          "description": "The item's UUID, stable across versions."
        },
        "library": {
          "$ref": "#/$defs/Uuid",
          "description": "The library's UUID."
        },
        "version_req": {
          "description": "A semantic-version requirement such as `\"^1\"`.",
          "type": "string"
        }
      },
      "required": [
        "library",
        "item",
        "version_req"
      ],
      "type": "object"
    },
    "MacroKind": {
      "description": "The kind of a macro (FR-MAC-001, FR-MAC-002, FR-MAC-012).",
      "oneOf": [
        {
          "const": "window",
          "description": "A window macro: a selection on one page.",
          "type": "string"
        },
        {
          "const": "symbol",
          "description": "A symbol macro.",
          "type": "string"
        },
        {
          "const": "page",
          "description": "A page macro: whole pages.",
          "type": "string"
        }
      ]
    },
    "MacroVariant": {
      "additionalProperties": true,
      "description": "One variant of a macro.",
      "properties": {
        "fragment": {
          "description": "The project fragment (`#ew-fragment v1`, WP-S1.19 D12), kept as JSON here; `ew-commands` parses it."
        },
        "key": {
          "$ref": "#/$defs/Ident",
          "description": "The variant key."
        },
        "rep_type": {
          "$ref": "#/$defs/RepType",
          "description": "The representation type it is drawn for."
        }
      },
      "required": [
        "rep_type",
        "key",
        "fragment"
      ],
      "type": "object"
    },
    "MlText": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "additionalProperties": {
            "minLength": 1,
            "type": "string"
          },
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^(?:[a-z]{2,3}(?:-[a-z]{3}){0,3}|[a-z]{4,8})(?:-[A-Z][a-z]{3})?(?:-(?:[A-Z]{2}|[0-9]{3}))?(?:-(?:[a-z0-9]{5,8}|[0-9][a-z0-9]{3}))*(?:-[a-wy-z0-9](?:-[a-z0-9]{2,8})+)*(?:-x(?:-[a-z0-9]{1,8})+)?$",
            "type": "string"
          },
          "type": "object"
        }
      ],
      "description": "Multilingual text: a neutral string, or an object keyed by canonical BCP 47 tags with non-empty string values (doc 05 §3.2). JSON Schema cannot express that all text is NFC or that the keys are in ascending byte order; the reader rejects both."
    },
    "PlaceholderGroup": {
      "additionalProperties": true,
      "description": "A placeholder group (FR-MAC-018): fragment records that a boolean variable includes or omits.",
      "properties": {
        "include": {
          "description": "The name of the boolean variable that includes the group; absent means always included.",
          "type": [
            "string",
            "null"
          ]
        },
        "members": {
          "description": "The fragment-local record IDs of the group.",
          "items": {
            "$ref": "#/$defs/Uuid"
          },
          "type": "array"
        },
        "name": {
          "$ref": "#/$defs/Ident",
          "description": "The group name."
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "RepType": {
      "description": "Representation types (doc 03 §6, doc 07 §2.3). `panel_front` is a symbol type only: panel-front\nrepresentations are derived, never stored (ADR-0006 amendment 3).",
      "oneOf": [
        {
          "const": "multi_line",
          "description": "Multi-line (the default).",
          "type": "string"
        },
        {
          "const": "single_line",
          "description": "Single-line.",
          "type": "string"
        },
        {
          "const": "overview",
          "description": "Overview.",
          "type": "string"
        },
        {
          "const": "fluid",
          "description": "Fluid.",
          "type": "string"
        },
        {
          "const": "topology",
          "description": "Bus topology.",
          "type": "string"
        },
        {
          "const": "contact_image",
          "description": "Contact image.",
          "type": "string"
        },
        {
          "const": "panel_front",
          "description": "Panel front (symbol graphics only).",
          "type": "string"
        },
        {
          "const": "strip_segment",
          "description": "Strip segment.",
          "type": "string"
        },
        {
          "const": "graphic",
          "description": "Graphic.",
          "type": "string"
        }
      ]
    },
    "Sha256": {
      "description": "A SHA-256 digest sha256:<64 lower-case hex> (doc 05 §3.2).",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "Uuid": {
      "description": "A lower-case hyphenated UUID (doc 05 §3.2).",
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "ValueSet": {
      "additionalProperties": true,
      "description": "A named set of variable values.",
      "properties": {
        "name": {
          "$ref": "#/$defs/Ident",
          "description": "The value-set name."
        },
        "values": {
          "additionalProperties": true,
          "description": "The values, by variable name.",
          "type": "object"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "VarBinding": {
      "additionalProperties": true,
      "description": "Where a variable's value goes (doc 07 §2.7 `Binding`): a field path of one fragment record.",
      "properties": {
        "field": {
          "description": "The field path, such as `device.function_text`.",
          "type": "string"
        },
        "record": {
          "$ref": "#/$defs/Uuid",
          "description": "The fragment-local record ID."
        }
      },
      "required": [
        "record",
        "field"
      ],
      "type": "object"
    },
    "VarDef": {
      "additionalProperties": true,
      "description": "A macro variable (FR-MAC-004).",
      "properties": {
        "bindings": {
          "description": "The field paths the variable sets.",
          "items": {
            "$ref": "#/$defs/VarBinding"
          },
          "type": "array"
        },
        "default": {
          "description": "The default value."
        },
        "name": {
          "$ref": "#/$defs/Ident",
          "description": "The variable name."
        },
        "ty": {
          "$ref": "#/$defs/VarType",
          "description": "The variable type."
        }
      },
      "required": [
        "name",
        "ty"
      ],
      "type": "object"
    },
    "VarType": {
      "description": "The type of a macro variable (doc 07 §2.7).",
      "oneOf": [
        {
          "const": "text",
          "description": "A multilingual text.",
          "type": "string"
        },
        {
          "const": "ident",
          "description": "An identifier.",
          "type": "string"
        },
        {
          "const": "number",
          "description": "A number with its unit.",
          "type": "string"
        },
        {
          "const": "bool",
          "description": "A boolean; a placeholder group's `include`.",
          "type": "string"
        },
        {
          "const": "state",
          "description": "A device state (used, spare, reserved, not fitted).",
          "type": "string"
        },
        {
          "const": "part",
          "description": "A part (a library reference).",
          "type": "string"
        },
        {
          "const": "process_tag",
          "description": "A process tag.",
          "type": "string"
        },
        {
          "const": "channel_binding",
          "description": "The channel number in a module.",
          "type": "string"
        },
        {
          "const": "address",
          "description": "A manual PLC address.",
          "type": "string"
        },
        {
          "const": "tag_counter",
          "description": "A tag counter.",
          "type": "string"
        },
        {
          "const": "device_ref",
          "description": "An existing device chosen at insertion.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "An embedded library copy (doc 07 §2.1, doc 05 §13.2): `$k`, `id` (the copy ID\n`v5(NS_LIBCOPY, library ‖ item)`), `$v`, the copy metadata, then the item's own members.\n\n`sha256` is taken over the canonical compact JSON of the item's own members, without `id` and the copy\nmetadata, so the copy's hash equals the published item's (EW-CORE-014).\n\nDeserialisation reads the copy metadata itself and hands the remaining members to the item's own\ndeserialiser, so errors inside the item keep their paths (a flattened field would lose them).",
  "properties": {
    "$k": {
      "const": "macro",
      "description": "The kind name; always the first member."
    },
    "$v": {
      "description": "Per-kind schema version `$v`, omitted when 1.",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "description": {
      "$ref": "#/$defs/MlText",
      "description": "Description."
    },
    "groups": {
      "description": "The placeholder groups (FR-MAC-018).",
      "items": {
        "$ref": "#/$defs/PlaceholderGroup"
      },
      "type": "array"
    },
    "id": {
      "$ref": "#/$defs/Uuid",
      "description": "The copy ID."
    },
    "item_id": {
      "$ref": "#/$defs/Uuid",
      "description": "The item's UUID, stable across versions."
    },
    "kind": {
      "$ref": "#/$defs/MacroKind",
      "description": "Window, symbol or page macro."
    },
    "library_id": {
      "$ref": "#/$defs/Uuid",
      "description": "The library's UUID (the project ID for project-local items)."
    },
    "meta": {
      "$ref": "#/$defs/ItemMeta",
      "description": "Provenance."
    },
    "name": {
      "$ref": "#/$defs/MlText",
      "description": "Name."
    },
    "sha256": {
      "$ref": "#/$defs/Sha256",
      "description": "Hash of the item's own members."
    },
    "thumbnail": {
      "anyOf": [
        {
          "$ref": "#/$defs/Sha256"
        },
        {
          "type": "null"
        }
      ],
      "description": "The thumbnail asset `assets/<sha256>.<ext>`."
    },
    "value_sets": {
      "description": "The value sets.",
      "items": {
        "$ref": "#/$defs/ValueSet"
      },
      "type": "array"
    },
    "variables": {
      "description": "The variables (FR-MAC-004).",
      "items": {
        "$ref": "#/$defs/VarDef"
      },
      "type": "array"
    },
    "variants": {
      "description": "The variants, one per representation type and key.",
      "items": {
        "$ref": "#/$defs/MacroVariant"
      },
      "type": "array"
    },
    "version": {
      "description": "The item's semantic version (`MAJOR.MINOR.PATCH`).",
      "type": "string"
    }
  },
  "required": [
    "$k",
    "id",
    "library_id",
    "item_id",
    "version",
    "sha256",
    "name",
    "kind"
  ],
  "title": "macro",
  "type": "object"
}
