{
  "$defs": {
    "Ident": {
      "description": "An NFC identifier without surrounding white space (doc 05 §3.2).",
      "minLength": 1,
      "pattern": "^\\S(.*\\S)?$",
      "type": "string"
    },
    "SourceRef": {
      "additionalProperties": true,
      "description": "The import provenance of a record (doc 14 §2.3, ADR-0004 amendment 1): the lineage and the source key\nfrom which the record's ID `v5(lineage namespace, key)` was derived.",
      "properties": {
        "key": {
          "description": "The source key, byte for byte (NFC), such as `qet:el:<uuid>`.",
          "type": "string"
        },
        "lineage": {
          "$ref": "#/$defs/Uuid",
          "description": "The import lineage."
        }
      },
      "required": [
        "lineage",
        "key"
      ],
      "type": "object"
    },
    "Uuid": {
      "description": "A lower-case hyphenated UUID (doc 05 §3.2).",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "A target in another project or cabinet (doc 03 §5, rank 22).",
  "properties": {
    "$k": {
      "const": "external_ref",
      "description": "The kind name; always the first member."
    },
    "$v": {
      "description": "Per-kind schema version `$v`, omitted when 1.",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "connection": {
      "anyOf": [
        {
          "$ref": "#/$defs/Ident"
        },
        {
          "type": "null"
        }
      ],
      "description": "The connection there (\"L\")."
    },
    "device": {
      "$ref": "#/$defs/Ident",
      "description": "The device there (\"JE-N1000-03\")."
    },
    "id": {
      "$ref": "#/$defs/Uuid",
      "description": "The record ID."
    },
    "location": {
      "$ref": "#/$defs/Uuid",
      "description": "Its location node (+J-E-206)."
    },
    "project": {
      "anyOf": [
        {
          "$ref": "#/$defs/Ident"
        },
        {
          "type": "null"
        }
      ],
      "description": "The other project."
    },
    "source_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceRef"
        },
        {
          "type": "null"
        }
      ],
      "description": "Import provenance."
    }
  },
  "required": [
    "$k",
    "id",
    "location",
    "device"
  ],
  "title": "external_ref",
  "type": "object"
}
