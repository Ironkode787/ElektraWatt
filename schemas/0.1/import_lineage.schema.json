{
  "$defs": {
    "Ident": {
      "description": "An identifier: non-empty, one line (no control character U+0000 to U+001F or U+007F to U+009F), without leading or trailing white space (the Unicode White_Space set); interior spaces are allowed (doc 05 §3.2). JSON Schema cannot express Unicode Normalization Form C; the reader rejects non-NFC text.",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000](?:[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000])?$",
      "type": "string"
    },
    "LineageAnchor": {
      "description": "The anchor of an [`ImportLineage`] (doc 14 §2.3).",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "QET 0.200+ project UUID.",
          "properties": {
            "qet_project_uuid": {
              "$ref": "#/$defs/Uuid"
            }
          },
          "required": [
            "qet_project_uuid"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "SHA-256 of the lineage's first imported file.",
          "properties": {
            "first_import_sha256": {
              "$ref": "#/$defs/Sha256"
            }
          },
          "required": [
            "first_import_sha256"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "\"Import as copy\" number `n` of another lineage: `{\"copy\": {\"of\": <namespace>, \"n\": n}}`.",
          "properties": {
            "copy": {
              "$ref": "#/$defs/LineageCopy"
            }
          },
          "required": [
            "copy"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A fixed label, such as `\"golden\"` for the golden CSV bootstrap.",
          "properties": {
            "fixed": {
              "$ref": "#/$defs/Ident"
            }
          },
          "required": [
            "fixed"
          ],
          "type": "object"
        }
      ]
    },
    "LineageCopy": {
      "additionalProperties": true,
      "description": "The payload of [`LineageAnchor::Copy`].",
      "properties": {
        "n": {
          "description": "The copy number.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "of": {
          "$ref": "#/$defs/Uuid",
          "description": "The **namespace** of the original lineage (`ImportLineage.namespace`), as in\n`ew_ids::v5::LineageAnchor::Copy` and ADR-0004 amendment 4, not its record ID."
        }
      },
      "required": [
        "of",
        "n"
      ],
      "type": "object"
    },
    "Sha256": {
      "description": "A SHA-256 digest sha256:<64 lower-case hex> (doc 05 §3.2).",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "Uuid": {
      "description": "A lower-case hyphenated UUID (doc 05 §3.2).",
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "The identity anchor of one imported source (doc 03 §5, doc 14 §2.3, rank 15).",
  "properties": {
    "$k": {
      "const": "import_lineage",
      "description": "The kind name; always the first member."
    },
    "$v": {
      "description": "Per-kind schema version `$v`, omitted when 1.",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "anchor": {
      "$ref": "#/$defs/LineageAnchor",
      "description": "The identity anchor."
    },
    "id": {
      "$ref": "#/$defs/Uuid",
      "description": "The record ID."
    },
    "importer": {
      "$ref": "#/$defs/Ident",
      "description": "The importer, lower case (`\"qet\"`)."
    },
    "last_run": {
      "anyOf": [
        {
          "$ref": "#/$defs/Uuid"
        },
        {
          "type": "null"
        }
      ],
      "description": "The last import run."
    },
    "last_source_sha256": {
      "anyOf": [
        {
          "$ref": "#/$defs/Sha256"
        },
        {
          "type": "null"
        }
      ],
      "description": "SHA-256 of the last imported source file."
    },
    "namespace": {
      "$ref": "#/$defs/Uuid",
      "description": "`v5(NS_IMPORT, importer ␟ anchor kind ␟ anchor value)`, computed once at creation (doc 05 §3.2a)."
    },
    "source_name": {
      "description": "The source file name without a path.",
      "type": "string"
    }
  },
  "required": [
    "$k",
    "id",
    "importer",
    "source_name",
    "anchor",
    "namespace"
  ],
  "title": "import_lineage",
  "type": "object"
}
