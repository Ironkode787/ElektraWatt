{
  "$defs": {
    "CpOverride": {
      "additionalProperties": true,
      "description": "An override of one instantiated connection point (FR-DEV-008).",
      "properties": {
        "alias": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ident"
            },
            {
              "type": "null"
            }
          ],
          "description": "Alias (\"1 / L1\")."
        },
        "description": {
          "anyOf": [
            {
              "$ref": "#/$defs/MlText"
            },
            {
              "type": "null"
            }
          ],
          "description": "Description."
        },
        "designation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ident"
            },
            {
              "type": "null"
            }
          ],
          "description": "Printed designation."
        },
        "idx": {
          "description": "The CP index.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "unused": {
          "description": "Unused by design.",
          "type": "boolean"
        }
      },
      "required": [
        "idx"
      ],
      "type": "object"
    },
    "FnRole": {
      "description": "Main or auxiliary function.",
      "oneOf": [
        {
          "const": "main",
          "description": "The main function (the default).",
          "type": "string"
        },
        {
          "const": "aux",
          "description": "An auxiliary function.",
          "type": "string"
        }
      ]
    },
    "FunctionKind": {
      "description": "The kind of a function.",
      "oneOf": [
        {
          "const": "normal",
          "description": "An ordinary function (the default).",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "An interruption point.",
          "properties": {
            "ip": {
              "$ref": "#/$defs/IpSpec"
            }
          },
          "required": [
            "ip"
          ],
          "type": "object"
        },
        {
          "const": "black_box",
          "description": "A black box whose CPs come from the part's pattern.",
          "type": "string"
        }
      ]
    },
    "Ident": {
      "description": "An identifier: non-empty, one line (no control character U+0000 to U+001F or U+007F to U+009F), without leading or trailing white space (the Unicode White_Space set); interior spaces are allowed (doc 05 §3.2). JSON Schema cannot express Unicode Normalization Form C; the reader rejects non-NFC text.",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000](?:[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000])?$",
      "type": "string"
    },
    "IpDirection": {
      "description": "Signal direction of an interruption point.",
      "oneOf": [
        {
          "const": "source",
          "description": "Source.",
          "type": "string"
        },
        {
          "const": "target",
          "description": "Target.",
          "type": "string"
        },
        {
          "const": "undirected",
          "description": "Undirected.",
          "type": "string"
        }
      ]
    },
    "IpSpec": {
      "additionalProperties": true,
      "description": "An interruption point (doc 03 §10).",
      "properties": {
        "direction": {
          "$ref": "#/$defs/IpDirection",
          "description": "Signal direction, independent of the arrow glyph (FR-XRF-009)."
        },
        "external": {
          "anyOf": [
            {
              "$ref": "#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ],
          "description": "An external connection point's target (FR-XRF-012)."
        },
        "name": {
          "$ref": "#/$defs/Ident",
          "description": "The pairing name (\"L-1\")."
        },
        "sort": {
          "description": "Chain order.",
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        },
        "star_source": {
          "description": "The star source of its name in star mode.",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "direction"
      ],
      "type": "object"
    },
    "MlText": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "additionalProperties": {
            "minLength": 1,
            "type": "string"
          },
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^(?:[a-z]{2,3}(?:-[a-z]{3}){0,3}|[a-z]{4,8})(?:-[A-Z][a-z]{3})?(?:-(?:[A-Z]{2}|[0-9]{3}))?(?:-(?:[a-z0-9]{5,8}|[0-9][a-z0-9]{3}))*(?:-[a-wy-z0-9](?:-[a-z0-9]{2,8})+)*(?:-x(?:-[a-z0-9]{1,8})+)?$",
            "type": "string"
          },
          "type": "object"
        }
      ],
      "description": "Multilingual text: a neutral string, or an object keyed by canonical BCP 47 tags with non-empty string values (doc 05 §3.2). JSON Schema cannot express that all text is NFC or that the keys are in ascending byte order; the reader rejects both."
    },
    "SourceRef": {
      "additionalProperties": true,
      "description": "The import provenance of a record (doc 14 §2.3, ADR-0004 amendment 1): the lineage and the source key\nfrom which the record's ID `v5(lineage namespace, key)` was derived.",
      "properties": {
        "key": {
          "description": "The source key, byte for byte (NFC), such as `qet:el:<uuid>`.",
          "type": "string"
        },
        "lineage": {
          "$ref": "#/$defs/Uuid",
          "description": "The import lineage."
        }
      },
      "required": [
        "lineage",
        "key"
      ],
      "type": "object"
    },
    "Uuid": {
      "description": "A lower-case hyphenated UUID (doc 05 §3.2).",
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "One logical element (doc 03 §7, rank 32): a pole set, a contact, a coil, a PSU, an interruption point.\nIts connection points are instantiated from the definition or the part's pattern; only overrides are\nstored. `device` is `None` if and only if the kind is `Ip` (ADR-0006 amendment 1).\n\nNot in v0: `bus_port` (bus, doc 03 §14) and `CpOverride.closure` (fluid ports, doc 03 §15).",
  "properties": {
    "$k": {
      "const": "function",
      "description": "The kind name; always the first member."
    },
    "$v": {
      "description": "Per-kind schema version `$v`, omitted when 1.",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "cp_overrides": {
      "description": "CP overrides, keyed by `idx` (FR-DEV-008).",
      "items": {
        "$ref": "#/$defs/CpOverride"
      },
      "type": "array"
    },
    "def": {
      "$ref": "#/$defs/Uuid",
      "description": "The function definition copy."
    },
    "device": {
      "anyOf": [
        {
          "$ref": "#/$defs/Uuid"
        },
        {
          "type": "null"
        }
      ],
      "description": "The device; `None` only for interruption points."
    },
    "id": {
      "$ref": "#/$defs/Uuid",
      "description": "The record ID: UUIDv7, or `v5(device, template_index)` from a part's function template."
    },
    "kind": {
      "$ref": "#/$defs/FunctionKind",
      "description": "Normal, interruption point or black box; default normal."
    },
    "role": {
      "$ref": "#/$defs/FnRole",
      "description": "Main or auxiliary; default main (exactly one main per device)."
    },
    "source_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceRef"
        },
        {
          "type": "null"
        }
      ],
      "description": "Import provenance."
    },
    "template_entry": {
      "description": "The 0-based index of the part `function_template` entry this function was created from (FT-655), stored at\ncreation because the function's ID is minted and cannot name it. The CP derivation reads the entry at this\nindex of the first part use of the device whose template has one naming the function's FnDef copy; absent (a\nfunction not made from a template, or a file written before the member), or an index that names no such entry,\nit takes the first entry naming the FnDef copy. Appended, since 0.1: an optional member without cascade\nsemantics, additive within format 0.1 (ADR-0011 amendment 1, doc 05 §10.3 rule 1).",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "required": [
    "$k",
    "id",
    "def"
  ],
  "title": "function",
  "type": "object"
}
