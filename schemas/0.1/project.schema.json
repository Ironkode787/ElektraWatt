{
  "$defs": {
    "Address": {
      "additionalProperties": true,
      "description": "A postal address (doc 03 §5). Its plain strings are NFC; the loader normalises them (module docs).",
      "properties": {
        "city": {
          "description": "City.",
          "type": [
            "string",
            "null"
          ]
        },
        "country": {
          "description": "Country.",
          "type": [
            "string",
            "null"
          ]
        },
        "postcode": {
          "description": "Postcode.",
          "type": [
            "string",
            "null"
          ]
        },
        "street": {
          "description": "Street and number.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "BasicProjectRef": {
      "additionalProperties": true,
      "description": "The basic project a project was created from (FR-PRJ-009, WP-S1.19 D14): its project ID and its manifest\ngeneration when it was copied (a basic project has no semantic version).",
      "properties": {
        "generation": {
          "description": "The basic project's manifest generation when it was copied.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "$ref": "#/$defs/Uuid",
          "description": "The basic project's project ID."
        }
      },
      "required": [
        "id",
        "generation"
      ],
      "type": "object"
    },
    "Date": {
      "description": "An authored date YYYY-MM-DD (doc 05 §3.2).",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "type": "string"
    },
    "DateFormat": {
      "description": "Printed date format.",
      "oneOf": [
        {
          "const": "dd_mm_yyyy",
          "description": "dd-mm-yyyy.",
          "type": "string"
        },
        {
          "const": "iso8601",
          "description": "ISO 8601, yyyy-mm-dd.",
          "type": "string"
        }
      ]
    },
    "Dec3": {
      "description": "A canonical decimal string: at most three fraction digits, no trailing fraction zeros, no leading zeros, no plus sign, no \"-0\", no exponent, no white space, no unit (doc 05 §3.2). The pattern bounds the integer part to 16 digits; the exact i64 range of the thousandths (about 9.2 x 10^15) is checked by the reader.",
      "maxLength": 21,
      "pattern": "^(?:0|-?[1-9][0-9]{0,15}(?:\\.[0-9]{0,2}[1-9])?|-?0\\.[0-9]{0,2}[1-9])$",
      "type": "string"
    },
    "DecimalSeparator": {
      "description": "Printed decimal separator.",
      "oneOf": [
        {
          "const": "point",
          "description": "\"0.75\".",
          "type": "string"
        },
        {
          "const": "comma",
          "description": "\"0,75\".",
          "type": "string"
        }
      ]
    },
    "EarthingSystem": {
      "description": "Earthing system of the supply.",
      "oneOf": [
        {
          "const": "tn_s",
          "description": "TN-S.",
          "type": "string"
        },
        {
          "const": "tn_c_s",
          "description": "TN-C-S.",
          "type": "string"
        },
        {
          "const": "tt",
          "description": "TT.",
          "type": "string"
        },
        {
          "const": "it",
          "description": "IT.",
          "type": "string"
        }
      ]
    },
    "Formatting": {
      "additionalProperties": true,
      "description": "Formatting conventions (doc 03 §5): date format, decimal separator and tag case sensitivity.",
      "properties": {
        "date": {
          "anyOf": [
            {
              "$ref": "#/$defs/DateFormat"
            },
            {
              "type": "null"
            }
          ],
          "description": "Date format of printed dates."
        },
        "decimal_separator": {
          "anyOf": [
            {
              "$ref": "#/$defs/DecimalSeparator"
            },
            {
              "type": "null"
            }
          ],
          "description": "Decimal separator of printed numbers."
        },
        "tag_case": {
          "anyOf": [
            {
              "$ref": "#/$defs/TagCase"
            },
            {
              "type": "null"
            }
          ],
          "description": "Whether tags compare case-sensitively."
        }
      },
      "type": "object"
    },
    "Ident": {
      "description": "An identifier: non-empty, one line (no control character U+0000 to U+001F or U+007F to U+009F), without leading or trailing white space (the Unicode White_Space set); interior spaces are allowed (doc 05 §3.2). JSON Schema cannot express Unicode Normalization Form C; the reader rejects non-NFC text.",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000](?:[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000])?$",
      "type": "string"
    },
    "IpPairing": {
      "additionalProperties": true,
      "description": "How interruption points pair (doc 03 §5).",
      "properties": {
        "mode": {
          "$ref": "#/$defs/IpPairingMode",
          "description": "Star or chain."
        },
        "scope": {
          "$ref": "#/$defs/IpPairingScope",
          "description": "The pairing scope."
        }
      },
      "required": [
        "mode",
        "scope"
      ],
      "type": "object"
    },
    "IpPairingMode": {
      "description": "Interruption-point pairing mode.",
      "oneOf": [
        {
          "const": "star",
          "description": "One star source refers to all others.",
          "type": "string"
        },
        {
          "const": "chain",
          "description": "Points pair in sort order.",
          "type": "string"
        }
      ]
    },
    "IpPairingScope": {
      "description": "Interruption-point pairing scope.",
      "oneOf": [
        {
          "const": "project",
          "description": "The whole project.",
          "type": "string"
        },
        {
          "const": "function",
          "description": "Per function aspect node (`=`).",
          "type": "string"
        },
        {
          "const": "location",
          "description": "Per location node (`+`).",
          "type": "string"
        }
      ]
    },
    "LangTag": {
      "description": "A canonical BCP 47 language tag such as en-GB (language in lower case, script in title case, region in upper case). JSON Schema cannot express that variant and extension subtags are unique; no registry is consulted, so qq-QQ is accepted.",
      "minLength": 2,
      "pattern": "^(?:[a-z]{2,3}(?:-[a-z]{3}){0,3}|[a-z]{4,8})(?:-[A-Z][a-z]{3})?(?:-(?:[A-Z]{2}|[0-9]{3}))?(?:-(?:[a-z0-9]{5,8}|[0-9][a-z0-9]{3}))*(?:-[a-wy-z0-9](?:-[a-z0-9]{2,8})+)*(?:-x(?:-[a-z0-9]{1,8})+)?$",
      "type": "string"
    },
    "MasterData": {
      "additionalProperties": true,
      "description": "Project master data (doc 03 §5).",
      "properties": {
        "created": {
          "anyOf": [
            {
              "$ref": "#/$defs/Date"
            },
            {
              "type": "null"
            }
          ],
          "description": "Creation date."
        },
        "description": {
          "$ref": "#/$defs/MlText",
          "description": "Project description (\"Expansion Control Cabinets\"); the title block prints it unless a page\noverrides it (D-06)."
        },
        "document_title": {
          "$ref": "#/$defs/MlText",
          "description": "The cover subtitle (\"Electrical Definition\", doc 20 §4.1), distinct from `long_description`\n(doc 03 §5). Appended, since 0.1."
        },
        "drawing_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ident"
            },
            {
              "type": "null"
            }
          ],
          "description": "Drawing identification, separate from the project reference (FR-PRJ-002)."
        },
        "edited": {
          "anyOf": [
            {
              "$ref": "#/$defs/Date"
            },
            {
              "type": "null"
            }
          ],
          "description": "Edited date: day precision, merged by maximum, feeds the \"Saved\" cell (FR-PRJ-029)."
        },
        "long_description": {
          "$ref": "#/$defs/MlText",
          "description": "Long description for the cover."
        },
        "manufacturing_year": {
          "description": "Manufacturing year.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "object_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ident"
            },
            {
              "type": "null"
            }
          ],
          "description": "Object or cabinet ID (\"J-E-2416\")."
        },
        "project_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ident"
            },
            {
              "type": "null"
            }
          ],
          "description": "Project reference."
        }
      },
      "type": "object"
    },
    "MlText": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "additionalProperties": {
            "minLength": 1,
            "type": "string"
          },
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^(?:[a-z]{2,3}(?:-[a-z]{3}){0,3}|[a-z]{4,8})(?:-[A-Z][a-z]{3})?(?:-(?:[A-Z]{2}|[0-9]{3}))?(?:-(?:[a-z0-9]{5,8}|[0-9][a-z0-9]{3}))*(?:-[a-wy-z0-9](?:-[a-z0-9]{2,8})+)*(?:-x(?:-[a-z0-9]{1,8})+)?$",
            "type": "string"
          },
          "type": "object"
        }
      ],
      "description": "Multilingual text: a neutral string, or an object keyed by canonical BCP 47 tags with non-empty string values (doc 05 §3.2). JSON Schema cannot express that all text is NFC or that the keys are in ascending byte order; the reader rejects both."
    },
    "Nm": {
      "description": "A length in nanometres (doc 05 §3.2). Written without fraction or exponent; JSON Schema cannot tell 5 from 5.0, the reader rejects the latter.",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
    },
    "Party": {
      "additionalProperties": true,
      "description": "A person or organisation in a role (doc 03 §5). Name and address are personal data (NFR-PRIV-06).",
      "properties": {
        "address": {
          "anyOf": [
            {
              "$ref": "#/$defs/Address"
            },
            {
              "type": "null"
            }
          ],
          "description": "The postal address."
        },
        "name": {
          "$ref": "#/$defs/MlText",
          "description": "The name."
        },
        "personal_data": {
          "description": "Whether the party is a natural person whose data is personal data (FR-PRJ-024).",
          "type": "boolean"
        },
        "role": {
          "$ref": "#/$defs/PartyRole",
          "description": "The role, bound by form cells (FR-PRJ-003, D-30)."
        }
      },
      "required": [
        "role"
      ],
      "type": "object"
    },
    "PartyRole": {
      "description": "The role of a [`Party`].",
      "oneOf": [
        {
          "const": "customer",
          "description": "Customer.",
          "type": "string"
        },
        {
          "const": "end_user",
          "description": "End user.",
          "type": "string"
        },
        {
          "const": "panel_builder",
          "description": "Panel builder (legal owner of the drawings).",
          "type": "string"
        },
        {
          "const": "author",
          "description": "Author.",
          "type": "string"
        },
        {
          "const": "checker",
          "description": "Checker.",
          "type": "string"
        },
        {
          "const": "engineer",
          "description": "Engineer.",
          "type": "string"
        }
      ]
    },
    "ProjectKind": {
      "description": "What a project is (FR-PRJ-026).",
      "oneOf": [
        {
          "const": "schematic",
          "description": "A schematic project (the default).",
          "type": "string"
        },
        {
          "const": "basic",
          "description": "A basic project (company template).",
          "type": "string"
        },
        {
          "const": "macro",
          "description": "A macro project.",
          "type": "string"
        }
      ]
    },
    "ProjectLanguages": {
      "additionalProperties": true,
      "description": "Source and translation languages of a project.",
      "properties": {
        "source": {
          "$ref": "#/$defs/LangTag",
          "description": "The language texts are authored in."
        },
        "translations": {
          "description": "Translation languages (a set, sorted).",
          "items": {
            "$ref": "#/$defs/LangTag"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "source"
      ],
      "type": "object"
    },
    "ProjectSettings": {
      "additionalProperties": true,
      "description": "Project settings (doc 03 §5). v0 types the settings with a field-level definition; numbering,\nwire numbering, cross-reference format, colour and size profiles, check, fluid, manufacturing and frame\nsettings belong to their work packages and are kept in `extra` until then.",
      "properties": {
        "formatting": {
          "$ref": "#/$defs/Formatting",
          "description": "Formatting conventions."
        },
        "identifier_set": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ident"
            },
            {
              "type": "null"
            }
          ],
          "description": "The pinned identifier set by key, such as `\"EN81346-2:2009\"` (ADR-0026)."
        },
        "ip_pairing": {
          "anyOf": [
            {
              "$ref": "#/$defs/IpPairing"
            },
            {
              "type": "null"
            }
          ],
          "description": "Interruption-point pairing (FR-XRF-007, FR-XRF-010)."
        },
        "text_styles": {
          "additionalProperties": {
            "$ref": "#/$defs/TextStyleSpec"
          },
          "description": "The text styles as overrides of the built-in table of doc 20 §17.5, by style key (ADR-0032): a key of the\ntable takes the entry's size and weight, any other key adds a style. Absent is the built-in table.",
          "type": "object"
        }
      },
      "type": "object"
    },
    "Quantity": {
      "additionalProperties": true,
      "description": "A decimal value with its unit (doc 03 §3.2): `{\"value\": Dec3, \"unit\": Unit}`. Rendering (\"0.75 mm²\",\ndecimal comma in nl and de) is a query, never stored text (D-18).\n\n```\nuse ew_schema::{Quantity, Unit};\n\nlet q: Quantity = serde_json::from_str(r#\"{\"value\":\"20\",\"unit\":\"A\"}\"#).unwrap();\nassert_eq!(q.unit, Unit::A);\nassert_eq!(serde_json::to_string(&q).unwrap(), r#\"{\"value\":\"20\",\"unit\":\"A\"}\"#);\n```",
      "properties": {
        "unit": {
          "$ref": "#/$defs/Unit",
          "description": "Its unit."
        },
        "value": {
          "$ref": "#/$defs/Dec3",
          "description": "The number."
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": true,
      "description": "The import provenance of a record (doc 14 §2.3, ADR-0004 amendment 1): the lineage and the source key\nfrom which the record's ID `v5(lineage namespace, key)` was derived.",
      "properties": {
        "key": {
          "description": "The source key, byte for byte (NFC), such as `qet:el:<uuid>`.",
          "type": "string"
        },
        "lineage": {
          "$ref": "#/$defs/Uuid",
          "description": "The import lineage."
        }
      },
      "required": [
        "lineage",
        "key"
      ],
      "type": "object"
    },
    "SupplyOrigin": {
      "additionalProperties": true,
      "description": "Where the supply comes from (doc 03 §5).",
      "properties": {
        "ik_max": {
          "anyOf": [
            {
              "$ref": "#/$defs/Dec3"
            },
            {
              "type": "null"
            }
          ],
          "description": "Maximum prospective short-circuit current (kA)."
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ],
          "description": "The external source."
        },
        "upstream_rating": {
          "anyOf": [
            {
              "$ref": "#/$defs/Dec3"
            },
            {
              "type": "null"
            }
          ],
          "description": "Upstream protection rating (A)."
        }
      },
      "type": "object"
    },
    "SupplySpec": {
      "additionalProperties": true,
      "description": "The incoming supply (doc 03 §5), rendered by a format (\"1 x 230 VAC + N + PE, 50 Hz\").",
      "properties": {
        "earthing": {
          "anyOf": [
            {
              "$ref": "#/$defs/EarthingSystem"
            },
            {
              "type": "null"
            }
          ],
          "description": "Earthing system (unset while unverified)."
        },
        "frequency": {
          "$ref": "#/$defs/Dec3",
          "description": "Frequency (Hz); 0 for DC."
        },
        "neutral": {
          "description": "Neutral conductor present.",
          "type": "boolean"
        },
        "origin": {
          "anyOf": [
            {
              "$ref": "#/$defs/SupplyOrigin"
            },
            {
              "type": "null"
            }
          ],
          "description": "Upstream protection and source."
        },
        "pe": {
          "description": "Protective earth present.",
          "type": "boolean"
        },
        "phases": {
          "description": "Number of phases.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "u_nom": {
          "$ref": "#/$defs/Dec3",
          "description": "Nominal voltage (V)."
        }
      },
      "required": [
        "phases",
        "u_nom",
        "frequency"
      ],
      "type": "object"
    },
    "TagCase": {
      "description": "Tag case sensitivity (the record form of `ew_mltext::CaseSensitivity`).",
      "oneOf": [
        {
          "const": "sensitive",
          "description": "Tags differing only in case are different.",
          "type": "string"
        },
        {
          "const": "insensitive",
          "description": "Tags differing only in case collide.",
          "type": "string"
        }
      ]
    },
    "TextStyleSpec": {
      "additionalProperties": true,
      "description": "One entry of `ProjectSettings.text_styles`: an override of a built-in style or a new style (ADR-0032).\n\nFamily, italic and alignment are not typed (the bundled face is the only family at MVP, ADR-0028; alignment\nbelongs to the slot) and stay in `extra`.",
      "properties": {
        "size": {
          "$ref": "#/$defs/Nm",
          "description": "The em height in nm, 500,000 … 50,000,000 (0.5 mm … 50 mm)."
        },
        "weight": {
          "anyOf": [
            {
              "$ref": "#/$defs/TextWeight"
            },
            {
              "type": "null"
            }
          ],
          "description": "The weight; absent keeps the built-in row's weight (regular for a new style)."
        }
      },
      "required": [
        "size"
      ],
      "type": "object"
    },
    "TextWeight": {
      "description": "The weight of a text style (ADR-0032 decision 1).",
      "oneOf": [
        {
          "const": "regular",
          "description": "Regular.",
          "type": "string"
        },
        {
          "const": "bold",
          "description": "Bold.",
          "type": "string"
        }
      ]
    },
    "Unit": {
      "description": "The units of doc 03 §3.2 and the order units of FR-PRT-026. Persisted as the unit symbol in ASCII\n(`\"mm2\"`, `\"degC\"`), so files stay greppable; rendering uses the typographic symbol.",
      "oneOf": [
        {
          "const": "mm2",
          "description": "Square millimetre (cross-sections).",
          "type": "string"
        },
        {
          "const": "A",
          "description": "Ampere.",
          "type": "string"
        },
        {
          "const": "V",
          "description": "Volt.",
          "type": "string"
        },
        {
          "const": "Hz",
          "description": "Hertz.",
          "type": "string"
        },
        {
          "const": "bar",
          "description": "Bar (pressure).",
          "type": "string"
        },
        {
          "const": "degC",
          "description": "Degree Celsius.",
          "type": "string"
        },
        {
          "const": "kg",
          "description": "Kilogram.",
          "type": "string"
        },
        {
          "const": "W",
          "description": "Watt.",
          "type": "string"
        },
        {
          "const": "m",
          "description": "Metre (lengths and the order unit of cables).",
          "type": "string"
        },
        {
          "const": "piece",
          "description": "Piece (the default order unit).",
          "type": "string"
        },
        {
          "const": "set",
          "description": "Set (order unit).",
          "type": "string"
        }
      ]
    },
    "Uuid": {
      "description": "A lower-case hyphenated UUID (doc 05 §3.2).",
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "The single project row (doc 03 §5, rank 10): master data, parties, supply and settings.\n\nNot in v0 (later work packages; a file that carries them keeps them in `extra`): `user_prop_defs`\n(no field-level definition yet), `completed` (revisions, doc 15 §5.10) and the settings schemes listed\nat [`ProjectSettings`].",
  "properties": {
    "$k": {
      "const": "project",
      "description": "The kind name; always the first member."
    },
    "$v": {
      "description": "Per-kind schema version `$v`, omitted when 1.",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "basic_project": {
      "anyOf": [
        {
          "$ref": "#/$defs/BasicProjectRef"
        },
        {
          "type": "null"
        }
      ],
      "description": "The basic project this project was created from (FR-PRJ-009, doc 07 §2.8; WP-S1.19 D14)."
    },
    "control_voltage": {
      "anyOf": [
        {
          "$ref": "#/$defs/Quantity"
        },
        {
          "type": "null"
        }
      ],
      "description": "Control voltage (V)."
    },
    "derivation_profile": {
      "$ref": "#/$defs/Ident",
      "description": "The derivation profile, such as `\"2027.1\"` (FR-PRJ-011); changes only by a previewed upgrade."
    },
    "id": {
      "$ref": "#/$defs/Uuid",
      "description": "The record ID."
    },
    "kind": {
      "$ref": "#/$defs/ProjectKind",
      "description": "Schematic, basic (company template) or macro project (FR-PRJ-026)."
    },
    "languages": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProjectLanguages"
        },
        {
          "type": "null"
        }
      ],
      "description": "Source and translation languages."
    },
    "master": {
      "$ref": "#/$defs/MasterData",
      "description": "Master data printed on the cover and in title blocks."
    },
    "parties": {
      "description": "Persons and organisations in their roles (FR-PRJ-003). Personal data (NFR-PRIV-06).",
      "items": {
        "$ref": "#/$defs/Party"
      },
      "type": "array"
    },
    "rated_consumption": {
