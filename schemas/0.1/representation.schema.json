{
  "$defs": {
    "Align": {
      "description": "Text alignment at the anchor point: nine positions.",
      "oneOf": [
        {
          "const": "top_left",
          "description": "Top left.",
          "type": "string"
        },
        {
          "const": "top_centre",
          "description": "Top centre.",
          "type": "string"
        },
        {
          "const": "top_right",
          "description": "Top right.",
          "type": "string"
        },
        {
          "const": "middle_left",
          "description": "Middle left.",
          "type": "string"
        },
        {
          "const": "centre",
          "description": "Centre.",
          "type": "string"
        },
        {
          "const": "middle_right",
          "description": "Middle right.",
          "type": "string"
        },
        {
          "const": "bottom_left",
          "description": "Bottom left.",
          "type": "string"
        },
        {
          "const": "bottom_centre",
          "description": "Bottom centre.",
          "type": "string"
        },
        {
          "const": "bottom_right",
          "description": "Bottom right.",
          "type": "string"
        }
      ]
    },
    "AnchorPolicy": {
      "description": "Where a symbol's cross-reference anchor lies (FR-SYM-010).",
      "oneOf": [
        {
          "const": "origin",
          "description": "The symbol origin (the default).",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "The position of a text slot.",
          "properties": {
            "slot": {
              "$ref": "#/$defs/SlotKind"
            }
          },
          "required": [
            "slot"
          ],
          "type": "object"
        },
        {
          "const": "graphic_centre",
          "description": "The centre of the graphics.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "A named point.",
          "properties": {
            "named": {
              "$ref": "#/$defs/Pt2"
            }
          },
          "required": [
            "named"
          ],
          "type": "object"
        }
      ]
    },
    "Angle2": {
      "description": "An angle in 10^-3 degree, counter-clockwise on the sheet, within the i32 range (doc 05 §3.2).",
      "maximum": 2147483647,
      "minimum": -2147483648,
      "type": "integer"
    },
    "ArcPrim": {
      "additionalProperties": true,
      "description": "An elliptic arc (QET's arc: bounding rectangle, start angle and sweep, counter-clockwise).",
      "properties": {
        "rect": {
          "$ref": "#/$defs/Rect",
          "description": "The bounding rectangle of the full ellipse."
        },
        "start": {
          "$ref": "#/$defs/Angle2",
          "description": "Start angle."
        },
        "stroke": {
          "anyOf": [
            {
              "$ref": "#/$defs/Stroke"
            },
            {
              "type": "null"
            }
          ],
          "description": "Stroke."
        },
        "sweep": {
          "$ref": "#/$defs/Angle2",
          "description": "Sweep angle."
        }
      },
      "required": [
        "rect",
        "sweep"
      ],
      "type": "object"
    },
    "BoxCp": {
      "additionalProperties": true,
      "description": "One CP of a black box: function CP index, position and direction.",
      "properties": {
        "dir": {
          "$ref": "#/$defs/Dir4",
          "description": "The direction a wire leaves the CP."
        },
        "idx": {
          "description": "The function CP index.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "pos": {
          "$ref": "#/$defs/Pt2",
          "description": "Position relative to the representation."
        }
      },
      "required": [
        "idx",
        "pos",
        "dir"
      ],
      "type": "object"
    },
    "BoxSpec": {
      "additionalProperties": true,
      "description": "The outline, CPs and inner graphics of a black box (doc 03 §6).",
      "properties": {
        "cps": {
          "description": "The box CPs.",
          "items": {
            "$ref": "#/$defs/BoxCp"
          },
          "type": "array"
        },
        "inner": {
          "description": "Graphics inside the box.",
          "items": {
            "$ref": "#/$defs/Primitive"
          },
          "type": "array"
        },
        "outline": {
          "description": "The outline polygon.",
          "items": {
            "$ref": "#/$defs/Pt2"
          },
          "type": "array"
        }
      },
      "required": [
        "outline"
      ],
      "type": "object"
    },
    "CirclePrim": {
      "additionalProperties": true,
      "description": "A circle.",
      "properties": {
        "centre": {
          "$ref": "#/$defs/Pt2",
          "description": "Centre."
        },
        "fill": {
          "anyOf": [
            {
              "$ref": "#/$defs/Colour"
            },
            {
              "type": "null"
            }
          ],
          "description": "Fill."
        },
        "r": {
          "$ref": "#/$defs/Nm",
          "description": "Radius."
        },
        "stroke": {
          "anyOf": [
            {
              "$ref": "#/$defs/Stroke"
            },
            {
              "type": "null"
            }
          ],
          "description": "Stroke."
        }
      },
      "required": [
        "centre",
        "r"
      ],
      "type": "object"
    },
    "Colour": {
      "description": "A drawing colour: the layer's colour (the default) or an explicit sRGB value.",
      "oneOf": [
        {
          "const": "by_layer",
          "description": "The layer's colour (the default).",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "An explicit colour.",
          "properties": {
            "rgb": {
              "$ref": "#/$defs/Rgb"
            }
          },
          "required": [
            "rgb"
          ],
          "type": "object"
        }
      ]
    },
    "Dash": {
      "description": "A dash pattern scaled by the pen width (doc 07 §2.3).",
      "oneOf": [
        {
          "const": "solid",
          "description": "Solid (the default).",
          "type": "string"
        },
        {
          "const": "dash42",
          "description": "Dash 4, gap 2 (× pen width).",
          "type": "string"
        },
        {
          "const": "dot12",
          "description": "Dot 1, gap 2.",
          "type": "string"
        },
        {
          "const": "dash_dot",
          "description": "Dash-dot.",
          "type": "string"
        }
      ]
    },
    "Dir4": {
      "description": "One of four directions on the sheet.",
      "oneOf": [
        {
          "const": "up",
          "description": "Up (−y).",
          "type": "string"
        },
        {
          "const": "right",
          "description": "Right (+x).",
          "type": "string"
        },
        {
          "const": "down",
          "description": "Down (+y).",
          "type": "string"
        },
        {
          "const": "left",
          "description": "Left (−x).",
          "type": "string"
        }
      ]
    },
    "EllipsePrim": {
      "additionalProperties": true,
      "description": "An ellipse.",
      "properties": {
        "fill": {
          "anyOf": [
            {
              "$ref": "#/$defs/Colour"
            },
            {
              "type": "null"
            }
          ],
          "description": "Fill."
        },
        "rect": {
          "$ref": "#/$defs/Rect",
          "description": "The bounding rectangle."
        },
        "stroke": {
          "anyOf": [
            {
              "$ref": "#/$defs/Stroke"
            },
            {
              "type": "null"
            }
          ],
          "description": "Stroke."
        }
      },
      "required": [
        "rect"
      ],
      "type": "object"
    },
    "Ident": {
      "description": "An identifier: non-empty, one line (no control character U+0000 to U+001F or U+007F to U+009F), without leading or trailing white space (the Unicode White_Space set); interior spaces are allowed (doc 05 §3.2). JSON Schema cannot express Unicode Normalization Form C; the reader rejects non-NFC text.",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000](?:[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000])?$",
      "type": "string"
    },
    "ImagePrim": {
      "additionalProperties": true,
      "description": "An image asset placed in a rectangle.",
      "properties": {
        "asset": {
          "$ref": "#/$defs/Sha256",
          "description": "The asset `assets/<sha256>.<ext>`."
        },
        "rect": {
          "$ref": "#/$defs/Rect",
          "description": "The placement."
        }
      },
      "required": [
        "rect",
        "asset"
      ],
      "type": "object"
    },
    "LinePrim": {
      "additionalProperties": true,
      "description": "A straight line.",
      "properties": {
        "from": {
          "$ref": "#/$defs/Pt2",
          "description": "Start."
        },
        "stroke": {
          "anyOf": [
            {
              "$ref": "#/$defs/Stroke"
            },
            {
              "type": "null"
            }
          ],
          "description": "Stroke; absent means not stroked."
        },
        "to": {
          "$ref": "#/$defs/Pt2",
          "description": "End."
        }
      },
      "required": [
        "from",
        "to"
      ],
      "type": "object"
    },
    "MlText": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "additionalProperties": {
            "minLength": 1,
            "type": "string"
          },
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^(?:[a-z]{2,3}(?:-[a-z]{3}){0,3}|[a-z]{4,8})(?:-[A-Z][a-z]{3})?(?:-(?:[A-Z]{2}|[0-9]{3}))?(?:-(?:[a-z0-9]{5,8}|[0-9][a-z0-9]{3}))*(?:-[a-wy-z0-9](?:-[a-z0-9]{2,8})+)*(?:-x(?:-[a-z0-9]{1,8})+)?$",
            "type": "string"
          },
          "type": "object"
        }
      ],
      "description": "Multilingual text: a neutral string, or an object keyed by canonical BCP 47 tags with non-empty string values (doc 05 §3.2). JSON Schema cannot express that all text is NFC or that the keys are in ascending byte order; the reader rejects both."
    },
    "Nm": {
      "description": "A length in nanometres (doc 05 §3.2). Written without fraction or exponent; JSON Schema cannot tell 5 from 5.0, the reader rejects the latter.",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
    },
    "Orient2": {
      "description": "Orientation: rotation clockwise on the sheet, optionally mirrored (doc 05 §3.2).",
      "enum": [
        "r0",
        "r90",
        "r180",
        "r270",
        "m0",
        "m90",
        "m180",
        "m270"
      ],
      "type": "string"
    },
    "Pen": {
      "description": "A house pen or an explicit width (doc 07 §2.3, FR-SYM-003): `\"p026\"` or `{\"width\": nm}`.",
      "oneOf": [
        {
          "const": "p013",
          "description": "0.13 mm.",
          "type": "string"
        },
        {
          "const": "p018",
          "description": "0.18 mm.",
          "type": "string"
        },
        {
          "const": "p026",
          "description": "0.26 mm.",
          "type": "string"
        },
        {
          "const": "p042",
          "description": "0.42 mm.",
          "type": "string"
        },
        {
          "const": "p052",
          "description": "0.52 mm.",
          "type": "string"
        },
        {
          "const": "p130",
          "description": "1.30 mm.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "An explicit width.",
          "properties": {
            "width": {
              "$ref": "#/$defs/Nm"
            }
          },
          "required": [
            "width"
          ],
          "type": "object"
        }
      ]
    },
    "PinMapEntry": {
      "additionalProperties": true,
      "description": "One pin-map entry: symbol CP `symbol_cp` draws CP `idx` of `function`.",
      "properties": {
        "function": {
          "$ref": "#/$defs/Uuid",
          "description": "The function."
        },
        "idx": {
          "description": "The function's CP index.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "symbol_cp": {
          "description": "The symbol's CP index.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "symbol_cp",
        "function",
        "idx"
      ],
      "type": "object"
    },
    "PolygonPrim": {
      "additionalProperties": true,
      "description": "A polygon.",
      "properties": {
        "closed": {
          "description": "Whether the last point joins the first.",
          "type": "boolean"
        },
        "fill": {
          "anyOf": [
            {
              "$ref": "#/$defs/Colour"
            },
            {
              "type": "null"
            }
          ],
          "description": "Fill."
        },
        "points": {
          "description": "Points in order.",
          "items": {
            "$ref": "#/$defs/Pt2"
          },
          "type": "array"
        },
        "stroke": {
          "anyOf": [
            {
              "$ref": "#/$defs/Stroke"
            },
            {
              "type": "null"
            }
          ],
          "description": "Stroke."
        }
      },
      "required": [
        "points"
      ],
      "type": "object"
    },
    "PolylinePrim": {
      "additionalProperties": true,
      "description": "An open polyline.",
      "properties": {
        "points": {
          "description": "Points in order.",
          "items": {
            "$ref": "#/$defs/Pt2"
          },
          "type": "array"
        },
        "stroke": {
          "anyOf": [
            {
              "$ref": "#/$defs/Stroke"
            },
            {
              "type": "null"
            }
          ],
          "description": "Stroke."
        }
      },
      "required": [
        "points"
      ],
      "type": "object"
    },
    "Primitive": {
      "description": "A graphic primitive in nanometres, relative to its owner's origin (doc 07 §2.3).",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A straight line.",
          "properties": {
            "line": {
              "$ref": "#/$defs/LinePrim"
            }
          },
          "required": [
            "line"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "An open polyline.",
          "properties": {
            "polyline": {
              "$ref": "#/$defs/PolylinePrim"
            }
          },
          "required": [
            "polyline"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A rectangle with optional rounded corners and drop shadow.",
          "properties": {
            "rect": {
              "$ref": "#/$defs/RectPrim"
            }
          },
          "required": [
            "rect"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A circle.",
          "properties": {
            "circle": {
              "$ref": "#/$defs/CirclePrim"
            }
          },
          "required": [
            "circle"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "An ellipse in a bounding rectangle.",
          "properties": {
            "ellipse": {
              "$ref": "#/$defs/EllipsePrim"
            }
          },
          "required": [
            "ellipse"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "An elliptic arc in a bounding rectangle.",
          "properties": {
            "arc": {
              "$ref": "#/$defs/ArcPrim"
            }
          },
          "required": [
            "arc"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A polygon.",
          "properties": {
            "polygon": {
              "$ref": "#/$defs/PolygonPrim"
            }
          },
          "required": [
            "polygon"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A text.",
          "properties": {
            "text": {
              "$ref": "#/$defs/TextPrim"
            }
          },
          "required": [
            "text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "An image asset.",
          "properties": {
            "image": {
              "$ref": "#/$defs/ImagePrim"
            }
          },
          "required": [
            "image"
          ],
          "type": "object"
        }
      ]
    },
    "Pt2": {
      "description": "A point [x, y] in nanometres, y downwards (doc 05 §3.2).",
      "items": false,
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        }
      ],
      "type": "array"
    },
    "Rect": {
      "description": "A rectangle [[x0, y0], [x1, y1]] in nanometres, minimum corner first (doc 05 §3.2).",
      "items": false,
      "minItems": 2,
      "prefixItems": [
        {
          "$ref": "#/$defs/Pt2"
        },
        {
          "$ref": "#/$defs/Pt2"
        }
      ],
      "type": "array"
    },
    "RectPrim": {
      "additionalProperties": true,
      "description": "A rectangle.",
      "properties": {
        "fill": {
          "anyOf": [
            {
              "$ref": "#/$defs/Colour"
            },
            {
              "type": "null"
            }
          ],
          "description": "Fill; absent means not filled."
        },
        "rect": {
          "$ref": "#/$defs/Rect",
          "description": "The rectangle."
        },
        "rx": {
          "$ref": "#/$defs/Nm",
          "description": "Horizontal corner radius."
        },
        "ry": {
          "$ref": "#/$defs/Nm",
          "description": "Vertical corner radius."
        },
        "shadow": {
          "anyOf": [
            {
              "$ref": "#/$defs/Nm"
            },
            {
              "type": "null"
            }
          ],
          "description": "Offset of the filled drop shadow (FR-SYM-003)."
        },
        "stroke": {
          "anyOf": [
            {
              "$ref": "#/$defs/Stroke"
            },
            {
              "type": "null"
            }
          ],
          "description": "Stroke."
        }
      },
      "required": [
        "rect"
      ],
      "type": "object"
    },
    "RepType": {
      "description": "Representation types (doc 03 §6, doc 07 §2.3). `panel_front` is a symbol type only: panel-front\nrepresentations are derived, never stored (ADR-0006 amendment 3).",
      "oneOf": [
        {
          "const": "multi_line",
          "description": "Multi-line (the default).",
          "type": "string"
        },
        {
          "const": "single_line",
          "description": "Single-line.",
          "type": "string"
        },
        {
          "const": "overview",
          "description": "Overview.",
          "type": "string"
        },
        {
          "const": "fluid",
          "description": "Fluid.",
          "type": "string"
        },
        {
          "const": "topology",
          "description": "Bus topology.",
          "type": "string"
        },
        {
          "const": "contact_image",
          "description": "Contact image.",
          "type": "string"
        },
        {
          "const": "panel_front",
          "description": "Panel front (symbol graphics only).",
          "type": "string"
        },
        {
          "const": "strip_segment",
          "description": "Strip segment.",
          "type": "string"
        },
        {
          "const": "graphic",
          "description": "Graphic.",
          "type": "string"
        }
      ]
    },
    "Rgb": {
      "pattern": "^#[0-9a-f]{6}$",
      "type": "string"
    },
    "Sha256": {
      "description": "A SHA-256 digest sha256:<64 lower-case hex> (doc 05 §3.2).",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "SlotKind": {
      "description": "What a text slot prints (doc 07 §2.3).",
      "oneOf": [
        {
          "const": "tag",
          "description": "Device tag.",
          "type": "string"
        },
        {
          "const": "function_text",
          "description": "Function text.",
          "type": "string"
        },
        {
          "const": "tech_data",
          "description": "Technical data.",
          "type": "string"
        },
        {
          "const": "manufacturer",
          "description": "Manufacturer.",
          "type": "string"
        },
        {
          "const": "part_number",
          "description": "Part number.",
          "type": "string"
        },
        {
          "const": "type_designation",
          "description": "Type designation.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "Designation of CP `idx`.",
          "properties": {
            "cp_designation": {
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "cp_designation"
          ],
          "type": "object"
        },
        {
          "const": "xref",
          "description": "Cross-reference.",
          "type": "string"
        },
        {
          "const": "plc_address",
          "description": "PLC address.",
          "type": "string"
        },
        {
          "const": "process_tag",
          "description": "Process tag.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "A user property.",
          "properties": {
            "user_prop": {
              "$ref": "#/$defs/Ident"
            }
          },
          "required": [
            "user_prop"
          ],
          "type": "object"
        },
        {
          "const": "contact_image",
          "description": "Contact image.",
          "type": "string"
        },
        {
          "const": "order_code",
          "description": "The order code of the device's first assembly config (doc 10 §6 folio 3, doc 20 §11.1, D-36).",
          "type": "string"
        },
        {
          "const": "bus_address",
          "description": "The station address of the drawn function's bus port, \"Node TBD\" or \"Node 3\" (doc 20 §11.1, FR-BUS-006;\nWP-S1.21 D11); empty for a port without an address.",
          "type": "string"
        },
        {
          "const": "bus_termination",
          "description": "The termination of the drawn function's bus port, `Switch to \"ON\"` (FR-BUS-004; WP-S1.21 D11); empty for a\nport without a termination switch.",
          "type": "string"
        }
      ]
    },
    "SlotOverride": {
      "additionalProperties": true,
      "description": "An override of one text slot of the symbol (by index into `SymbolDef.text_slots`).",
      "properties": {
        "angle": {
          "anyOf": [
            {
              "$ref": "#/$defs/Angle2"
            },
            {
              "type": "null"
            }
          ],
          "description": "Rotated text."
        },
        "pos": {
          "anyOf": [
            {
              "$ref": "#/$defs/Pt2"
            },
            {
              "type": "null"
            }
          ],
          "description": "Moved position, in symbol coordinates (before the representation's orientation is applied)."
        },
        "slot": {
          "description": "The slot index.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "visible": {
          "description": "Shown or hidden against the symbol's default.",
          "type": [
            "boolean",
            "null"
          ]
        }
