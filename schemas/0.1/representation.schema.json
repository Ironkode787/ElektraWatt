    "Uuid": {
      "description": "A lower-case hyphenated UUID (doc 05 §3.2).",
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "One drawing of one or more functions on a page (ADR-0006, doc 03 §6, rank 33). An unplaced function has\nno representation; panel fronts are derived, never stored.\n\nNot in v0: `assembly_view` (assembly overviews, WP-S1.13).",
  "properties": {
    "$k": {
      "const": "representation",
      "description": "The kind name; always the first member."
    },
    "$v": {
      "description": "Per-kind schema version `$v`, omitted when 1.",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "anchor": {
      "anyOf": [
        {
          "$ref": "#/$defs/AnchorPolicy"
        },
        {
          "type": "null"
        }
      ],
      "description": "The cross-reference anchor policy of this representation (FR-SYM-010, D-14, MF-13); absent: the symbol\ncopy's policy. Set by `rep.set_anchor_policy`; an optional member without cascade semantics, additive\nwithin format 0.1 (ADR-0011 amendment 4, decision log ID-334)."
    },
    "arrangement": {
      "anyOf": [
        {
          "$ref": "#/$defs/Ident"
        },
        {
          "type": "null"
        }
      ],
      "description": "Named slot set of the symbol (FR-SYM-012)."
    },
    "box": {
      "anyOf": [
        {
          "$ref": "#/$defs/BoxSpec"
        },
        {
          "type": "null"
        }
      ],
      "description": "Black-box outline and CPs, drawn with the built-in symbol `ew.gen.blackbox`."
    },
    "functions": {
      "description": "The functions drawn, in model order.",
      "items": {
        "$ref": "#/$defs/Uuid"
      },
      "type": "array"
    },
    "id": {
      "$ref": "#/$defs/Uuid",
      "description": "The record ID."
    },
    "orient": {
      "$ref": "#/$defs/Orient2",
      "description": "Orientation."
    },
    "page": {
      "$ref": "#/$defs/Uuid",
      "description": "The page."
    },
    "pin_map": {
      "description": "Symbol CP → function CP, keyed by symbol CP.",
      "items": {
        "$ref": "#/$defs/PinMapEntry"
      },
      "type": "array"
    },
    "pos": {
      "$ref": "#/$defs/Pt2",
      "description": "Insertion point."
    },
    "rep_type": {
      "$ref": "#/$defs/RepType",
      "description": "Representation type; default multi-line."
    },
    "source_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceRef"
        },
        {
          "type": "null"
        }
      ],
