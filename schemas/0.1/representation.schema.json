      },
      "type": "array"
    },
    "variant": {
      "description": "The stored symbol variant (contact-image and CP variants); orientation variants A–H are derived.",
      "format": "uint8",
      "maximum": 255,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "$k",
    "id",
    "functions",
    "page",
    "symbol",
    "pos"
  ],
  "title": "representation",
  "type": "object"
}
