error-image-file = Cannot read the image file { $p0 }: { $p1 }.
error-image-too-large = The image { $p0 } is larger than { $p1 } KiB (the limit of an image the project stores).
error-image-refused = The image { $p0 } is not accepted: { $p1 }.
