  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`layout.enclosure.edit` (`EditEnclosure`, FT-840): moves an enclosure in its layout space. The pose is a translation\nwith the identity rotation at this version (ruling 7: bayed suites are 1.x). Nothing else changes. Rejected: an\nenclosure that does not exist (`/enclosure`); a turned pose. Interactive. Outcome: the enclosure.",
  "properties": {
    "enclosure": {
      "$ref": "#/$defs/CmdUuid",
      "description": "The enclosure."
    },
    "pose": {
      "$ref": "#/$defs/CmdPose3",
      "description": "The new pose in the space: a translation."
    }
  },
  "required": [
    "enclosure",
    "pose"
  ],
  "title": "layout.enclosure.edit",
  "type": "object"
}
