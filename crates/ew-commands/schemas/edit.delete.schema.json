  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`edit.delete`: removes the selected records with everything the delete policies take along\n(FR-DEV-030): each target in order through `TxBuilder::delete`; a target already removed by an earlier\ntarget's cascade is skipped. Deleting a representation leaves its function unplaced (an IP function goes\nwith it); deleting a device removes its functions, their representations and connections. A target that\ndoes not exist at the start is `NotFound`; a forbid link (a strip with terminals, a referenced structure\nnode) rejects the whole command (`ModelError::Referenced`). Cost: `Bulk` above 500 targets. Outcome:\nnone.",
  "properties": {
    "targets": {
      "description": "The selected records, at least one.",
      "items": {
        "$ref": "#/$defs/TargetRef"
      },
      "type": "array"
    }
  },
  "required": [
    "targets"
  ],
  "title": "edit.delete",
  "type": "object"
}
