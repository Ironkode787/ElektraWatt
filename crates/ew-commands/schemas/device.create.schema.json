{
  "$defs": {
    "AccessoryKind": {
      "description": "Kind of a strip accessory.",
      "oneOf": [
        {
          "const": "end_plate",
          "description": "End plate.",
          "type": "string"
        },
        {
          "const": "end_clamp",
          "description": "End clamp (end bracket).",
          "type": "string"
        },
        {
          "const": "partition",
          "description": "Partition plate.",
          "type": "string"
        },
        {
          "const": "marker",
          "description": "Marker carrier.",
          "type": "string"
        },
        {
          "const": "cover",
          "description": "Cover.",
          "type": "string"
        }
      ]
    },
    "CmdIdent": {
      "description": "An identifier: non-empty, one line, NFC, without leading or trailing white space (doc 05 §3.2).",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000](?:[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000])?$",
      "type": "string"
    },
    "CmdMlText": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "additionalProperties": {
            "minLength": 1,
            "type": "string"
          },
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^(?:[a-z]{2,3}(?:-[a-z]{3}){0,3}|[a-z]{4,8})(?:-[A-Z][a-z]{3})?(?:-(?:[A-Z]{2}|[0-9]{3}))?(?:-(?:[a-z0-9]{5,8}|[0-9][a-z0-9]{3}))*(?:-[a-wy-z0-9](?:-[a-z0-9]{2,8})+)*(?:-x(?:-[a-z0-9]{1,8})+)?$",
            "type": "string"
          },
          "type": "object"
        }
      ],
      "description": "Multilingual text: a neutral string, or an object keyed by canonical BCP 47 tags in ascending order with non-empty string values (doc 05 §3.2)."
    },
    "CmdUuid": {
      "description": "A lower-case hyphenated UUID naming a record (doc 05 §3.2).",
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "Dec3": {
      "description": "A canonical decimal string: at most three fraction digits, no trailing fraction zeros, no leading zeros, no plus sign, no \"-0\", no exponent, no white space, no unit (doc 05 §3.2). The pattern bounds the integer part to 16 digits; the exact i64 range of the thousandths (about 9.2 x 10^15) is checked by the reader.",
      "maxLength": 21,
      "pattern": "^(?:0|-?[1-9][0-9]{0,15}(?:\\.[0-9]{0,2}[1-9])?|-?0\\.[0-9]{0,2}[1-9])$",
      "type": "string"
    },
    "DeviceKind": {
      "description": "A device's UI and numbering hint. Doc 03 enumerates only these kinds so far; others are kept as\n[`DeviceKind::Unknown`] until the list is decided.",
      "oneOf": [
        {
          "const": "psu",
          "description": "Power supply.",
          "type": "string"
        },
        {
          "const": "terminal",
          "description": "Terminal.",
          "type": "string"
        },
        {
          "const": "blanking_plate",
          "description": "Blank manifold or valve-terminal position (doc 11 §2.7).",
          "type": "string"
        }
      ]
    },
    "Ident": {
      "description": "An identifier: non-empty, one line (no control character U+0000 to U+001F or U+007F to U+009F), without leading or trailing white space (the Unicode White_Space set); interior spaces are allowed (doc 05 §3.2). JSON Schema cannot express Unicode Normalization Form C; the reader rejects non-NFC text.",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000](?:[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000])?$",
      "type": "string"
    },
    "LabelMode": {
      "description": "What the terminals of a strip print.",
      "oneOf": [
        {
          "const": "designation",
          "description": "The terminal designation (the default).",
          "type": "string"
        },
        {
          "const": "function_text",
          "description": "The terminal's function text (\"1+\", FR-TRM-021).",
          "type": "string"
        }
      ]
    },
    "MlText": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "additionalProperties": {
            "minLength": 1,
            "type": "string"
          },
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^(?:[a-z]{2,3}(?:-[a-z]{3}){0,3}|[a-z]{4,8})(?:-[A-Z][a-z]{3})?(?:-(?:[A-Z]{2}|[0-9]{3}))?(?:-(?:[a-z0-9]{5,8}|[0-9][a-z0-9]{3}))*(?:-[a-wy-z0-9](?:-[a-z0-9]{2,8})+)*(?:-x(?:-[a-z0-9]{1,8})+)?$",
            "type": "string"
          },
          "type": "object"
        }
      ],
      "description": "Multilingual text: a neutral string, or an object keyed by canonical BCP 47 tags with non-empty string values (doc 05 §3.2). JSON Schema cannot express that all text is NFC or that the keys are in ascending byte order; the reader rejects both."
    },
    "PartRef": {
      "additionalProperties": true,
      "description": "A part on a device (doc 03 §7): the embedded copy and an optional part variant (FR-PRT-003).",
      "properties": {
        "copy": {
          "$ref": "#/$defs/Uuid",
          "description": "The copy ID of the embedded part, `v5(NS_LIBCOPY, library ‖ item)`."
        },
        "variant": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ident"
            },
            {
              "type": "null"
            }
          ],
          "description": "A variant key of the part."
        }
      },
      "required": [
        "copy"
      ],
      "type": "object"
    },
    "PartUse": {
      "additionalProperties": true,
      "description": "A part use on a device (ADR-0006): the part and its quantity in the part's order unit.",
      "properties": {
        "part": {
          "$ref": "#/$defs/PartRef",
          "description": "The part."
        },
        "qty": {
          "$ref": "#/$defs/Dec3",
          "description": "The quantity in the part's order unit (pieces, metres, sets)."
        }
      },
      "required": [
        "part",
        "qty"
      ],
      "type": "object"
    },
    "Side": {
      "description": "A terminal side (doc 08 §2.1: side 1 is internal and side 2 external unless `Strip.field_side` says\notherwise).",
      "oneOf": [
        {
          "const": "side1",
          "description": "Side 1.",
          "type": "string"
        },
        {
          "const": "side2",
          "description": "Side 2.",
          "type": "string"
        }
      ]
    },
    "Slot": {
      "anyOf": [
        {
          "$ref": "#/$defs/Uuid"
        },
        {
          "const": "none"
        }
      ],
      "description": "A structure slot: a structure node ID or \"none\"; absent means inherit (doc 05 §3.2)."
    },
    "Strip": {
      "additionalProperties": true,
      "description": "The `Strip` aspect (doc 03 §11).",
      "properties": {
        "accessories": {
          "description": "Accessories in mounting order (FR-TRM-016).",
          "items": {
            "$ref": "#/$defs/StripAccessory"
          },
          "type": "array"
        },
        "designation_scheme": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ident"
            },
            {
              "type": "null"
            }
          ],
          "description": "Terminal designation scheme (FR-NUM-024)."
        },
        "field_side": {
          "$ref": "#/$defs/Side",
          "description": "The terminal side facing the field; default side 2 (FR-TRM-012)."
        },
        "groups": {
          "description": "Range captions (\"Pneumatics\", \"Spare\"; FR-TRM-010).",
          "items": {
            "$ref": "#/$defs/TerminalGroup"
          },
          "type": "array"
        },
        "label_mode": {
          "$ref": "#/$defs/LabelMode",
          "description": "What terminals print; default the designation."
        },
        "tag_print": {
          "$ref": "#/$defs/TagPrint",
          "description": "Where the strip tag prints; default once per segment."
        }
      },
      "type": "object"
    },
    "StripAccessory": {
      "additionalProperties": true,
      "description": "One strip accessory placed after terminal `after_seq`.",
      "properties": {
        "after_seq": {
          "description": "The terminal sequence number it follows.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/AccessoryKind",
          "description": "The accessory kind."
        },
        "part": {
          "$ref": "#/$defs/PartRef",
          "description": "The part."
        }
      },
      "required": [
        "after_seq",
        "kind",
        "part"
      ],
      "type": "object"
    },
    "StructureAssignment": {
      "additionalProperties": true,
      "description": "Which structure node a page, device or structure box belongs to, one slot per aspect (doc 03 §5).\nMembers follow the canonical aspect order of `ew_rds::Aspect`; the product aspect is the device tree and\nhas no slot.\n\n```\nuse ew_schema::StructureAssignment;\n\nlet s: StructureAssignment = serde_json::from_str(\n    r#\"{\"function\":\"7d2c95e0-1f4a-5b38-a6e7-0c93b5d1f284\",\"location\":\"none\"}\"#,\n).unwrap();\nassert!(s.installation_site.is_none()); // absent: inherit\n```",
      "properties": {
        "document_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/Slot"
            },
            {
              "type": "null"
            }
          ],
          "description": "`&` (pages only)."
        },
        "function": {
          "anyOf": [
            {
              "$ref": "#/$defs/Slot"
            },
            {
              "type": "null"
            }
          ],
          "description": "`=`"
        },
        "functional_assignment": {
          "anyOf": [
            {
              "$ref": "#/$defs/Slot"
            },
            {
              "type": "null"
            }
          ],
          "description": "`==`"
        },
        "installation_site": {
          "anyOf": [
            {
              "$ref": "#/$defs/Slot"
            },
            {
              "type": "null"
            }
          ],
          "description": "`++`"
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/Slot"
            },
            {
              "type": "null"
            }
          ],
          "description": "`+`"
        },
        "type": {
          "anyOf": [
            {
              "$ref": "#/$defs/Slot"
            },
            {
              "type": "null"
            }
          ],
          "description": "`%`"
        },
        "user_defined": {
          "anyOf": [
            {
              "$ref": "#/$defs/Slot"
            },
            {
              "type": "null"
            }
          ],
          "description": "`#`"
        }
      },
      "type": "object"
    },
    "TagPrint": {
      "description": "Where a strip prints its tag (FR-TRM-011).",
      "oneOf": [
        {
          "const": "per_segment",
          "description": "Once per strip segment (the default).",
          "type": "string"
        },
        {
          "const": "per_page",
          "description": "Once per page.",
          "type": "string"
        }
      ]
    },
    "TerminalGroup": {
      "additionalProperties": true,
      "description": "A caption over a range of terminals.",
      "properties": {
        "from_seq": {
          "description": "First terminal sequence number.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "label": {
          "$ref": "#/$defs/MlText",
          "description": "The caption."
        },
        "to_seq": {
          "description": "Last terminal sequence number.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "from_seq",
        "to_seq",
        "label"
      ],
      "type": "object"
    },
    "Uuid": {
      "description": "A lower-case hyphenated UUID (doc 05 §3.2).",
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`device.create`: a device without a representation (FR-DEV-001), optionally with its main function.\n\nCreates `Device {tag: {letter, counter}, kind, parts, function_text, structure, strip aspect}` and, with\n`main_fndef`, `Function {device, def: main_fndef, role: main, kind: normal}`. An explicit `counter` is\nkept (a typed tag); without one the device stays unnumbered until its main function is placed (online\nnumbering, normaliser #4). The part copies and the FnDef copy must exist. Outcome: the device.",
  "properties": {
    "counter": {
      "description": "An explicit counter.",
      "format": "uint32",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "function_text": {
      "$ref": "#/$defs/CmdMlText",
      "description": "Manual function text."
    },
    "kind": {
      "anyOf": [
        {
          "$ref": "#/$defs/DeviceKind"
        },
        {
          "type": "null"
        }
      ],
      "description": "UI and numbering hint."
    },
    "letter": {
      "$ref": "#/$defs/CmdIdent",
      "description": "The letter code (\"F\")."
    },
    "main_fndef": {
      "anyOf": [
        {
          "$ref": "#/$defs/CmdUuid"
        },
        {
          "type": "null"
        }
      ],
      "description": "The FnDef copy of the main function to create."
    },
    "parts": {
      "description": "Part uses.",
      "items": {
        "$ref": "#/$defs/PartUse"
      },
      "type": "array"
    },
    "strip": {
      "anyOf": [
        {
          "$ref": "#/$defs/Strip"
        },
        {
          "type": "null"
        }
      ],
      "description": "The strip aspect, for a terminal strip."
    },
    "structure": {
      "$ref": "#/$defs/StructureAssignment",
      "description": "Own structure assignment."
    }
  },
  "required": [
    "letter"
  ],
  "title": "device.create",
  "type": "object"
}
