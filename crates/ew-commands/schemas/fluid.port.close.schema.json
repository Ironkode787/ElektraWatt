{
  "$defs": {
    "ClosureKindParam": {
      "description": "The kind of a [`ClosureParam`].",
      "oneOf": [
        {
          "const": "plug",
          "description": "A plug.",
          "type": "string"
        },
        {
          "const": "silencer",
          "description": "A silencer.",
          "type": "string"
        },
        {
          "const": "blanked",
          "description": "Blanked.",
          "type": "string"
        }
      ]
    },
    "ClosureParam": {
      "additionalProperties": false,
      "description": "The closure of [`ClosePort`].",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ClosureKindParam",
          "description": "Plug, silencer or blanked."
        },
        "part": {
          "anyOf": [
            {
              "$ref": "#/$defs/CmdUuid"
            },
            {
              "type": "null"
            }
          ],
          "description": "The plug's or silencer's part copy ID; optional."
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "CmdUuid": {
      "description": "A lower-case hyphenated UUID naming a record (doc 05 §3.2).",
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`fluid.port.close` (`ClosePort`, doc 11 §4.3, WP-S1.20 D10, FR-FLU-028): closes a fluid port with a plug, a\nsilencer or a blanking (`CpOverride.closure`), or opens it again without `closure`.\n\nA closed port is exempt from EW-FL-001. Refused: a CP that is no fluid port; a fluid port with a fluid line (when\nclosing); a part copy the project does not hold (`NotFound`). Opening a port whose override then holds nothing\nelse removes the override. Interactive, one undo step. Outcome: the function.",
  "properties": {
    "closure": {
      "anyOf": [
        {
          "$ref": "#/$defs/ClosureParam"
        },
        {
          "type": "null"
        }
      ],
      "description": "The closure; absent opens the port."
    },
    "function": {
      "$ref": "#/$defs/CmdUuid",
      "description": "The function."
    },
    "idx": {
      "description": "The CP index.",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "function",
    "idx"
  ],
  "title": "fluid.port.close",
  "type": "object"
}
