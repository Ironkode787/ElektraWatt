{
  "$defs": {
    "AlignParam": {
      "description": "The horizontal alignment of a free text at its point.",
      "oneOf": [
        {
          "const": "left",
          "description": "The text starts at the point.",
          "type": "string"
        },
        {
          "const": "centre",
          "description": "The text is centred on the point.",
          "type": "string"
        },
        {
          "const": "right",
          "description": "The text ends at the point.",
          "type": "string"
        }
      ]
    },
    "CmdAngle2": {
      "description": "An angle in 10^-3 degree, counter-clockwise on the sheet (doc 05 §3.2).",
      "maximum": 2147483647,
      "minimum": -2147483648,
      "type": "integer"
    },
    "CmdIdent": {
      "description": "An identifier: non-empty, one line, NFC, without leading or trailing white space (doc 05 §3.2).",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000](?:[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000])?$",
      "type": "string"
    },
    "CmdMlText": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "additionalProperties": {
            "minLength": 1,
            "type": "string"
          },
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^(?:[a-z]{2,3}(?:-[a-z]{3}){0,3}|[a-z]{4,8})(?:-[A-Z][a-z]{3})?(?:-(?:[A-Z]{2}|[0-9]{3}))?(?:-(?:[a-z0-9]{5,8}|[0-9][a-z0-9]{3}))*(?:-[a-wy-z0-9](?:-[a-z0-9]{2,8})+)*(?:-x(?:-[a-z0-9]{1,8})+)?$",
            "type": "string"
          },
          "type": "object"
        }
      ],
      "description": "Multilingual text: a neutral string, or an object keyed by canonical BCP 47 tags in ascending order with non-empty string values (doc 05 §3.2)."
    },
    "CmdNm": {
      "description": "A length in nanometres (doc 05 §3.2).",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
    },
    "CmdPt2": {
      "description": "A point or a displacement [x, y] in nanometres, y downwards (doc 05 §3.2).",
      "items": false,
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        }
      ],
      "type": "array"
    },
    "CmdUuid": {
      "description": "A lower-case hyphenated UUID naming a record (doc 05 §3.2).",
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "DashParam": {
      "description": "The dash pattern of a graphic.",
      "oneOf": [
        {
          "const": "solid",
          "description": "Solid (the default).",
          "type": "string"
        },
        {
          "const": "dashed",
          "description": "Dashed.",
          "type": "string"
        },
        {
          "const": "dotted",
          "description": "Dotted.",
          "type": "string"
        },
        {
          "const": "dash_dot",
          "description": "Dash-dot.",
          "type": "string"
        }
      ]
    },
    "FreeTextParam": {
      "additionalProperties": false,
      "description": "A free text of `item.place`.",
      "properties": {
        "align": {
          "anyOf": [
            {
              "$ref": "#/$defs/AlignParam"
            },
            {
              "type": "null"
            }
          ],
          "description": "The horizontal alignment at `at`; default left."
        },
        "angle": {
          "$ref": "#/$defs/CmdAngle2",
          "description": "The angle in 10⁻³ degree: 0, 90000, 180000 or 270000; default 0."
        },
        "at": {
          "$ref": "#/$defs/CmdPt2",
          "description": "The anchor point."
        },
        "bind": {
          "anyOf": [
            {
              "$ref": "#/$defs/CmdIdent"
            },
            {
              "type": "null"
            }
          ],
          "description": "A bindable name (`project.description`, `project.document_title`, `project.drawing_id`, `page.title`,\n`page.folio`, `page.full_name`): the text prints that value instead."
        },
        "style": {
          "anyOf": [
            {
              "$ref": "#/$defs/CmdIdent"
            },
            {
              "type": "null"
            }
          ],
          "description": "The text style; default `text.normal`."
        },
        "text": {
          "$ref": "#/$defs/CmdMlText",
          "description": "The text; may be empty only with `bind`."
        }
      },
      "required": [
        "at"
      ],
      "type": "object"
    },
    "GraphicParam": {
      "additionalProperties": false,
      "description": "A graphic of `item.place`.",
      "properties": {
        "dash": {
          "$ref": "#/$defs/DashParam",
          "description": "The dash pattern; default solid."
        },
        "fill": {
          "description": "Fill a closed shape; default not.",
          "type": "boolean"
        },
        "shape": {
          "$ref": "#/$defs/ShapeParam",
          "description": "The shape."
        },
        "stroke": {
          "anyOf": [
            {
              "$ref": "#/$defs/StrokeParam"
            },
            {
              "type": "null"
            }
          ],
          "description": "The stroke; absent: the page's wire stroke."
        }
      },
      "required": [
        "shape"
      ],
      "type": "object"
    },
    "ImageParam": {
      "additionalProperties": false,
      "description": "An image of `item.place` (WP-S2.04 part 5, FR-SYM-025).",
      "properties": {
        "asset": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sha256"
            },
            {
              "type": "null"
            }
          ],
          "description": "The asset: `sha256:<64 hex>`, one the project holds (doc 05 §13.3). Exactly one of `asset` and `data`."
        },
        "data": {
          "description": "The image file itself, in base64 (RFC 4648 §4), for an image the project does not hold yet: validated and\nstored as the company logo is (`project.company.set`: the formats, the SVG rejecter, the size limits, at most\n512 KiB), in the same transaction. Exactly one of `asset` and `data`.",
          "type": [
            "string",
            "null"
          ]
        },
        "rect": {
          "description": "Two opposite corners of the rectangle the image is drawn in, absolute in page nm (stored with the smaller\ncoordinates first); the rectangle has an area.",
          "items": {
            "$ref": "#/$defs/CmdPt2"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        }
      },
      "required": [
        "rect"
      ],
      "type": "object"
    },
    "ItemKindParam": {
      "description": "What `item.place` places: `{\"graphic\": {…}}`, `{\"free_text\": {…}}` or `{\"image\": {…}}`.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A graphic (FR-SYM-023).",
          "properties": {
            "graphic": {
              "$ref": "#/$defs/GraphicParam"
            }
          },
          "required": [
            "graphic"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A free text (FR-SYM-024).",
          "properties": {
            "free_text": {
              "$ref": "#/$defs/FreeTextParam"
            }
          },
          "required": [
            "free_text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "An image asset in a rectangle (FR-SYM-025, part 5).",
          "properties": {
            "image": {
              "$ref": "#/$defs/ImageParam"
            }
          },
          "required": [
            "image"
          ],
          "type": "object"
        }
      ]
    },
    "Sha256": {
      "description": "A SHA-256 digest sha256:<64 lower-case hex> (doc 05 §3.2).",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "ShapeParam": {
      "description": "A graphic's shape in command parameters, absolute in page nm (the record's encoding).",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A straight line from `a` to `b`.",
          "properties": {
            "line": {
              "additionalProperties": false,
              "properties": {
                "a": {
                  "$ref": "#/$defs/CmdPt2",
                  "description": "Start."
                },
                "b": {
                  "$ref": "#/$defs/CmdPt2",
                  "description": "End."
                }
              },
              "required": [
                "a",
                "b"
              ],
              "type": "object"
            }
          },
          "required": [
            "line"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "An open polyline (at least two distinct points).",
          "properties": {
            "polyline": {
              "additionalProperties": false,
              "properties": {
                "points": {
                  "description": "The points.",
                  "items": {
                    "$ref": "#/$defs/CmdPt2"
                  },
                  "type": "array"
                }
              },
              "required": [
                "points"
              ],
              "type": "object"
            }
          },
          "required": [
            "polyline"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "An axis-parallel rectangle by two opposite corners (stored with `min` the smaller coordinates).",
          "properties": {
            "rect": {
              "additionalProperties": false,
              "properties": {
                "max": {
                  "$ref": "#/$defs/CmdPt2",
                  "description": "The opposite corner."
                },
                "min": {
                  "$ref": "#/$defs/CmdPt2",
                  "description": "One corner."
                }
              },
              "required": [
                "min",
                "max"
              ],
              "type": "object"
            }
          },
          "required": [
            "rect"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A circle.",
          "properties": {
            "circle": {
              "additionalProperties": false,
              "properties": {
                "centre": {
                  "$ref": "#/$defs/CmdPt2",
                  "description": "Centre."
                },
                "r": {
                  "$ref": "#/$defs/CmdNm",
                  "description": "Radius, greater than 0."
                }
              },
              "required": [
                "centre",
                "r"
              ],
              "type": "object"
            }
          },
          "required": [
            "circle"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A circular arc: positive sweeps run counter-clockwise on the sheet (the QET convention).",
          "properties": {
            "arc": {
              "additionalProperties": false,
              "properties": {
                "centre": {
                  "$ref": "#/$defs/CmdPt2",
                  "description": "Centre."
                },
                "r": {
                  "$ref": "#/$defs/CmdNm",
                  "description": "Radius, greater than 0."
                },
                "start": {
                  "$ref": "#/$defs/CmdAngle2",
                  "default": 0,
                  "description": "Start angle in 10⁻³ degree; default 0."
                },
                "sweep": {
                  "$ref": "#/$defs/CmdAngle2",
                  "description": "Sweep in 10⁻³ degree, not 0."
                }
              },
              "required": [
                "centre",
                "r",
                "sweep"
              ],
              "type": "object"
            }
          },
          "required": [
            "arc"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A closed polygon (at least three distinct points).",
          "properties": {
            "polygon": {
              "additionalProperties": false,
              "properties": {
                "points": {
                  "description": "The points.",
                  "items": {
                    "$ref": "#/$defs/CmdPt2"
                  },
                  "type": "array"
                }
              },
              "required": [
                "points"
              ],
              "type": "object"
            }
          },
          "required": [
            "polygon"
          ],
          "type": "object"
        }
      ]
    },
    "StrokeParam": {
      "additionalProperties": false,
      "description": "The stroke of a graphic.",
      "properties": {
        "width": {
          "$ref": "#/$defs/CmdNm",
          "description": "The stroke width, greater than 0."
        }
      },
      "required": [
        "width"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`item.place` (`PlaceItem`, WP-S2.04 §5.1; FR-SYM-023, FR-SYM-024, FR-SYM-025): creates a page item on a page, a\ngraphic (`{\"graphic\": {shape, stroke?, dash?, fill?}}`), a free text (`{\"free_text\": {text, bind?, at, angle?,\nstyle?, align?}}`) or an image (`{\"image\": {asset | data, rect}}`, part 5: an asset of the project's store, or the\nimage file as base64 `data`, which the command validates and stores as the company logo is stored, in the\nrectangle of two opposite corners, stored with the smaller coordinates first), absolute in page nm; a rectangle is\nstored with `min` the smaller coordinates. Rejected: a missing page (not found); a degenerate shape (a zero-length\nline, a polyline or polygon with fewer than two or three distinct points, a rectangle without area, a radius of 0,\nan arc without sweep) or a stroke width of 0 or less, at\n`/kind/graphic`; a `bind` that is not one of the six bindable names, an empty `text` without `bind`, or an angle\nother than 0, 90000, 180000 or 270000, at `/kind/free_text`; an image with both or neither of `asset` and `data`, or\nwhose rectangle has no area, at `/kind/image`; one whose asset the project does not hold, at `/kind/image/asset`;\none whose `data` is no accepted image file (the logo's checks and texts), at `/kind/image/data`. Interactive.\nOutcome: the item.",
  "properties": {
    "kind": {
      "$ref": "#/$defs/ItemKindParam",
      "description": "What to place."
    },
    "page": {
      "$ref": "#/$defs/CmdUuid",
      "description": "The page."
    }
  },
  "required": [
    "page",
    "kind"
  ],
  "title": "item.place",
  "type": "object"
}
