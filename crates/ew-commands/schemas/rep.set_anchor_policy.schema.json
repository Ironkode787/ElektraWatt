{
  "$defs": {
    "AnchorPolicy": {
      "description": "Where a symbol's cross-reference anchor lies (FR-SYM-010).",
      "oneOf": [
        {
          "const": "origin",
          "description": "The symbol origin (the default).",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "The position of a text slot.",
          "properties": {
            "slot": {
              "$ref": "#/$defs/SlotKind"
            }
          },
          "required": [
            "slot"
          ],
          "type": "object"
        },
        {
          "const": "graphic_centre",
          "description": "The centre of the graphics.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "A named point.",
          "properties": {
            "named": {
              "$ref": "#/$defs/Pt2"
            }
          },
          "required": [
            "named"
          ],
          "type": "object"
        }
      ]
    },
    "CmdUuid": {
      "description": "A lower-case hyphenated UUID naming a record (doc 05 §3.2).",
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "Ident": {
      "description": "An identifier: non-empty, one line (no control character U+0000 to U+001F or U+007F to U+009F), without leading or trailing white space (the Unicode White_Space set); interior spaces are allowed (doc 05 §3.2). JSON Schema cannot express Unicode Normalization Form C; the reader rejects non-NFC text.",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000](?:[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000])?$",
      "type": "string"
    },
    "Pt2": {
      "description": "A point [x, y] in nanometres, y downwards (doc 05 §3.2).",
      "items": false,
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        }
      ],
      "type": "array"
    },
    "SlotKind": {
      "description": "What a text slot prints (doc 07 §2.3).",
      "oneOf": [
        {
          "const": "tag",
          "description": "Device tag.",
          "type": "string"
        },
        {
          "const": "function_text",
          "description": "Function text.",
          "type": "string"
        },
        {
          "const": "tech_data",
          "description": "Technical data.",
          "type": "string"
        },
        {
          "const": "manufacturer",
          "description": "Manufacturer.",
          "type": "string"
        },
        {
          "const": "part_number",
          "description": "Part number.",
          "type": "string"
        },
        {
          "const": "type_designation",
          "description": "Type designation.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "Designation of CP `idx`.",
          "properties": {
            "cp_designation": {
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "cp_designation"
          ],
          "type": "object"
        },
        {
          "const": "xref",
          "description": "Cross-reference.",
          "type": "string"
        },
        {
          "const": "plc_address",
          "description": "PLC address.",
          "type": "string"
        },
        {
          "const": "process_tag",
          "description": "Process tag.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "A user property.",
          "properties": {
            "user_prop": {
              "$ref": "#/$defs/Ident"
            }
          },
          "required": [
            "user_prop"
          ],
          "type": "object"
        },
        {
          "const": "contact_image",
          "description": "Contact image.",
          "type": "string"
        },
        {
          "const": "order_code",
          "description": "The order code of the device's first assembly config (doc 10 §6 folio 3, doc 20 §11.1, D-36).",
          "type": "string"
        },
        {
          "const": "bus_address",
          "description": "The station address of the drawn function's bus port, \"Node TBD\" or \"Node 3\" (doc 20 §11.1, FR-BUS-006;\nWP-S1.21 D11); empty for a port without an address.",
          "type": "string"
        },
        {
          "const": "bus_termination",
          "description": "The termination of the drawn function's bus port, `Switch to \"ON\"` (FR-BUS-004; WP-S1.21 D11); empty for a\nport without a termination switch.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`rep.set_anchor_policy`: sets the cross-reference anchor policy of representations (FR-SYM-010; the\nquick fix of MF-13, doc 07 §3.6).\n\nThe policy is a per-representation override, `Representation.anchor` (owner ruling, cycle 14): `anchor`\nis `origin`, `graphic_centre`, `{\"slot\": <kind>}` or `{\"named\": [x, y]}`, and `null` removes the override,\nso the representation follows its symbol copy's policy again. Other representations of the same symbol\ncopy keep theirs. A representation that already holds the value is left untouched. Rejections: an empty\nor duplicated `reps` list, an unknown (newer-format) policy; a missing representation is not found. Cost:\ninteractive. Outcome: none.",
  "properties": {
    "anchor": {
      "anyOf": [
        {
          "$ref": "#/$defs/AnchorPolicy"
        },
        {
          "type": "null"
        }
      ],
      "description": "The cross-reference anchor policy (FR-SYM-010): `origin`, `graphic_centre`, `{\"slot\": <kind>}`,\n`{\"named\": [x, y]}`; `null` resets to the symbol copy's policy."
    },
    "reps": {
      "description": "The representations, at least one; each at most once.",
      "items": {
        "$ref": "#/$defs/CmdUuid"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "reps"
  ],
  "title": "rep.set_anchor_policy",
  "type": "object"
}
