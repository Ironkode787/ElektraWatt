{
  "$defs": {
    "Align": {
      "description": "Text alignment at the anchor point: nine positions.",
      "oneOf": [
        {
          "const": "top_left",
          "description": "Top left.",
          "type": "string"
        },
        {
          "const": "top_centre",
          "description": "Top centre.",
          "type": "string"
        },
        {
          "const": "top_right",
          "description": "Top right.",
          "type": "string"
        },
        {
          "const": "middle_left",
          "description": "Middle left.",
          "type": "string"
        },
        {
          "const": "centre",
          "description": "Centre.",
          "type": "string"
        },
        {
          "const": "middle_right",
          "description": "Middle right.",
          "type": "string"
        },
        {
          "const": "bottom_left",
          "description": "Bottom left.",
          "type": "string"
        },
        {
          "const": "bottom_centre",
          "description": "Bottom centre.",
          "type": "string"
        },
        {
          "const": "bottom_right",
          "description": "Bottom right.",
          "type": "string"
        }
      ]
    },
    "Angle2": {
      "description": "An angle in 10^-3 degree, counter-clockwise on the sheet, within the i32 range (doc 05 §3.2).",
      "maximum": 2147483647,
      "minimum": -2147483648,
      "type": "integer"
    },
    "ArcPrim": {
      "additionalProperties": true,
      "description": "An elliptic arc (QET's arc: bounding rectangle, start angle and sweep, counter-clockwise).",
      "properties": {
        "rect": {
          "$ref": "#/$defs/Rect",
          "description": "The bounding rectangle of the full ellipse."
        },
        "start": {
          "$ref": "#/$defs/Angle2",
          "description": "Start angle."
        },
        "stroke": {
          "anyOf": [
            {
              "$ref": "#/$defs/Stroke"
            },
            {
              "type": "null"
            }
          ],
          "description": "Stroke."
        },
        "sweep": {
          "$ref": "#/$defs/Angle2",
          "description": "Sweep angle."
        }
      },
      "required": [
        "rect",
        "sweep"
      ],
      "type": "object"
    },
    "BoxCp": {
      "additionalProperties": true,
      "description": "One CP of a black box: function CP index, position and direction.",
      "properties": {
        "dir": {
          "$ref": "#/$defs/Dir4",
          "description": "The direction a wire leaves the CP."
        },
        "idx": {
          "description": "The function CP index.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "pos": {
          "$ref": "#/$defs/Pt2",
          "description": "Position relative to the representation."
        }
      },
      "required": [
        "idx",
        "pos",
        "dir"
      ],
      "type": "object"
    },
    "BoxSpec": {
      "additionalProperties": true,
      "description": "The outline, CPs and inner graphics of a black box (doc 03 §6).",
      "properties": {
        "cps": {
          "description": "The box CPs.",
          "items": {
            "$ref": "#/$defs/BoxCp"
          },
          "type": "array"
        },
        "inner": {
          "description": "Graphics inside the box.",
          "items": {
            "$ref": "#/$defs/Primitive"
          },
          "type": "array"
        },
        "outline": {
          "description": "The outline polygon.",
          "items": {
            "$ref": "#/$defs/Pt2"
          },
          "type": "array"
        }
      },
      "required": [
        "outline"
      ],
      "type": "object"
    },
    "CirclePrim": {
      "additionalProperties": true,
      "description": "A circle.",
      "properties": {
        "centre": {
          "$ref": "#/$defs/Pt2",
          "description": "Centre."
        },
        "fill": {
          "anyOf": [
            {
              "$ref": "#/$defs/Colour"
            },
            {
              "type": "null"
            }
          ],
          "description": "Fill."
        },
        "r": {
          "$ref": "#/$defs/Nm",
          "description": "Radius."
        },
        "stroke": {
          "anyOf": [
            {
              "$ref": "#/$defs/Stroke"
            },
            {
              "type": "null"
            }
          ],
          "description": "Stroke."
        }
      },
      "required": [
        "centre",
        "r"
      ],
      "type": "object"
    },
    "CmdIdent": {
      "description": "An identifier: non-empty, one line, NFC, without leading or trailing white space (doc 05 §3.2).",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000](?:[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000])?$",
      "type": "string"
    },
    "CmdOrient2": {
      "description": "Orientation: rotation clockwise on the sheet, optionally mirrored (doc 05 §3.2).",
      "enum": [
        "r0",
        "r90",
        "r180",
        "r270",
        "m0",
        "m90",
        "m180",
        "m270"
      ],
      "type": "string"
    },
    "CmdPt2": {
      "description": "A point or a displacement [x, y] in nanometres, y downwards (doc 05 §3.2).",
      "items": false,
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        }
      ],
      "type": "array"
    },
    "CmdUuid": {
      "description": "A lower-case hyphenated UUID naming a record (doc 05 §3.2).",
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "Colour": {
      "description": "A drawing colour: the layer's colour (the default) or an explicit sRGB value.",
      "oneOf": [
        {
          "const": "by_layer",
          "description": "The layer's colour (the default).",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "An explicit colour.",
          "properties": {
            "rgb": {
              "$ref": "#/$defs/Rgb"
            }
          },
          "required": [
            "rgb"
          ],
          "type": "object"
        }
      ]
    },
    "Dash": {
      "description": "A dash pattern scaled by the pen width (doc 07 §2.3).",
      "oneOf": [
        {
          "const": "solid",
          "description": "Solid (the default).",
          "type": "string"
        },
        {
          "const": "dash42",
          "description": "Dash 4, gap 2 (× pen width).",
          "type": "string"
        },
        {
          "const": "dot12",
          "description": "Dot 1, gap 2.",
          "type": "string"
        },
        {
          "const": "dash_dot",
          "description": "Dash-dot.",
          "type": "string"
        }
      ]
    },
    "DeviceKind": {
      "description": "A device's UI and numbering hint. Doc 03 enumerates only these kinds so far; others are kept as\n[`DeviceKind::Unknown`] until the list is decided.",
      "oneOf": [
        {
          "const": "psu",
          "description": "Power supply.",
          "type": "string"
        },
        {
          "const": "terminal",
          "description": "Terminal.",
          "type": "string"
        },
        {
          "const": "blanking_plate",
          "description": "Blank manifold or valve-terminal position (doc 11 §2.7).",
          "type": "string"
        }
      ]
    },
    "Dir4": {
      "description": "One of four directions on the sheet.",
      "oneOf": [
        {
          "const": "up",
          "description": "Up (−y).",
          "type": "string"
        },
        {
          "const": "right",
          "description": "Right (+x).",
          "type": "string"
        },
        {
          "const": "down",
          "description": "Down (+y).",
          "type": "string"
        },
        {
          "const": "left",
          "description": "Left (−x).",
          "type": "string"
        }
      ]
    },
    "EllipsePrim": {
      "additionalProperties": true,
      "description": "An ellipse.",
      "properties": {
        "fill": {
          "anyOf": [
            {
              "$ref": "#/$defs/Colour"
            },
            {
              "type": "null"
            }
          ],
          "description": "Fill."
        },
        "rect": {
          "$ref": "#/$defs/Rect",
          "description": "The bounding rectangle."
        },
        "stroke": {
          "anyOf": [
            {
              "$ref": "#/$defs/Stroke"
            },
            {
              "type": "null"
            }
          ],
          "description": "Stroke."
        }
      },
      "required": [
        "rect"
      ],
      "type": "object"
    },
    "FnRole": {
      "description": "Main or auxiliary function.",
      "oneOf": [
        {
          "const": "main",
          "description": "The main function (the default).",
          "type": "string"
        },
        {
          "const": "aux",
          "description": "An auxiliary function.",
          "type": "string"
        }
      ]
    },
    "Ident": {
      "description": "An identifier: non-empty, one line (no control character U+0000 to U+001F or U+007F to U+009F), without leading or trailing white space (the Unicode White_Space set); interior spaces are allowed (doc 05 §3.2). JSON Schema cannot express Unicode Normalization Form C; the reader rejects non-NFC text.",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000](?:[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\u0000-\\u0020\\u007F-\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000])?$",
      "type": "string"
    },
    "ImagePrim": {
      "additionalProperties": true,
      "description": "An image asset placed in a rectangle.",
      "properties": {
        "asset": {
          "$ref": "#/$defs/Sha256",
          "description": "The asset `assets/<sha256>.<ext>`."
        },
        "rect": {
          "$ref": "#/$defs/Rect",
          "description": "The placement."
        }
      },
      "required": [
        "rect",
        "asset"
      ],
      "type": "object"
    },
    "LinePrim": {
      "additionalProperties": true,
      "description": "A straight line.",
      "properties": {
        "from": {
          "$ref": "#/$defs/Pt2",
          "description": "Start."
        },
        "stroke": {
          "anyOf": [
            {
              "$ref": "#/$defs/Stroke"
            },
            {
              "type": "null"
            }
          ],
          "description": "Stroke; absent means not stroked."
        },
        "to": {
          "$ref": "#/$defs/Pt2",
          "description": "End."
        }
      },
      "required": [
        "from",
        "to"
      ],
      "type": "object"
    },
    "MlText": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "additionalProperties": {
            "minLength": 1,
            "type": "string"
          },
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^(?:[a-z]{2,3}(?:-[a-z]{3}){0,3}|[a-z]{4,8})(?:-[A-Z][a-z]{3})?(?:-(?:[A-Z]{2}|[0-9]{3}))?(?:-(?:[a-z0-9]{5,8}|[0-9][a-z0-9]{3}))*(?:-[a-wy-z0-9](?:-[a-z0-9]{2,8})+)*(?:-x(?:-[a-z0-9]{1,8})+)?$",
            "type": "string"
          },
          "type": "object"
        }
      ],
      "description": "Multilingual text: a neutral string, or an object keyed by canonical BCP 47 tags with non-empty string values (doc 05 §3.2). JSON Schema cannot express that all text is NFC or that the keys are in ascending byte order; the reader rejects both."
    },
    "Nm": {
      "description": "A length in nanometres (doc 05 §3.2). Written without fraction or exponent; JSON Schema cannot tell 5 from 5.0, the reader rejects the latter.",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
    },
    "Pen": {
      "description": "A house pen or an explicit width (doc 07 §2.3, FR-SYM-003): `\"p026\"` or `{\"width\": nm}`.",
      "oneOf": [
        {
          "const": "p013",
          "description": "0.13 mm.",
          "type": "string"
        },
        {
          "const": "p018",
          "description": "0.18 mm.",
          "type": "string"
        },
        {
          "const": "p026",
          "description": "0.26 mm.",
          "type": "string"
        },
        {
          "const": "p042",
          "description": "0.42 mm.",
          "type": "string"
        },
        {
          "const": "p052",
          "description": "0.52 mm.",
          "type": "string"
        },
        {
          "const": "p130",
          "description": "1.30 mm.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "An explicit width.",
          "properties": {
            "width": {
              "$ref": "#/$defs/Nm"
            }
          },
          "required": [
            "width"
          ],
          "type": "object"
        }
      ]
    },
    "PlaceTarget": {
      "description": "Which device a placed representation belongs to (doc 06 §3.3).",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A new device with a new main function; its counter comes from online numbering.",
          "properties": {
            "new_device": {
              "additionalProperties": false,
              "properties": {
                "fndef": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/CmdUuid"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "The FnDef copy; default the copy the symbol's `fndef` resolves to."
                },
                "kind": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/DeviceKind"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "UI and numbering hint."
                },
                "letter": {
                  "$ref": "#/$defs/CmdIdent",
                  "description": "The letter code (the identifier-set lookup from the FnDef category is WP-S1.11)."
                }
              },
              "required": [
                "letter"
              ],
              "type": "object"
            }
          },
          "required": [
            "new_device"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Another representation of an existing function (FR-DEV-003).",
          "properties": {
            "existing_function": {
              "additionalProperties": false,
              "properties": {
                "function": {
                  "$ref": "#/$defs/CmdUuid",
                  "description": "The function."
                }
              },
              "required": [
                "function"
              ],
              "type": "object"
            }
          },
          "required": [
            "existing_function"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A new function of an existing device (FR-DEV-038).",
          "properties": {
            "join_device": {
              "additionalProperties": false,
              "properties": {
                "device": {
                  "$ref": "#/$defs/CmdUuid",
                  "description": "The device."
                },
                "fndef": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/CmdUuid"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "The FnDef copy; default the copy the symbol's `fndef` resolves to."
                },
                "role": {
                  "$ref": "#/$defs/FnRole",
                  "default": "aux",
                  "description": "The role; default auxiliary."
                }
              },
              "required": [
                "device"
              ],
              "type": "object"
            }
          },
          "required": [
            "join_device"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A new device made from a part copy (part-first placement; FR-UI-017, FR-DEV-017, WP-S2.04 D9): the device\n`{tag: {letter, counter: none}, parts: [the part, quantity 1]}` and one function per entry of the part's\n`function_template`; the representation draws entry `template`, the others stay unplaced.",
          "properties": {
            "from_part": {
              "additionalProperties": false,
              "properties": {
                "letter": {
                  "$ref": "#/$defs/CmdIdent",
                  "description": "The letter code of the new device."
                },
                "part": {
                  "$ref": "#/$defs/CmdUuid",
                  "description": "The part copy."
                },
                "template": {
                  "description": "The 0-based index of the template entry the representation draws.",
                  "format": "uint16",
                  "maximum": 65535,
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "part",
                "template",
                "letter"
              ],
              "type": "object"
            }
          },
          "required": [
            "from_part"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "One new terminal of an existing strip, created as `terminal.add` creates it and placed (`device.place`\nonly; AC-28, WP-S2.04 D9).",
          "properties": {
            "new_terminal": {
              "additionalProperties": false,
              "properties": {
                "designation": {
                  "$ref": "#/$defs/CmdIdent",
                  "description": "The terminal's designation, unique within the strip."
                },
                "seq": {
                  "description": "The sequence number; default one more than the highest in the strip.",
                  "format": "uint32",
                  "minimum": 0,
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "strip": {
                  "$ref": "#/$defs/CmdUuid",
                  "description": "The strip device."
                }
              },
              "required": [
                "strip",
                "designation"
              ],
              "type": "object"
            }
          },
          "required": [
            "new_terminal"
          ],
          "type": "object"
        }
      ]
    },
    "PolygonPrim": {
      "additionalProperties": true,
      "description": "A polygon.",
      "properties": {
        "closed": {
          "description": "Whether the last point joins the first.",
          "type": "boolean"
        },
        "fill": {
          "anyOf": [
            {
              "$ref": "#/$defs/Colour"
            },
            {
              "type": "null"
            }
          ],
          "description": "Fill."
        },
        "points": {
          "description": "Points in order.",
          "items": {
            "$ref": "#/$defs/Pt2"
          },
          "type": "array"
        },
        "stroke": {
          "anyOf": [
            {
              "$ref": "#/$defs/Stroke"
            },
            {
              "type": "null"
            }
          ],
          "description": "Stroke."
        }
      },
      "required": [
        "points"
      ],
      "type": "object"
    },
    "PolylinePrim": {
      "additionalProperties": true,
      "description": "An open polyline.",
      "properties": {
        "points": {
          "description": "Points in order.",
          "items": {
            "$ref": "#/$defs/Pt2"
          },
          "type": "array"
        },
        "stroke": {
          "anyOf": [
            {
              "$ref": "#/$defs/Stroke"
            },
            {
              "type": "null"
            }
          ],
          "description": "Stroke."
        }
      },
      "required": [
        "points"
      ],
      "type": "object"
    },
    "Primitive": {
      "description": "A graphic primitive in nanometres, relative to its owner's origin (doc 07 §2.3).",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A straight line.",
          "properties": {
            "line": {
              "$ref": "#/$defs/LinePrim"
            }
          },
          "required": [
            "line"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "An open polyline.",
          "properties": {
            "polyline": {
              "$ref": "#/$defs/PolylinePrim"
            }
          },
          "required": [
            "polyline"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A rectangle with optional rounded corners and drop shadow.",
          "properties": {
            "rect": {
              "$ref": "#/$defs/RectPrim"
            }
          },
          "required": [
            "rect"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A circle.",
          "properties": {
            "circle": {
              "$ref": "#/$defs/CirclePrim"
            }
          },
          "required": [
            "circle"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "An ellipse in a bounding rectangle.",
          "properties": {
            "ellipse": {
              "$ref": "#/$defs/EllipsePrim"
            }
          },
          "required": [
            "ellipse"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "An elliptic arc in a bounding rectangle.",
          "properties": {
            "arc": {
              "$ref": "#/$defs/ArcPrim"
            }
          },
          "required": [
            "arc"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A polygon.",
          "properties": {
            "polygon": {
              "$ref": "#/$defs/PolygonPrim"
            }
          },
          "required": [
            "polygon"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A text.",
          "properties": {
            "text": {
              "$ref": "#/$defs/TextPrim"
            }
          },
          "required": [
            "text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "An image asset.",
          "properties": {
            "image": {
              "$ref": "#/$defs/ImagePrim"
            }
          },
          "required": [
            "image"
          ],
          "type": "object"
        }
      ]
    },
    "Pt2": {
      "description": "A point [x, y] in nanometres, y downwards (doc 05 §3.2).",
      "items": false,
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        }
      ],
      "type": "array"
    },
    "Rect": {
      "description": "A rectangle [[x0, y0], [x1, y1]] in nanometres, minimum corner first (doc 05 §3.2).",
      "items": false,
      "minItems": 2,
      "prefixItems": [
        {
          "$ref": "#/$defs/Pt2"
        },
        {
          "$ref": "#/$defs/Pt2"
        }
      ],
      "type": "array"
    },
    "RectPrim": {
      "additionalProperties": true,
      "description": "A rectangle.",
      "properties": {
        "fill": {
          "anyOf": [
            {
              "$ref": "#/$defs/Colour"
            },
            {
              "type": "null"
