      "description": "The name (\"PROFIBUS DP\")."
    },
    "rate": {
      "anyOf": [
        {
          "$ref": "#/$defs/BusRate"
        },
        {
          "type": "null"
        }
      ],
      "description": "The data rate in bit/s; absent: unset."
    }
  },
  "required": [
