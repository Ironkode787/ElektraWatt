notice-plc-exchange-taken = uit het bestand overgenomen
notice-plc-exchange-kept = behouden
notice-plc-exchange-created = { $p0 } { $p1 }: ongeplaatst aangemaakt
notice-plc-exchange-parked-several = { $p0 } { $p1 }: geparkeerd (meerdere objecten van het project passen erbij)
notice-plc-exchange-parked-none = { $p0 } { $p1 }: geparkeerd (niets in het project past erbij)
notice-plc-exchange-removed = { $p0 } { $p1 }: niet meer in het bestand (in het project behouden)
notice-plc-row-reserved = { $p0 }: kanaal { $p1 } van { $p2 } gereserveerd
notice-plc-row-reserved-any = { $p0 }: een kanaal gereserveerd
