notice-binding-newer = gekoppeld aan een eindpunt van een nieuwer formaat
notice-binding-none = niet gekoppeld
notice-drives-now = { $p0 } stuurt nu { $p1 } aan
notice-drives-several = de werkpoortleidingen van { $p0 } bereiken { $p1 }; koppel het aangestuurde apparaat met de hand
notice-pin-no-pin = kanaal { $p0 } van { $p1 } is losgekoppeld: artikel { $p2 } geeft het geen pin
notice-pin-taken = kanaal { $p0 } van { $p1 } is losgekoppeld: een ander kanaal is aan zijn pin { $p2 } gekoppeld
