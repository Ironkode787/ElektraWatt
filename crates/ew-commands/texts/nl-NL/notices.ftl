notice-bus-port-keeps = { $p0 } houdt zijn buspoort; { $p1 } geeft { $p2 } { $p3 } op
notice-bus-port-label = { $p0 }:{ $p1 } { $p2 }
notice-bus-port-plain = { $p0 }:{ $p1 }
notice-part = artikel { $p0 }
notice-part-no-number = een artikel zonder nummer
notice-channel-kind-newer = kanaal { $p0 } van module { $p1 } houdt zijn soort van een nieuwer formaat; zijn artikel geeft { $p2 }
notice-channel-kind-changes = kanaal { $p0 } van module { $p1 } verandert van { $p2 } in { $p3 } volgens zijn artikel; het blijft { $p4 }
notice-channel-item = kanaal { $p0 } ({ $p1 })
notice-channel-surplus-one = module { $p0 } houdt 1 overtollig kanaal voorbij de { $p1 } van zijn artikel: { $p2 }; Artikel van PLC-module instellen verwijdert het na zijn voorbeeld
notice-channel-surplus-many = module { $p0 } houdt { $p1 } overtollige kanalen voorbij de { $p2 } van zijn artikel: { $p3 }; Artikel van PLC-module instellen verwijdert ze na zijn voorbeeld
