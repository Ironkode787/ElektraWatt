notice-join-terminal-dropped-many = { $p0 } van de samengevoegde klem zijn ermee vervallen
notice-join-terminal-function-dropped-one = { $p0 } van zijn functie is ermee vervallen
notice-join-terminal-function-dropped-many = { $p0 } van zijn functie zijn ermee vervallen
