notice-fluid-removed = { $p0 } is van ventielplaats { $p1 } van { $p2 } verwijderd
notice-fluid-removed-lines = { $p0 } is van ventielplaats { $p1 } van { $p2 } verwijderd, met { $p3 } leidingen
notice-fluid-coil-unbound = { $p0 } is losgekoppeld: zijn spoel is met { $p1 } meegegaan
notice-medium-deleted = medium { $p0 } is verwijderd
notice-medium-deleted-points = medium { $p0 } is verwijderd, met { $p1 } definitiepunten
notice-join-device-dropped-one = { $p0 } van het samengevoegde apparaat is ermee vervallen
notice-join-device-dropped-many = { $p0 } van het samengevoegde apparaat zijn ermee vervallen
