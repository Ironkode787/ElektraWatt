# The texts of `ew-commands` in en-GB: the notices of a command's outcome: what it dropped or adjusted instead of
# refusing. One message per key; `{ $p0 }`, `{ $p1 }`, ... are the arguments, always strings. The source language and
# the fallback of every other.

# What a command or a normaliser dropped or adjusted instead of refusing (`Outcome.notices`), by key.
notice-words-and = { $p0 } and { $p1 }
notice-none = none
notice-nothing = nothing
notice-bond-wire-lost = the bond between { $p0 } and { $p1 } no longer has its wire: the wire does not run between its two ends any more; choose its conductor again
notice-box-cp-to-vertex = connection point { $p0 } moved to the first vertex of edge { $p1 }, which is not horizontal or vertical
notice-box-cp-edge-gone = connection point { $p0 } moved to edge { $p1 }: its edge { $p2 } no longer exists
notice-box-cp-off-edge = connection point { $p0 } moved to edge { $p1 }: it lay on no edge of the outline
notice-box-cp-not-drawn = connection point { $p0 } is no longer drawn
notice-company-logo-raster = the logo is a { $p0 } raster image: it prints rasterised; an SVG logo prints as vectors
notice-hint-dropped = autoconnect hint { $p0 } dropped: { $p1 } no longer exists
notice-hint-function = the function it connects to
notice-rep-move-keep-pair = { $p0 } is kept as the pair of interruption points { $p1 }
notice-hint-junction = the junction it connects to
notice-hint-wire = the wire it connects to
notice-exchange-slot-dropped = the override of text slot { $p0 } is dropped: the new symbol has no such slot
notice-exchange-cp-not-drawn = function CP { $p0 } is no longer drawn by this representation
notice-fluid-removed = removed { $p0 } from position { $p1 } of { $p2 }
notice-fluid-removed-lines = removed { $p0 } from position { $p1 } of { $p2 } with { $p3 } fluid lines
notice-fluid-coil-unbound = { $p0 } is unbound: its coil went with { $p1 }
notice-medium-deleted = deleted medium { $p0 }
notice-medium-deleted-points = deleted medium { $p0 } with { $p1 } definition points
notice-join-device-dropped-one = the joined device's { $p0 } was dropped with it
notice-join-device-dropped-many = the joined device's { $p0 } were dropped with it
notice-join-function-dropped-one = the old function's { $p0 } was dropped with it
notice-join-function-dropped-many = the old function's { $p0 } were dropped with it
notice-join-terminal-dropped-one = the joined terminal's { $p0 } was dropped with it
notice-join-terminal-dropped-many = the joined terminal's { $p0 } were dropped with it
notice-join-terminal-function-dropped-one = its function's { $p0 } was dropped with it
notice-join-terminal-function-dropped-many = its function's { $p0 } were dropped with it
notice-member-numbering-scheme = numbering scheme
notice-member-frozen-tag = frozen tag
notice-member-kind = kind
notice-member-parent = parent device
notice-member-position = position
notice-member-structure = structure
notice-member-function-text = function text
notice-member-process-tag = process tag
notice-member-tech-data = technical data
notice-member-state = state
notice-member-import-reference = import reference
notice-member-cable = cable data
notice-member-assembly = assembly data
notice-member-plc-station = PLC station data
notice-member-plc-module = PLC module data
notice-member-unknown = unknown members
notice-member-cp-overrides = connection point overrides
notice-member-part = part
notice-member-unplaced-functions = unplaced functions
notice-overview-page = page { $p0 }: { $p1 }
notice-overview-page-new = page { $p0 } (new page): { $p1 }
notice-overview-page-empty = page { $p0 } holds no member of the overview any more
notice-paste-unknown-item = a page item of a kind this version does not know was left out
notice-paste-image = an image was left out: a fragment does not carry its asset
notice-paste-surface-view = a surface view was left out: a panel page has one view, set with Set panel view
notice-paste-underlay = an underlay was left out: it is placed by an import
notice-paste-structure-gone = structure { $p0 } is not in this project: inherits the page
notice-paste-reference-cleared = a reference from { $p0 } to { $p1 } was cleared, because its target was not copied
notice-paste-marker = a wire annotation whose wires were not copied was left out
notice-paste-moved-wire-removed = the wire on { $p0 } that ended at the moved devices is removed
notice-paste-moved-wires-removed = { $p0 } wires on { $p1 } that ended at the moved devices are removed
notice-paste-child = { $p0 } was a child of a device that was not copied
notice-page-moved = { $p0 }
notice-section-made = section { $p0 } { $p1 } (folios { $p2 } to { $p3 }) is made for it
notice-section-made-untitled = section { $p0 } (folios { $p1 } to { $p2 }) is made for it
# A change from one value to another, inside a notice: the window draws the two sides apart.
notice-change = { $p0 } → { $p1 }
notice-asset-removed = removes the asset file of { $p0 }
notice-plc-displaced = { $p0 } was bound to this connection point and is now unbound
notice-plc-channel-same-module = channel { $p0 } of the same module
notice-plc-channel-other-module = channel { $p0 } of another module
notice-plc-channel-another = another channel
notice-plc-no-input-range = module { $p0 } has no input range in its part: the start has no effect until it has one
notice-plc-no-output-range = module { $p0 } has no output range in its part: the start has no effect until it has one
notice-plc-channel-removed = channel { $p0 } of module { $p1 } is removed: beyond its part's { $p2 } channels; it was { $p3 }, { $p4 }
notice-plc-no-symbol = no symbol
notice-plc-symbol = symbol { $p0 }
notice-plc-readdress = channel { $p0 } of { $p1 }: { $p2 }
notice-plc-frozen-one = 1 channel address of configuration project { $p0 } frozen as a manual address
notice-plc-frozen-many = { $p0 } channel addresses of configuration project { $p1 } frozen as manual addresses
notice-plc-keeps-address = channel { $p0 } of { $p1 } keeps its manual address { $p2 } (derived: { $p3 })
notice-plc-keeps-input-start-moves = module { $p0 } keeps its manual input start { $p1 }: as an automatic start it would move the addresses of other modules
notice-plc-keeps-output-start-moves = module { $p0 } keeps its manual output start { $p1 }: as an automatic start it would move the addresses of other modules
notice-plc-keeps-input-start = module { $p0 } keeps its manual input start { $p1 } (automatic: { $p2 })
notice-plc-keeps-output-start = module { $p0 } keeps its manual output start { $p1 } (automatic: { $p2 })
notice-plc-exchange-change = { $p0 }: { $p1 } { $p2 } ({ $p3 }, { $p4 })
notice-plc-exchange-taken = taken from the file
notice-plc-exchange-kept = kept
notice-plc-exchange-created = { $p0 } { $p1 }: created unplaced
notice-plc-exchange-parked-several = { $p0 } { $p1 }: parked (several objects of the project match it)
notice-plc-exchange-parked-none = { $p0 } { $p1 }: parked (nothing in the project matches it)
notice-plc-exchange-removed = { $p0 } { $p1 }: no longer in the file (kept in the project)
notice-plc-row-reserved = { $p0 }: channel { $p1 } of { $p2 } reserved
notice-plc-row-reserved-any = { $p0 }: a channel reserved
notice-plc-row-no-spare = { $p0 }: no spare { $p1 } channel; the tag is an open item (EW-PRC-002)
notice-bus-port-newer = bus port { $p0 } of { $p1 } is of a newer format and was not applied
notice-bus-port-keeps = { $p0 } keeps its bus port; { $p1 } declares { $p2 } { $p3 }
notice-bus-port-label = { $p0 }:{ $p1 } { $p2 }
notice-bus-port-plain = { $p0 }:{ $p1 }
notice-part = part { $p0 }
notice-part-no-number = a part without a number
notice-channel-kind-newer = channel { $p0 } of module { $p1 } keeps its kind of a newer format; its part gives { $p2 }
notice-channel-kind-changes = channel { $p0 } of module { $p1 } changes from { $p2 } to { $p3 } after its part; it stays { $p4 }
notice-channel-item = channel { $p0 } ({ $p1 })
notice-channel-surplus-one = module { $p0 } keeps 1 surplus channel beyond its part's { $p1 }: { $p2 }; Set PLC module part removes it after its preview
notice-channel-surplus-many = module { $p0 } keeps { $p1 } surplus channels beyond its part's { $p2 }: { $p3 }; Set PLC module part removes them after its preview
notice-binding-to = bound to { $p0 }
notice-binding-newer = bound to an endpoint of a newer format
notice-binding-none = unbound
notice-drives-now = { $p0 } now drives { $p1 }
notice-drives-several = the working-port lines of { $p0 } reach { $p1 }; link the driven device by hand
notice-pin-no-pin = channel { $p0 } of { $p1 } is unbound: part { $p2 } gives it no pin
notice-pin-taken = channel { $p0 } of { $p1 } is unbound: another channel binds its pin { $p2 }
notice-pin-map-none = channel { $p0 } of { $p1 } stays unbound: its part's pin map gives no pin for it
notice-pin-map-none-why = channel { $p0 } of { $p1 } stays unbound: its part's pin map gives no pin for it ({ $p2 })
notice-pin-no-main = channel { $p0 } of { $p1 } stays unbound: the module has no main function to carry pin { $p2 }
notice-pin-no-cp = channel { $p0 } of { $p1 } stays unbound: no CP of its main function is named { $p2 }
notice-pin-bound-other = channel { $p0 } of { $p1 } stays unbound: another channel binds its pin { $p2 }
notice-station-joins = station { $p0 } joins configuration project { $p1 }
notice-station-joins-first = station { $p0 } joins configuration project { $p1 }, the first of { $p2 } by name; choose another in the station's properties
notice-config-created = configuration project { $p0 } created for station { $p1 } (profile { $p2 })
notice-no-station = no PLC station: place a CPU first
notice-attach-station = attach the module to a station
notice-attached = attached to { $p0 } as module { $p1 }
notice-revision-format-newer = no revision was opened for this edit: the revision label format { $p0 } is of a newer build, so ElektraWatt cannot propose the next label after { $p1 }; make the open revision with Create revision
notice-revision-ids-taken = no revision was opened for this edit: the records that would follow revision { $p0 } are taken; make the open revision with Create revision
notice-solenoid-left = channel { $p0 } of { $p1 } is unbound: { $p2 } left the module
notice-solenoid-left-with = channel { $p0 } of { $p1 } is unbound: { $p2 } left the module with { $p3 }
notice-solenoid-no-channel = solenoid { $p0 } of valve { $p1 } stays unbound: the position map of module { $p2 } gives no channel below { $p3 } at position { $p4 }
notice-solenoid-stays = solenoid { $p0 } of valve { $p1 } stays on its channel: the position map of module { $p2 } assigns channel { $p3 } at position { $p4 } (EW-PLC-012); binding the channel again moves it
notice-solenoid-channel-taken = solenoid { $p0 } of valve { $p1 } stays unbound: channel { $p2 } of module { $p3 }, which the position map assigns, is { $p4 } (EW-FL-002)
notice-valve-solenoid-gone = solenoid { $p0 } of { $p1 } went with the old part; { $p2 } is unbound
notice-valve-second-definition = the second medium definition at port { $p0 } of { $p1 } went: the new valve has one port { $p0 }
notice-valve-definition-gone = the medium definition at port { $p0 } of { $p1 } went: the new valve has no port { $p0 }
notice-valve-second-settings = the settings of the second port { $p0 } of { $p1 } went: the new valve has one port { $p0 }
notice-valve-closure-gone = the closure at port { $p0 } of { $p1 } went: the new valve has no port { $p0 }
notice-valve-function = { $p0 } has the valve function of its new part; exchange the symbol to draw the new valve type
notice-valve-line-gone = the line at port { $p0 } of { $p1 } went: the new valve has no port { $p0 }
notice-fixing-choice-dropped = 1 hole moved or left out on { $p0 } is reset: the new fixing puts the holes elsewhere
notice-fixing-choices-dropped = { $p1 } holes moved or left out on { $p0 } are reset: the new fixing puts the holes elsewhere
notice-styles-bus-symbols = bus symbols drawn in the new text sizes: { $p0 }, on { $p1 }; bus lines that follow their sockets: { $p2 }
notice-assign-bus-socket-gone = the new part has no socket for the bus line at { $p0 }: it ends where it was; connect it to a socket
